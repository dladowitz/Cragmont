{
  "openapi": "3.1.0",
  "info": {
    "title": "Cragmont Agent API",
    "version": "1.1.0",
    "description": "Manage club trips, trip reports, and campsite reservations from a signed-in admin browser session. No separate agent credential is needed. The browser sends the existing session cookie; POST and PATCH requests must also send X-CSRF-Token from the admin page's csrf-token meta tag. Requests use the signed-in person's current admin permissions. New trips and report edits default to draft. This API does not manage participants, payments, deletions, or external reservation providers."
  },
  "servers": [{ "url": "/" }],
  "security": [{ "adminSession": [] }],
  "paths": {
    "/api/v1/trip_reports": {
      "get": {
        "operationId": "listTripReports",
        "summary": "List reports manageable by this admin or assigned coordinator",
        "description": "Includes private drafts and virtual automatic photo reports. Virtual entries have a null id; POST a draft with that trip_id before editing. No records are created by GET.",
        "parameters": [
          { "name": "q", "in": "query", "schema": { "type": "string" } },
          { "name": "status", "in": "query", "schema": { "type": "string", "enum": ["draft", "published", "hidden"] } }
        ],
        "responses": {
          "200": { "description": "Scoped reports", "content": { "application/json": { "schema": { "type": "object", "properties": { "reports": { "type": "array", "items": { "$ref": "#/components/schemas/TripReport" } } } } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      },
      "post": {
        "operationId": "createTripReport",
        "summary": "Create a private report draft, prefilled from a linked trip",
        "description": "One report per trip. Assigned coordinators may create reports only for their own trips. Global trip admins may omit trip_id for a historical report, supplying title, start_date, end_date, and trip_type. Duplicate trip reports return 409. This does not publish the draft.",
        "security": [{ "adminSession": [], "csrfToken": [] }],
        "requestBody": { "$ref": "#/components/requestBodies/TripReportDraft" },
        "responses": {
          "201": { "$ref": "#/components/responses/TripReportSaved" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "422": { "$ref": "#/components/responses/ValidationError" }
        }
      }
    },
    "/api/v1/trip_reports/{id}": {
      "parameters": [{ "$ref": "#/components/parameters/TripId" }],
      "get": {
        "operationId": "getTripReport",
        "summary": "Read an authorized report draft and current lock_version",
        "responses": {
          "200": { "description": "Report draft", "content": { "application/json": { "schema": { "type": "object", "properties": { "report": { "$ref": "#/components/schemas/TripReport" } } } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "patch": {
        "operationId": "saveTripReportDraft",
        "summary": "Save private edits without changing the published snapshot",
        "description": "Requires trip_report.lock_version from the last response. On 409, stop and reconcile instead of retrying with a newer version blindly. Only global trip admins may link a historical report to a trip. Linked reports cannot be detached. Unknown fields are rejected.",
        "security": [{ "adminSession": [], "csrfToken": [] }],
        "requestBody": { "$ref": "#/components/requestBodies/TripReportDraft" },
        "responses": {
          "200": { "$ref": "#/components/responses/TripReportSaved" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "422": { "$ref": "#/components/responses/ValidationError" }
        }
      }
    },
    "/api/v1/trip_reports/{id}/publish": {
      "parameters": [{ "$ref": "#/components/parameters/TripId" }],
      "patch": {
        "operationId": "publishTripReport",
        "summary": "Publish the saved draft and restore a hidden report",
        "description": "Makes story, album, and selected photos public. Requires content (story, album, or photo). Linked trips must be public and ended. Always save draft edits first.",
        "security": [{ "adminSession": [], "csrfToken": [] }],
        "requestBody": { "$ref": "#/components/requestBodies/ReportVersion" },
        "responses": {
          "200": { "$ref": "#/components/responses/TripReportSaved" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "422": { "$ref": "#/components/responses/ValidationError" }
        }
      }
    },
    "/api/v1/trip_reports/{id}/hide": {
      "parameters": [{ "$ref": "#/components/parameters/TripId" }],
      "patch": {
        "operationId": "hideTripReport",
        "summary": "Hide the report, including its automatic photo-only entry",
        "description": "Persists suppression until explicitly published again. Does not delete the trip, draft, or photos.",
        "security": [{ "adminSession": [], "csrfToken": [] }],
        "requestBody": { "$ref": "#/components/requestBodies/ReportVersion" },
        "responses": {
          "200": { "$ref": "#/components/responses/TripReportSaved" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "422": { "$ref": "#/components/responses/ValidationError" }
        }
      }
    },
    "/api/v1/trip_reports/{id}/photos": {
      "parameters": [{ "$ref": "#/components/parameters/TripId" }],
      "post": {
        "operationId": "uploadTripReportPhotos",
        "summary": "Upload authorized images to a private report draft",
        "description": "JPEG, PNG, or WebP, up to 10 MB and 40 megapixels each; at most 24 draft photos. Response includes attachment IDs in draft.photos. PATCH that ordered array to set captions, reorder, select the first photo as cover, or remove a photo from the draft. None of these changes become public until publishing.",
        "security": [{ "adminSession": [], "csrfToken": [] }],
        "requestBody": { "required": true, "content": { "multipart/form-data": { "schema": { "type": "object", "required": ["lock_version", "photos[]"], "properties": { "lock_version": { "type": "integer" }, "photos[]": { "type": "array", "items": { "type": "string", "format": "binary" } } } } } } },
        "responses": {
          "200": { "$ref": "#/components/responses/TripReportSaved" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "422": { "$ref": "#/components/responses/ValidationError" }
        }
      }
    },
    "/api/v1/trips": {
      "get": {
        "operationId": "listTrips",
        "summary": "List trips visible to this admin",
        "description": "Returns up to 100 trips, newest ID first. Pass next_before_id as before_id to get the next page. Includes drafts and archived trips.",
        "parameters": [{ "name": "before_id", "in": "query", "schema": { "type": "integer", "minimum": 1 } }],
        "responses": {
          "200": { "description": "Trip page", "content": { "application/json": { "schema": { "type": "object", "properties": { "trips": { "type": "array", "items": { "$ref": "#/components/schemas/Trip" } }, "next_before_id": { "type": ["integer", "null"] } } } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      },
      "post": {
        "operationId": "createTrip",
        "security": [{ "adminSession": [], "csrfToken": [] }],
        "summary": "Create a trip",
        "description": "Requires a trip admin or super admin. Requires name, location, start_date, and trip_type; camping trips also require end_date. Type-specific rules are enforced by the same model as the admin form. Optional gym_meetup_schedule can create repeated gym outings; created_trip_ids lists every created outing.",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["trip"], "properties": { "trip": { "$ref": "#/components/schemas/TripWrite" }, "gym_meetup_schedule": { "$ref": "#/components/schemas/GymMeetupSchedule" } } } } } },
        "responses": {
          "201": { "description": "Created trip", "content": { "application/json": { "schema": { "type": "object", "properties": { "trip": { "$ref": "#/components/schemas/Trip" }, "created_trip_ids": { "type": "array", "items": { "type": "integer" } } } } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "422": { "$ref": "#/components/responses/ValidationError" }
        }
      }
    },
    "/api/v1/trips/{id}": {
      "parameters": [{ "$ref": "#/components/parameters/TripId" }],
      "get": {
        "operationId": "getTrip",
        "summary": "Read one trip",
        "responses": {
          "200": { "description": "Trip details", "content": { "application/json": { "schema": { "type": "object", "properties": { "trip": { "$ref": "#/components/schemas/Trip" } } } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "patch": {
        "operationId": "updateTrip",
        "security": [{ "adminSession": [], "csrfToken": [] }],
        "summary": "Edit a trip",
        "description": "Partial update. Deleted trips cannot be changed. A coordinator can edit only their assigned trip; only global trip admins can change campsite_coordinator_id.",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["trip"], "properties": { "trip": { "$ref": "#/components/schemas/TripWrite" } } } } } },
        "responses": {
          "200": { "description": "Updated trip", "content": { "application/json": { "schema": { "type": "object", "properties": { "trip": { "$ref": "#/components/schemas/Trip" } } } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "422": { "$ref": "#/components/responses/ValidationError" }
        }
      }
    },
    "/api/v1/trips/{trip_id}/campsites": {
      "parameters": [{ "$ref": "#/components/parameters/TripIdNested" }],
      "get": {
        "operationId": "listCampsiteReservations",
        "summary": "Read campsite reservations for a trip",
        "responses": {
          "200": { "description": "Campsite reservations", "content": { "application/json": { "schema": { "type": "object", "properties": { "campsites": { "type": "array", "items": { "$ref": "#/components/schemas/Campsite" } } } } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "post": {
        "operationId": "createCampsiteReservation",
        "security": [{ "adminSession": [], "csrfToken": [] }],
        "summary": "Load a campsite reservation into a camping trip",
        "description": "Requires campground_id, site_number, arrival_date, checkout_date, participant_capacity, and car_capacity. Use GET first to avoid duplicates when retrying a request. registration_fee is entered in dollars. Dates must fit within the trip.",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["campsite"], "properties": { "campsite": { "$ref": "#/components/schemas/CampsiteWrite" } } } } } },
        "responses": {
          "201": { "description": "Created reservation", "content": { "application/json": { "schema": { "type": "object", "properties": { "campsite": { "$ref": "#/components/schemas/Campsite" } } } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "422": { "$ref": "#/components/responses/ValidationError" }
        }
      }
    },
    "/api/v1/trips/{trip_id}/campsites/{id}": {
      "parameters": [{ "$ref": "#/components/parameters/TripIdNested" }, { "$ref": "#/components/parameters/CampsiteId" }],
      "patch": {
        "operationId": "updateCampsiteReservation",
        "security": [{ "adminSession": [], "csrfToken": [] }],
        "summary": "Edit a campsite reservation",
        "description": "Partial update. The campsite must belong to the trip, and the trip must be active and of type camping.",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["campsite"], "properties": { "campsite": { "$ref": "#/components/schemas/CampsiteWrite" } } } } } },
        "responses": {
          "200": { "description": "Updated reservation", "content": { "application/json": { "schema": { "type": "object", "properties": { "campsite": { "$ref": "#/components/schemas/Campsite" } } } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "422": { "$ref": "#/components/responses/ValidationError" }
        }
      }
    },
    "/api/v1/campgrounds": {
      "get": {
        "operationId": "listCampgrounds",
        "summary": "Find campground IDs for campsite reservations",
        "responses": {
          "200": { "description": "Campgrounds", "content": { "application/json": { "schema": { "type": "object", "properties": { "campgrounds": { "type": "array", "items": { "$ref": "#/components/schemas/Campground" } } } } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      },
      "post": {
        "operationId": "createCampground",
        "security": [{ "adminSession": [], "csrfToken": [] }],
        "summary": "Create a campground when a reservation uses a new one",
        "description": "Requires name and location; only a trip admin or super admin can create one.",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["campground"], "properties": { "campground": { "$ref": "#/components/schemas/CampgroundWrite" } } } } } },
        "responses": {
          "201": { "description": "Created campground", "content": { "application/json": { "schema": { "type": "object", "properties": { "campground": { "$ref": "#/components/schemas/Campground" } } } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "422": { "$ref": "#/components/responses/ValidationError" }
        }
      }
    }
  },
  "components": {
    "requestBodies": {
      "TripReportDraft": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["trip_report"], "properties": { "trip_report": { "$ref": "#/components/schemas/TripReportWrite" } } } } } },
      "ReportVersion": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["lock_version"], "properties": { "lock_version": { "type": "integer", "minimum": 0 } } } } } }
    },
    "securitySchemes": {
      "adminSession": { "type": "apiKey", "in": "cookie", "name": "_cragmont_session", "description": "Existing signed-in admin browser session. The browser sends this cookie automatically; do not copy it into prompts." },
      "csrfToken": { "type": "apiKey", "in": "header", "name": "X-CSRF-Token", "description": "Required for POST and PATCH. Read the csrf-token meta tag from the current admin page." }
    },
    "parameters": {
      "TripId": { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } },
      "TripIdNested": { "name": "trip_id", "in": "path", "required": true, "schema": { "type": "integer" } },
      "CampsiteId": { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
    },
    "schemas": {
      "TripReportWrite": {
        "type": "object", "additionalProperties": false,
        "properties": {
          "trip_id": { "type": ["integer", "null"] },
          "lock_version": { "type": "integer", "minimum": 0, "description": "Required for updates; use latest returned value" },
          "title": { "type": "string", "maxLength": 250 },
          "start_date": { "type": "string", "format": "date" }, "end_date": { "type": "string", "format": "date" },
          "location": { "type": "string", "maxLength": 250 },
          "trip_type": { "type": "string", "enum": ["camping", "day_trip", "gym_outing", "class_trip"] },
          "body": { "type": "string", "maxLength": 100000, "description": "Markdown; rendered with the existing safe content renderer" },
          "byline": { "type": "string", "maxLength": 250 },
          "album_url": { "type": "string", "description": "Empty or an HTTPS Google Photos album link" },
          "photos": { "type": "array", "maxItems": 24, "items": { "type": "object", "additionalProperties": false, "required": ["id"], "properties": { "id": { "type": "integer" }, "caption": { "type": "string", "maxLength": 500 } } } }
        }
      },
      "TripReport": {
        "type": "object",
        "properties": {
          "id": { "type": ["integer", "null"] }, "trip_id": { "type": ["integer", "null"] },
          "lock_version": { "type": "integer" }, "draft": { "type": "object", "description": "Draft content fields; imported reports also include read-only legacy_image" },
          "status": { "type": "string" }, "hidden": { "type": "boolean" },
          "published_at": { "type": ["string", "null"], "format": "date-time" },
          "updated_at": { "type": ["string", "null"], "format": "date-time" }, "edit_path": { "type": "string" }
        }
      },
      "TripWrite": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" }, "location": { "type": "string" },
          "start_date": { "type": "string", "format": "date" }, "end_date": { "type": "string", "format": "date" },
          "status": { "type": "string", "enum": ["draft", "published", "archived"], "default": "draft" },
          "trip_type": { "type": "string", "enum": ["camping", "day_trip", "gym_outing", "class_trip"] },
          "description": { "type": "string" }, "campsite_coordinator_id": { "type": ["integer", "null"] },
          "participant_capacity": { "type": "integer", "minimum": 0 }, "cost_cents": { "type": "integer", "minimum": 0 },
          "cost_dollars": { "type": "string", "description": "Alternative to cost_cents for entering dollars" },
          "climbing_types": { "type": "array", "items": { "type": "string", "enum": ["sport", "trad", "bouldering"] } },
          "meeting_time": { "type": "string", "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$", "example": "09:00" }, "end_time": { "type": "string", "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$", "example": "16:00" },
          "meeting_location": { "type": "string" }, "meeting_location_url": { "type": "string", "format": "uri" },
          "late_arrival_instructions": { "type": "string" }, "carpool_meeting_spot": { "type": "string" },
          "weather_url": { "type": "string", "format": "uri" }, "whatsapp_group": { "type": "string", "format": "uri" },
          "photo_album_url": { "type": "string", "format": "uri" }, "mountain_project_url": { "type": "string", "format": "uri" },
          "auto_trip_report": { "type": "boolean", "default": true, "description": "New trips: make the Google Photos link public after the trip ends. Existing trips retain false for album privacy. This does not hide an explicitly published report; use its hide endpoint." },
          "guide_book_url": { "type": "string", "format": "uri" }, "sun_exposure": { "type": "string" },
          "partner_company_id": { "type": "integer" }, "class_signup_url": { "type": "string", "format": "uri" },
          "class_original_price": { "type": "string" }, "class_offers_discount": { "type": "boolean" },
          "class_discount_code": { "type": "string" }, "class_discount_amount": { "type": "string" },
          "class_discounted_price": { "type": "string" }, "group_campfire_campsite_id": { "type": "integer" },
          "group_fire_night": { "type": "string", "enum": ["none", "monday", "tuesday", "wednesday", "thursday", "friday", "saturday", "sunday"] }
        }
      },
      "Trip": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" }, "name": { "type": "string" }, "location": { "type": "string" },
          "start_date": { "type": "string", "format": "date" }, "end_date": { "type": ["string", "null"], "format": "date" },
          "description": { "type": ["string", "null"] }, "status": { "type": "string" }, "trip_type": { "type": "string" },
          "campsite_coordinator_id": { "type": ["integer", "null"] }, "participant_capacity": { "type": ["integer", "null"] },
          "cost_cents": { "type": "integer" }, "climbing_types": { "type": "array", "items": { "type": "string" } },
          "meeting_time": { "type": ["string", "null"], "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$", "example": "09:00" }, "end_time": { "type": ["string", "null"], "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$", "example": "16:00" },
          "meeting_location": { "type": ["string", "null"] }, "meeting_location_url": { "type": ["string", "null"] },
          "late_arrival_instructions": { "type": ["string", "null"] }, "carpool_meeting_spot": { "type": ["string", "null"] },
          "weather_url": { "type": ["string", "null"] }, "whatsapp_group": { "type": ["string", "null"] },
          "photo_album_url": { "type": ["string", "null"] }, "mountain_project_url": { "type": ["string", "null"] },
          "guide_book_url": { "type": ["string", "null"] }, "sun_exposure": { "type": ["string", "null"] },
          "partner_company_id": { "type": ["integer", "null"] }, "class_signup_url": { "type": ["string", "null"] },
          "class_original_price": { "type": ["string", "null"] }, "class_offers_discount": { "type": "boolean" },
          "class_discount_code": { "type": ["string", "null"] }, "class_discount_amount": { "type": ["string", "null"] },
          "class_discounted_price": { "type": ["string", "null"] }, "group_campfire_campsite_id": { "type": ["integer", "null"] },
          "group_fire_night": { "type": ["string", "null"] }, "updated_at": { "type": "string", "format": "date-time" },
          "campsites_path": { "type": "string" }, "admin_path": { "type": "string" }
        }
      },
      "GymMeetupSchedule": { "type": "object", "additionalProperties": false, "properties": { "frequency": { "type": "string", "enum": ["none", "monthly", "first_third", "second_fourth"] }, "ends_on": { "type": "string", "format": "date" } } },
      "CampsiteWrite": {
        "type": "object", "additionalProperties": false,
        "properties": {
          "campground_id": { "type": "integer" }, "site_number": { "type": "string" },
          "arrival_date": { "type": "string", "format": "date" }, "checkout_date": { "type": "string", "format": "date" },
          "participant_capacity": { "type": "integer", "minimum": 0, "maximum": 50 }, "car_capacity": { "type": "integer", "minimum": 0 },
          "registered_by_id": { "type": ["integer", "null"] }, "registration_fee": { "type": "string", "description": "Dollars, e.g. 35.00" },
          "registration_number": { "type": "string" }, "notes": { "type": "string" }
        }
      },
      "Campsite": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" }, "trip_id": { "type": "integer" }, "campground_id": { "type": "integer" },
