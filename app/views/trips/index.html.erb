<%= render "shared/public_header" %>

<main class="public-main">
  <section class="panel">
    <div class="panel-header">
      <div>
        <p class="eyebrow">Upcoming trips</p>
        <h1>Trips</h1>
      </div>
    </div>

    <% if @trips.any? %>
      <div class="trip-cards">
        <% @trips.each do |trip| %>
          <article class="trip-card">
            <div>
              <h2><%= link_to trip.name, trip_path(trip) %></h2>
              <p><%= trip.location %></p>
            </div>
            <dl class="trip-card-meta">
              <div>
                <dt>Dates</dt>
                <dd><%= trip.start_date.to_fs(:long) %> to <%= trip.end_date.to_fs(:long) %></dd>
              </div>
              <div>
                <dt>Capacity</dt>
                <dd><%= trip.total_participant_capacity %> participants</dd>
              </div>
            </dl>
            <%= link_to "View trip", trip_path(trip), class: "button secondary" %>
          </article>
        <% end %>
      </div>
    <% else %>
      <p class="muted">No published trips are available right now.</p>
    <% end %>
  </section>
</main>
