- modal_id = "waitlist-campsite-choice-#{signup.id}"
- choice_name = "waitlist_campsite_choice_#{signup.id}"
%div.waitlist-campsite-choice{"data-controller" => "modal campsite-choice"}
  %button.button{"data-action" => "modal#open", :type => "button"} Signup
  %dialog.signup-modal{"aria-labelledby" => modal_id, "data-action" => "click->modal#closeOnBackdrop", "data-modal-target" => "dialog"}
    .signup-modal-content
      %div
        %h2{id: modal_id} Signup
        %p.muted Choose a campsite, then enter the dates you will attend.
      - if campsites.many?
        %fieldset.campsite-choice-options{"data-campsite-choice-target" => "chooser"}
          %legend Choose campsite
          - campsites.each_with_index do |campsite, index|
            - option_id = "waitlist-campsite-choice-#{signup.id}-#{campsite.id}"
            %label.campsite-choice-option
              = radio_button_tag choice_name, campsite.id, false, id: option_id, data: { campsite_choice_target: "option", action: "change->campsite-choice#select" }
              %span
                %strong
                  = campsite.campground.name
                  site #{campsite.site_number}
                %small
                  = campsite.arrival_date.to_fs(:long)
                  to #{campsite.checkout_date.to_fs(:long)}
      - campsites.each_with_index do |campsite, index|
        .campsite-choice-panel{hidden: campsites.many? || !index.zero?, data: { campsite_choice_target: "panel", campsite_id: campsite.id }}
          - if campsites.many?
            .campsite-choice-summary
              %p.muted
                = campsite.campground.name
                site #{campsite.site_number}
              %button.button.secondary{"data-action" => "campsite-choice#change", :type => "button"} Change campsite
          - unless campsites.many?
            %p.muted
              = campsite.campground.name
              site #{campsite.site_number}
          = render "campsite_signup_form_fields", trip: trip, campsite: campsite, confirm_waitlist: true, waitlist_direct_signup: false, modal_submit_text: "Pay Now and Confirm", signup_intent: "confirm_waitlist", dom_id_suffix: "waitlist-#{signup.id}-#{campsite.id}"
