- waitlisted_signup = confirm_waitlist || waitlist_direct_signup
- signature_id = "campsite-signup-signature-#{dom_id_suffix}"
- arrival_id = "campsite-signup-arrival-#{dom_id_suffix}"
- checkout_id = "campsite-signup-checkout-#{dom_id_suffix}"
= form_with url: trip_campsite_campsite_signup_path(trip, campsite), method: :post, class: "waiver-form", data: { controller: "signature" } do
  = hidden_field_tag "campsite_signup[intent]", signup_intent
  %section.signup-kind-step{"data-signature-target" => "signupStep"}
    %section.attendance-fields
      %div
        %h3 Attendance dates
        %p.muted Choose the nights you will stay at this campsite.
      .attendance-date-row
        .field
          = label_tag arrival_id, "Arrival date"
          = date_field_tag "campsite_signup[arrival_date]", nil, id: arrival_id, min: campsite.arrival_date, max: campsite.checkout_date - 1.day, required: true, data: { signature_target: "arrivalDate", action: "input->signature#checkAttendanceDates" }
        .field
          = label_tag checkout_id, "Checkout date"
          = date_field_tag "campsite_signup[checkout_date]", nil, id: checkout_id, min: campsite.arrival_date + 1.day, max: campsite.checkout_date, required: true, data: { signature_target: "checkoutDate", action: "input->signature#checkAttendanceDates" }
    - unless waitlisted_signup
      %fieldset.signup-kind-options
        %legend Who are you signing up?
        %label
          = radio_button_tag "campsite_signup[signup_kind]", "self", true, id: "campsite_#{campsite.id}_signup_kind_self", data: { signature_target: "signupKind", action: "signature#toggleMinorFields" }
          %span I am signing up for myself
        %label
          = radio_button_tag "campsite_signup[signup_kind]", "with_minors", false, id: "campsite_#{campsite.id}_signup_kind_with_minors", data: { signature_target: "signupKind", action: "signature#toggleMinorFields" }
          %span I am signing up for myself and minors (max 2)
      %section.minor-fields{"data-signature-target" => "minorFields", :hidden => ""}
        %h3 Minor information
        - 2.times do |index|
          .minor-field-row
            %div
              = label_tag "campsite_#{campsite.id}_signup_minor_#{index}_first_name", "First name"
              = text_field_tag "campsite_signup[campsite_signup_minors_attributes][#{index}][first_name]", "", id: "campsite_#{campsite.id}_signup_minor_#{index}_first_name", data: ({ required_for_minor: "true" } if index.zero?)
            %div
              = label_tag "campsite_#{campsite.id}_signup_minor_#{index}_last_name", "Last name"
              = text_field_tag "campsite_signup[campsite_signup_minors_attributes][#{index}][last_name]", "", id: "campsite_#{campsite.id}_signup_minor_#{index}_last_name", data: ({ required_for_minor: "true" } if index.zero?)
            %div
              = label_tag "campsite_#{campsite.id}_signup_minor_#{index}_age", "Age"
              = number_field_tag "campsite_signup[campsite_signup_minors_attributes][#{index}][age]", "", id: "campsite_#{campsite.id}_signup_minor_#{index}_age", min: 0, max: 17, data: ({ required_for_minor: "true" } if index.zero?)
            %div
              = label_tag "campsite_#{campsite.id}_signup_minor_#{index}_relationship", "Relationship"
              = text_field_tag "campsite_signup[campsite_signup_minors_attributes][#{index}][relationship]", "", id: "campsite_#{campsite.id}_signup_minor_#{index}_relationship", placeholder: "Parent, Guardian, Uncle, etc", data: ({ required_for_minor: "true" } if index.zero?)
    .form-actions
      %button.button.secondary{"data-action" => "modal#close", :type => "button"} Cancel
      %button.button{"data-action" => "signature#showAcknowledgement", :type => "button"} Next
  %section.waiver-intro{"data-signature-target" => "intro", :hidden => ""}
    .waiver-intro-copy
      - TripSignupWaiver.acknowledgement_blocks.each do |block|
        %p= block
    .form-actions
      %button.button.secondary{"data-action" => "modal#close", :type => "button"} Cancel
      %button.button{"data-action" => "signature#showWaiver", :type => "button"} Agree and Sign Waiver
  %div{"data-signature-target" => "waiverStep", :hidden => ""}
    %section.waiver-text{"data-action" => "scroll->signature#checkWaiverScroll", "data-signature-target" => "waiver"}
      .waiver-document
        - TripSignupWaiver.blocks.each_with_index do |block, index|
          - if TripSignupWaiver.title_block?(index)
            %h3.waiver-title= block
          - elsif TripSignupWaiver.warning_block?(index)
            %p.waiver-warning= block
          - elsif TripSignupWaiver.summary_heading_block?(index)
            %h4.waiver-summary-heading= block
          - else
            %p= block
    .signature-field
      .signature-label-row
        %label{:for => signature_id} Signature
        %span You must view all the text to sign
      %canvas.signature-pad{id: signature_id, "data-signature-target" => "canvas", :height => "120", :width => "560"}
      = hidden_field_tag "campsite_signup[waiver_signature_data]", "", data: { signature_target: "input" }
      = hidden_field_tag "campsite_signup[waiver_acknowledged_at]", "", data: { signature_target: "acknowledgementInput" }
    .form-actions.waiver-signature-actions
      %button.button.secondary{"data-action" => "signature#clear", :type => "button"} Clear signature
      .waiver-signature-submit-actions
        %button.button.secondary{"data-action" => "modal#close", :type => "button"} Cancel
        = button_tag modal_submit_text, type: :submit, class: "button", data: { signature_target: "submit" }, disabled: true
