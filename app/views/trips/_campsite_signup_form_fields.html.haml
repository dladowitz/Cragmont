- confirm_waitlist = local_assigns.fetch(:confirm_waitlist, false)
- waitlist_direct_signup = local_assigns.fetch(:waitlist_direct_signup, false)
- complete_existing_signup = local_assigns.fetch(:complete_existing_signup, false)
- existing_signup = local_assigns[:signup]
- waitlisted_signup = confirm_waitlist || waitlist_direct_signup || complete_existing_signup
- signature_id = "campsite-signup-signature-#{dom_id_suffix}"
- arrival_id = "campsite-signup-arrival-#{dom_id_suffix}"
- checkout_id = "campsite-signup-checkout-#{dom_id_suffix}"
- minors_toggle_id = "campsite-signup-minors-toggle-#{dom_id_suffix}"
- guests_toggle_id = "campsite-signup-guests-toggle-#{dom_id_suffix}"
- attendance_help_text = "Choose the nights you will stay at this campsite."
- if complete_existing_signup && existing_signup&.guest? && existing_signup.guest_of_signup.present?
  - attendance_help_text = "Confirm (or change) the nights #{existing_signup.guest_of_signup.user.first_name} has selected for you."
= form_with url: trip_campsite_campsite_signup_path(trip, campsite), method: :post, class: "waiver-form", data: { controller: "signature", signature_available_participant_capacity_value: campsite.available_participant_capacity, signature_uncounted_minor_age_limit_value: trip.uncounted_minor_age_limit, signature_show_capacity_warning_value: !waitlisted_signup } do
  = hidden_field_tag "campsite_signup[intent]", signup_intent
  %section.signup-kind-step{"data-signature-target" => "signupStep"}
    - unless waitlisted_signup
      %p.capacity-warning{"data-signature-target" => "capacityWarning", :hidden => ""}
        You've exceeded the space available for this campsite. Your party will be placed on the waitlist.
    %section.attendance-fields
      %div
        %h3 Attendance dates
        %p.muted= attendance_help_text
      .attendance-date-row
        .field
          = required_label_tag arrival_id, "Arrival date"
          = date_field_tag "campsite_signup[arrival_date]", existing_signup&.arrival_date, id: arrival_id, min: campsite.arrival_date, max: campsite.checkout_date - 1.day, required: true, data: { signature_target: "arrivalDate", action: "input->signature#checkAttendanceDates" }
        .field
          = required_label_tag checkout_id, "Checkout date"
          = date_field_tag "campsite_signup[checkout_date]", existing_signup&.checkout_date, id: checkout_id, min: campsite.arrival_date + 1.day, max: campsite.checkout_date, required: true, data: { signature_target: "checkoutDate", action: "input->signature#checkAttendanceDates" }
    - unless waitlisted_signup
      %fieldset.signup-kind-options
        %legend.visually-hidden Additional participants
        %label
          = check_box_tag "campsite_signup[with_guests]", "1", false, id: guests_toggle_id, data: { signature_target: "guestToggle", action: "signature#togglePartyFields" }
          %span Add adult
        %label
          = check_box_tag "campsite_signup[with_minors]", "1", false, id: minors_toggle_id, data: { signature_target: "minorToggle", action: "signature#togglePartyFields" }
          %span Add minors (under 18)
      %section.guest-fields{"data-party-fields" => "guest", "data-required-dataset-key" => "requiredForGuest", "data-signature-target" => "guestFields", :hidden => ""}
        %h3
          Adult information
          %span.section-limit (Max #{CampsiteSignup::MAX_GUESTS_PER_SIGNUP})
        - CampsiteSignup::MAX_GUESTS_PER_SIGNUP.times do |index|
          .guest-field-row{"data-party-row" => "", "data-party-row-visible" => (index.zero? ? "true" : "false"), hidden: !index.zero?}
            %button.remove-person-button{"aria-label" => "Remove guest", "data-action" => "signature#removePartyRow", type: "button"} X
            %div
              = required_label_tag "campsite_#{campsite.id}_signup_guest_#{index}_first_name", "First name"
              = text_field_tag "campsite_signup[guest_attributes][#{index}][first_name]", "", id: "campsite_#{campsite.id}_signup_guest_#{index}_first_name", data: { required_for_guest: "true" }
            %div
              = required_label_tag "campsite_#{campsite.id}_signup_guest_#{index}_last_name", "Last name"
              = text_field_tag "campsite_signup[guest_attributes][#{index}][last_name]", "", id: "campsite_#{campsite.id}_signup_guest_#{index}_last_name", data: { required_for_guest: "true" }
            %div
              = required_label_tag "campsite_#{campsite.id}_signup_guest_#{index}_email", "Email"
              = email_field_tag "campsite_signup[guest_attributes][#{index}][email]", "", id: "campsite_#{campsite.id}_signup_guest_#{index}_email", data: { required_for_guest: "true" }
            %div
              = label_tag "campsite_#{campsite.id}_signup_guest_#{index}_phone", "Phone"
              = telephone_field_tag "campsite_signup[guest_attributes][#{index}][phone]", "", id: "campsite_#{campsite.id}_signup_guest_#{index}_phone"
          - if index.zero? && CampsiteSignup::MAX_GUESTS_PER_SIGNUP > 1
            %button.add-person-link{"data-action" => "signature#revealPartyRow", "data-add-party-row" => "", type: "button"} Add another adult
      %section.minor-fields{"data-party-fields" => "minor", "data-required-dataset-key" => "requiredForMinor", "data-signature-target" => "minorFields", :hidden => ""}
        %h3
          Minor information
          %span.section-limit (Max 2)
        - 2.times do |index|
          .minor-field-row{"data-party-row" => "", "data-party-row-visible" => (index.zero? ? "true" : "false"), hidden: !index.zero?}
            %button.remove-person-button{"aria-label" => "Remove minor", "data-action" => "signature#removePartyRow", type: "button"} X
            %div
              = required_label_tag "campsite_#{campsite.id}_signup_minor_#{index}_first_name", "First name"
              = text_field_tag "campsite_signup[campsite_signup_minors_attributes][#{index}][first_name]", "", id: "campsite_#{campsite.id}_signup_minor_#{index}_first_name", data: { required_for_minor: "true" }
            %div
              = required_label_tag "campsite_#{campsite.id}_signup_minor_#{index}_last_name", "Last name"
              = text_field_tag "campsite_signup[campsite_signup_minors_attributes][#{index}][last_name]", "", id: "campsite_#{campsite.id}_signup_minor_#{index}_last_name", data: { required_for_minor: "true" }
            %div
              = required_label_tag "campsite_#{campsite.id}_signup_minor_#{index}_age", "Age"
              = number_field_tag "campsite_signup[campsite_signup_minors_attributes][#{index}][age]", "", id: "campsite_#{campsite.id}_signup_minor_#{index}_age", min: 0, max: 17, data: { required_for_minor: "true", action: "input->signature#updateCapacityWarning" }
            %div
              = required_label_tag "campsite_#{campsite.id}_signup_minor_#{index}_relationship", "Relationship"
              = text_field_tag "campsite_signup[campsite_signup_minors_attributes][#{index}][relationship]", "", id: "campsite_#{campsite.id}_signup_minor_#{index}_relationship", placeholder: "Parent, Guardian, Uncle, etc", data: { required_for_minor: "true" }
          - if index.zero?
            %button.add-person-link{"data-action" => "signature#revealPartyRow", "data-add-party-row" => "", type: "button"} Add another minor
    .form-actions
      %button.button.secondary{"data-action" => "modal#close", :type => "button"} Cancel
      %button.button{"data-action" => "signature#showAcknowledgement", :type => "button"} Next
  %section.waiver-intro{"data-signature-target" => "intro", :hidden => ""}
    .waiver-intro-copy
      - TripSignupWaiver.acknowledgement_blocks.each do |block|
        %p= block
    .form-actions
      %button.button.secondary{"data-action" => "modal#close", :type => "button"} Cancel
      %button.button{"data-action" => "signature#showWaiver", :type => "button"} Agree and Sign Waiver
  %div{"data-signature-target" => "waiverStep", :hidden => ""}
    %section.waiver-text{"data-action" => "scroll->signature#checkWaiverScroll", "data-signature-target" => "waiver"}
      .waiver-document
        - TripSignupWaiver.blocks.each_with_index do |block, index|
          - if TripSignupWaiver.title_block?(index)
            %h3.waiver-title= block
          - elsif TripSignupWaiver.warning_block?(index)
            %p.waiver-warning= block
          - elsif TripSignupWaiver.summary_heading_block?(index)
            %h4.waiver-summary-heading= block
          - else
            %p= block
    .signature-field
      .signature-label-row
        %label{:for => signature_id}
          Signature
          = required_marker
        %span You must view all the text to sign
      %canvas.signature-pad{id: signature_id, "data-signature-target" => "canvas", :height => "120", :width => "560"}
      = hidden_field_tag "campsite_signup[waiver_signature_data]", "", data: { signature_target: "input" }
      = hidden_field_tag "campsite_signup[waiver_acknowledged_at]", "", data: { signature_target: "acknowledgementInput" }
    .form-actions.waiver-signature-actions
      %button.button.secondary{"data-action" => "signature#clear", :type => "button"} Clear signature
      .waiver-signature-submit-actions
        %button.button.secondary{"data-action" => "modal#close", :type => "button"} Cancel
        = button_tag modal_submit_text, type: :submit, class: "button", data: { signature_target: "submit" }, disabled: true
