- confirm_waitlist = local_assigns.fetch(:confirm_waitlist, false)
- waitlist_direct_signup = local_assigns.fetch(:waitlist_direct_signup, false)
- complete_existing_signup = local_assigns.fetch(:complete_existing_signup, false)
- waiver_only = local_assigns.fetch(:waiver_only, false)
- hide_fee_fields = local_assigns.fetch(:hide_fee_fields, false)
- existing_signup = local_assigns[:signup]
- waitlisted_signup = confirm_waitlist || waitlist_direct_signup || complete_existing_signup
- signature_id = "campsite-signup-signature-#{dom_id_suffix}"
- arrival_id = "campsite-signup-arrival-#{dom_id_suffix}"
- checkout_id = "campsite-signup-checkout-#{dom_id_suffix}"
- minors_toggle_id = "campsite-signup-minors-toggle-#{dom_id_suffix}"
- guests_toggle_id = "campsite-signup-guests-toggle-#{dom_id_suffix}"
- attendance_help_text = ""
- site_setting = SiteSetting.current
- existing_adult_guest_count = existing_signup&.guest? ? 0 : existing_signup&.guest_signups&.size.to_i
- existing_adult_guest_names = existing_signup&.guest? ? [] : existing_signup&.guest_signups&.map { |guest_signup| guest_signup.user.full_name }.to_a
- existing_minors = (existing_signup&.campsite_signup_minors || []).to_a
- existing_minor_line_items = existing_minors.map { |minor| { name: minor.full_name, age: minor.age } }
- existing_counted_minors = existing_signup&.campsite_signup_minors&.select { |minor| minor.age.to_i >= site_setting.uncounted_minor_age_limit }.to_a
- existing_counted_minor_count = existing_counted_minors.size
- existing_counted_minor_names = existing_counted_minors.map(&:full_name)
- primary_participant_name = existing_signup&.guest? ? nil : existing_signup&.user&.full_name
- current_annual_waiver_available = current_user&.current_waiver_for_year(trip.start_date.year).present?
- if complete_existing_signup && existing_signup&.guest? && existing_signup.guest_of_signup.present?
  - attendance_help_text = "Confirm (or change) the nights #{existing_signup.guest_of_signup.user.first_name} has selected for you."
= form_with url: trip_campsite_campsite_signup_path(trip, campsite), method: :post, class: "waiver-form", data: { turbo: false, controller: "signature", signature_available_participant_capacity_value: campsite.available_participant_capacity, signature_uncounted_minor_age_limit_value: trip.uncounted_minor_age_limit, signature_show_capacity_warning_value: !waitlisted_signup, signature_direct_signup_intent_value: signup_intent, signature_waitlist_intent_value: "join_waitlist", signature_next_submit_text_value: "Next", signature_waitlist_submit_text_value: "Join waitlist", signature_first_two_nights_fee_cents_value: site_setting.first_two_nights_fee_cents, signature_extra_night_fee_cents_value: site_setting.extra_night_fee_cents, signature_minor_fee_cents_value: site_setting.minor_fee_cents, signature_minor_extra_night_fee_cents_value: site_setting.minor_extra_night_fee_cents, signature_existing_adult_guest_count_value: existing_adult_guest_count, signature_existing_adult_names_value: existing_adult_guest_names.to_json, signature_existing_counted_minor_count_value: existing_counted_minor_count, signature_existing_counted_minor_names_value: existing_counted_minor_names.to_json, signature_existing_minor_line_items_value: existing_minor_line_items.to_json, signature_primary_participant_name_value: primary_participant_name, signature_current_waiver_available_value: current_annual_waiver_available, signature_pay_submit_text_value: local_assigns.fetch(:payment_submit_text, modal_submit_text), signature_free_submit_text_value: local_assigns.fetch(:free_submit_text, modal_submit_text) } do
  = hidden_field_tag "campsite_signup[intent]", signup_intent, data: { signature_target: "intent" }
  %section.signup-kind-step{"data-signature-target" => "signupStep"}
    - unless waitlisted_signup
      %p.capacity-warning{"data-signature-target" => "capacityWarning", :hidden => ""}
        You've exceeded the space available for this campsite. Your party will be placed on the waitlist.
    - unless waiver_only
      %section.attendance-fields
        %div
          - if attendance_help_text.present?
            %p.muted= attendance_help_text
        .attendance-date-row
          .field
            = required_label_tag arrival_id, "Arrival date"
            = date_field_tag "campsite_signup[arrival_date]", existing_signup&.arrival_date, id: arrival_id, min: campsite.arrival_date, max: campsite.checkout_date - 1.day, required: true, data: { signature_target: "arrivalDate", action: "click->signature#showDatePicker focus->signature#showDatePicker input->signature#checkAttendanceDates input->signature#updatePaymentSummary" }
          .field
            = required_label_tag checkout_id, "Checkout date"
            = date_field_tag "campsite_signup[checkout_date]", existing_signup&.checkout_date, id: checkout_id, min: campsite.arrival_date + 1.day, max: campsite.checkout_date, required: true, data: { signature_target: "checkoutDate", action: "click->signature#showDatePicker focus->signature#showDatePicker input->signature#checkAttendanceDates input->signature#updatePaymentSummary" }
    
    - unless waitlisted_signup
      %fieldset.signup-kind-options
        %legend.visually-hidden Additional participants
        %label
          = check_box_tag "campsite_signup[with_guests]", "1", false, id: guests_toggle_id, data: { signature_target: "guestToggle", action: "signature#togglePartyFields" }
          %span Add and aditional adult (max 2)
        %label
          = check_box_tag "campsite_signup[with_minors]", "1", false, id: minors_toggle_id, data: { signature_target: "minorToggle", action: "signature#togglePartyFields" }
          %span Add minors (under 18)
      %section.guest-fields{"data-party-fields" => "guest", "data-required-dataset-key" => "requiredForGuest", "data-signature-target" => "guestFields", :hidden => ""}
        %h3
          Adult information
          %span.section-limit (Max #{CampsiteSignup::MAX_GUESTS_PER_SIGNUP})
        - CampsiteSignup::MAX_GUESTS_PER_SIGNUP.times do |index|
          .guest-field-row{"data-party-row" => "", "data-party-row-visible" => (index.zero? ? "true" : "false"), hidden: !index.zero?}
            %button.remove-person-button{"aria-label" => "Remove guest", "data-action" => "signature#removePartyRow", type: "button"} X
            %div
              = required_label_tag "campsite_#{campsite.id}_signup_guest_#{index}_first_name", "First name"
              = text_field_tag "campsite_signup[guest_attributes][#{index}][first_name]", "", id: "campsite_#{campsite.id}_signup_guest_#{index}_first_name", data: { required_for_guest: "true", action: "input->signature#updatePaymentSummary" }
            %div
              = required_label_tag "campsite_#{campsite.id}_signup_guest_#{index}_last_name", "Last name"
              = text_field_tag "campsite_signup[guest_attributes][#{index}][last_name]", "", id: "campsite_#{campsite.id}_signup_guest_#{index}_last_name", data: { required_for_guest: "true", action: "input->signature#updatePaymentSummary" }
            %div
              = required_label_tag "campsite_#{campsite.id}_signup_guest_#{index}_email", "Email"
              = email_field_tag "campsite_signup[guest_attributes][#{index}][email]", "", id: "campsite_#{campsite.id}_signup_guest_#{index}_email", data: { required_for_guest: "true" }
            %div
              = label_tag "campsite_#{campsite.id}_signup_guest_#{index}_phone", "Phone"
              = telephone_field_tag "campsite_signup[guest_attributes][#{index}][phone]", "", id: "campsite_#{campsite.id}_signup_guest_#{index}_phone"
          - if index.zero? && CampsiteSignup::MAX_GUESTS_PER_SIGNUP > 1
            %button.add-person-link{"data-action" => "signature#revealPartyRow", "data-add-party-row" => "", type: "button"} Add another adult
      %section.minor-fields{"data-party-fields" => "minor", "data-required-dataset-key" => "requiredForMinor", "data-signature-target" => "minorFields", :hidden => ""}
        %h3
          Minor information
          %span.section-limit (Max 2)
        - 2.times do |index|
          .minor-field-row{"data-party-row" => "", "data-party-row-visible" => (index.zero? ? "true" : "false"), hidden: !index.zero?}
            %button.remove-person-button{"aria-label" => "Remove minor", "data-action" => "signature#removePartyRow", type: "button"} X
            %div
              = required_label_tag "campsite_#{campsite.id}_signup_minor_#{index}_first_name", "First name"
              = text_field_tag "campsite_signup[campsite_signup_minors_attributes][#{index}][first_name]", "", id: "campsite_#{campsite.id}_signup_minor_#{index}_first_name", data: { required_for_minor: "true", action: "input->signature#updatePaymentSummary" }
            %div
              = required_label_tag "campsite_#{campsite.id}_signup_minor_#{index}_last_name", "Last name"
              = text_field_tag "campsite_signup[campsite_signup_minors_attributes][#{index}][last_name]", "", id: "campsite_#{campsite.id}_signup_minor_#{index}_last_name", data: { required_for_minor: "true", action: "input->signature#updatePaymentSummary" }
            %div
              = required_label_tag "campsite_#{campsite.id}_signup_minor_#{index}_age", "Age"
              = number_field_tag "campsite_signup[campsite_signup_minors_attributes][#{index}][age]", "", id: "campsite_#{campsite.id}_signup_minor_#{index}_age", min: 0, max: 17, data: { required_for_minor: "true", action: "input->signature#updateCapacityWarning input->signature#updatePaymentSummary" }
            %div
              = required_label_tag "campsite_#{campsite.id}_signup_minor_#{index}_relationship", "Relationship"
              = text_field_tag "campsite_signup[campsite_signup_minors_attributes][#{index}][relationship]", "", id: "campsite_#{campsite.id}_signup_minor_#{index}_relationship", placeholder: "Parent, Guardian, Uncle, etc", data: { required_for_minor: "true" }
          - if index.zero?
            %button.add-person-link{"data-action" => "signature#revealPartyRow", "data-add-party-row" => "", type: "button"} Add another minor
    - unless waiver_only || hide_fee_fields
      %section.fee-fields{"data-signature-target" => "feeFields"}
        .fee-section-row
          %fieldset.fee-section
            %legend Adult Fees
            .fee-rate
              %span
                First 2 nights total
                %span.fee-note (no single night option)
              %strong= format_cents(site_setting.first_two_nights_fee_cents)
            .fee-rate
              %span Additional nights
              %strong= format_cents(site_setting.extra_night_fee_cents)
          %fieldset.fee-section
            %legend Minor Fees
            .fee-rate
              %span Ages 0 to #{site_setting.uncounted_minor_age_limit - 1}
              %strong Free
            .fee-rate
              %span Ages #{site_setting.uncounted_minor_age_limit} to 17
              %span.fee-note (first two nights)
              %strong= format_cents(site_setting.minor_fee_cents)
            .fee-rate
              %span Additional nights
              %strong= format_cents(site_setting.minor_extra_night_fee_cents)
        .fee-section-row
          %fieldset.fee-section.payment-due-section
            %legend Payment Due
            .payment-line-items{"data-signature-target" => "paymentLineItems", :hidden => ""}
            %p.payment-summary{"data-signature-target" => "paymentSummary"} Choose dates to see payment amount.
          %fieldset.fee-section.refund-policy-section
            %legend Refund Policy
            %p Full refund if canceled 7 or more days before trip start.
            %p No refund within seven days as it becomes hard for the club to fill the spot.

    .form-actions
      %button.button.secondary{"data-action" => "modal#close", :type => "button"} Cancel
      %button.button{"data-action" => "signature#continueSignup", "data-signature-target" => "signupStepSubmit", :type => "button"} Next
  %section.waiver-intro{"data-signature-target" => "intro", :hidden => ""}
    .waiver-intro-copy
      - TripSignupWaiver.acknowledgement_blocks.each do |block|
        %p= block
    .form-actions
      %button.button.secondary{"data-action" => "modal#close", :type => "button"} Cancel
      %button.button{"data-action" => "signature#showWaiver", :type => "button"} Agree and Sign Waiver
  %div{"data-signature-target" => "waiverStep", :hidden => ""}
    %section.waiver-text{"data-action" => "scroll->signature#checkWaiverScroll", "data-signature-target" => "waiver"}
      .waiver-document
        - TripSignupWaiver.blocks.each_with_index do |block, index|
          - if TripSignupWaiver.title_block?(index)
            %h3.waiver-title= block
          - elsif TripSignupWaiver.warning_block?(index)
            %p.waiver-warning= block
          - elsif TripSignupWaiver.summary_heading_block?(index)
            %h4.waiver-summary-heading= block
          - else
            %p= block
    .signature-field
      .signature-label-row
        %label{:for => signature_id}
          Signature
          = required_marker
        %span You must view all the text to sign
      %canvas.signature-pad{id: signature_id, "data-signature-target" => "canvas", :height => "120", :width => "560"}
      = hidden_field_tag "campsite_signup[waiver_signature_data]", "", data: { signature_target: "input" }
      = hidden_field_tag "campsite_signup[waiver_acknowledged_at]", "", data: { signature_target: "acknowledgementInput" }
    .form-actions.waiver-signature-actions
      %button.button.secondary{"data-action" => "signature#clear", :type => "button"} Clear signature
      .waiver-signature-submit-actions
        %button.button.secondary{"data-action" => "modal#close", :type => "button"} Cancel
        = button_tag modal_submit_text, type: :submit, class: "button", data: { signature_target: "submit" }, disabled: true
