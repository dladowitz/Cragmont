= link_to trip_path(trip), class: "trip-card", aria: { label: "View #{public_member_text(trip.name, trip: trip)}" } do
  %div
    %h2= public_member_text(trip.name, trip: trip)
    .trip-card-title-line
      %p= public_member_text(trip.location, trip: trip)
      = trip_type_badge(trip)
  %dl.trip-card-meta
    %div
      %dt Dates
      %dd
        %span.date-range-desktop
          = trip.start_date.to_fs(:long)
          - unless trip.single_day_event?
            to #{trip.end_date.to_fs(:long)}
        %span.date-range-mobile
          = trip.start_date.strftime("%m/%d/%y")
          - unless trip.single_day_event?
            to #{trip.end_date.strftime("%m/%d/%y")}
    - if archived
      %div
        %dt= trip.single_day_event? ? "Participants" : "Sites"
        %dd= trip.single_day_event? ? trip.confirmed_signup_count : trip.campsite_count
    - elsif !trip.class_trip? && user_signed_in?
      %div
        %dt Open Spaces
        %dd
          = ui_badge(class: (trip.capacity_full? ? "danger-status" : (trip.almost_full? ? "warning-status" : "success-status"))) do
            = trip.capacity_full? ? "Full, waitlist open" : pluralize(trip.available_participant_capacity, "space")
