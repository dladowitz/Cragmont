- content_for :body_class, "trips-index-page"
= render "shared/public_header"
.trips-mobile-hero{aria: {hidden: "true"}}
  %h1.trips-mobile-hero-title Trips
  %span.trips-mobile-hero-caption Regular Northwest Face, Half Dome
%main.public-main
  %section.panel.trips-index-panel
    .panel-header
      .trips-index-copy
        .trips-index-title-row
          %h1 Trips
          = link_to "Past Trips", past_trips_trips_path
        .public-beta-notice.trips-faq-callout
          %span
            Want to know what to expect? Read about
            = link_to "camping trips", what_to_expect_trips_path
            or
            = link_to "day trips.", day_trip_what_to_expect_trips_path
      .trips-index-notices
        .public-beta-notice
          %span
            This site is still getting dialed in. If you find issues
            = link_to "let us know.", new_help_request_path
    - if @trips.any?
      .trip-cards
        - @trips.each do |trip|
          = link_to trip_path(trip), class: "trip-card", aria: { label: "View #{trip.name}" } do
            %div
              %h2= trip.name
              %p= trip.location
            %dl.trip-card-meta
              %div
                %dt Dates
                %dd
                  %span.date-range-desktop
                    = trip.start_date.to_fs(:long)
                    to #{trip.end_date.to_fs(:long)}
                  %span.date-range-mobile
                    = trip.start_date.strftime("%m/%d/%y")
                    to #{trip.end_date.strftime("%m/%d/%y")}
              %div
                %dt Open Spaces
                %dd
                  = pluralize(trip.available_participant_capacity, "space")
    - else
      %p.muted No published trips are available right now.
  = render "shared/liability_warning"
%p.background-image-caption Regular Northwest Face, Half Dome
