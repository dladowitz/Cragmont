- content_for :body_class, "trips-index-page"
= render "shared/public_header"
.trips-mobile-hero{aria: {hidden: "true"}}
  %h1.trips-mobile-hero-title Trips
  %span.trips-mobile-hero-caption Half Dome, Regular Northwest Face
%main.public-main
  %section.panel.trips-index-panel
    .panel-header
      .trips-index-copy
        %h1 Trips
        .public-beta-notice.trips-faq-callout
          %span
            Want to know what to expect on a Cragmont trip? Read 
            = link_to "here.", what_to_expect_trips_path
      .trips-index-notices
        .public-beta-notice
          %span
            This site is still getting dialed in. If you find issues
            = link_to "let us know.", new_help_request_path
    - if @trips.any?
      .trip-cards
        - @trips.each do |trip|
          %article.trip-card
            %div
              %h2= link_to trip.name, trip_path(trip)
              %p= trip.location
            %dl.trip-card-meta
              %div
                %dt Dates
                %dd
                  = trip.start_date.to_fs(:long)
                  to #{trip.end_date.to_fs(:long)}
              %div
                %dt Capacity
                %dd
                  = trip.total_participant_capacity
                  participants
            = link_to "View trip", trip_path(trip), class: "button secondary"
    - else
      %p.muted No published trips are available right now.
  - if @archived_trips.any?
    %section#archived-trips.panel.archived-trips-panel
      .panel-header
        %div
          %h2 Archived trips
          %p.muted Past routes you can still browse. Archived trips are closed for new participants.
      .archived-trip-list
        - @archived_trips.each do |trip|
          %article.archived-trip-row
            %div
              %h3= link_to trip.name, trip_path(trip)
              %p= trip.location
            %dl.archived-trip-meta
              %div
                %dt Dates
                %dd
                  = trip.start_date.to_fs(:long)
                  to #{trip.end_date.to_fs(:long)}
              %div
                %dt Sites
                %dd= trip.campsite_count
            = link_to "View trip", trip_path(trip), class: "button secondary"
      - if @archived_total_pages > 1
        %nav.pagination{aria: {label: "Archived trip pages"}}
          - if @archived_current_page > 1
            = link_to "Previous", trips_path(archived_page: @archived_current_page - 1, anchor: "archived-trips"), class: "button secondary"
          %span.pagination-summary Page #{@archived_current_page} of #{@archived_total_pages}
          - if @archived_current_page < @archived_total_pages
            = link_to "Next", trips_path(archived_page: @archived_current_page + 1, anchor: "archived-trips"), class: "button secondary"
  = render "shared/liability_warning"
%p.background-image-caption Half Dome, Regular Northwest Face
