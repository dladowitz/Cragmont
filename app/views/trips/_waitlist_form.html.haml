- modal_id = "campsite-waitlist-#{campsite.id}"
%div{"data-controller" => "modal"}
  %button.button{"data-action" => "modal#open", :type => "button"} Join waitlist
  %dialog.signup-modal{"aria-labelledby" => modal_id, "data-action" => "click->modal#closeOnBackdrop", "data-modal-target" => "dialog"}
    .signup-modal-content
      %div
        %h2{id: modal_id} Join trip waitlist
        %p
          = campsite.campground.name
          site #{campsite.site_number}
      = form_with url: trip_campsite_campsite_signup_path(trip, campsite), method: :post, class: "waitlist-form", data: { controller: "waitlist-form" } do
        = hidden_field_tag "campsite_signup[intent]", "join_waitlist"
        %fieldset.signup-kind-options
          %legend.visually-hidden Additional participants
          %label
            = check_box_tag "campsite_signup[with_guests]", "1", false, id: "campsite_#{campsite.id}_waitlist_with_guests", data: { waitlist_form_target: "guestToggle", action: "waitlist-form#togglePartyFields" }
            %span Add and aditional adult (max 2)
          %label
            = check_box_tag "campsite_signup[with_minors]", "1", false, id: "campsite_#{campsite.id}_waitlist_with_minors", data: { waitlist_form_target: "minorToggle", action: "waitlist-form#togglePartyFields" }
            %span Add minors (under 18)
        %section.guest-fields{"data-party-fields" => "guest", "data-required-dataset-key" => "requiredForGuest", "data-waitlist-form-target" => "guestFields", :hidden => ""}
          %h3
            Adult information
            %span.section-limit (Max #{CampsiteSignup::MAX_GUESTS_PER_SIGNUP})
          - CampsiteSignup::MAX_GUESTS_PER_SIGNUP.times do |index|
            .guest-field-row{"data-party-row" => "", "data-party-row-visible" => (index.zero? ? "true" : "false"), hidden: !index.zero?}
              %button.remove-person-button{"aria-label" => "Remove guest", "data-action" => "waitlist-form#removePartyRow", type: "button"} X
              %div
                = required_label_tag "campsite_#{campsite.id}_waitlist_guest_#{index}_first_name", "First name"
                = text_field_tag "campsite_signup[guest_attributes][#{index}][first_name]", "", id: "campsite_#{campsite.id}_waitlist_guest_#{index}_first_name", data: { required_for_guest: "true" }
              %div
                = required_label_tag "campsite_#{campsite.id}_waitlist_guest_#{index}_last_name", "Last name"
                = text_field_tag "campsite_signup[guest_attributes][#{index}][last_name]", "", id: "campsite_#{campsite.id}_waitlist_guest_#{index}_last_name", data: { required_for_guest: "true" }
              %div
                = required_label_tag "campsite_#{campsite.id}_waitlist_guest_#{index}_email", "Email"
                = email_field_tag "campsite_signup[guest_attributes][#{index}][email]", "", id: "campsite_#{campsite.id}_waitlist_guest_#{index}_email", data: { required_for_guest: "true" }
              %div
                = label_tag "campsite_#{campsite.id}_waitlist_guest_#{index}_phone", "Phone"
                = telephone_field_tag "campsite_signup[guest_attributes][#{index}][phone]", "", id: "campsite_#{campsite.id}_waitlist_guest_#{index}_phone"
            - if index.zero? && CampsiteSignup::MAX_GUESTS_PER_SIGNUP > 1
              %button.add-person-link{"data-action" => "waitlist-form#revealPartyRow", "data-add-party-row" => "", type: "button"} Add another adult
        %section.minor-fields{"data-party-fields" => "minor", "data-required-dataset-key" => "requiredForMinor", "data-waitlist-form-target" => "minorFields", :hidden => ""}
          %h3
            Minor information
            %span.section-limit (Max 2)
          - 2.times do |index|
            .minor-field-row{"data-party-row" => "", "data-party-row-visible" => (index.zero? ? "true" : "false"), hidden: !index.zero?}
              %button.remove-person-button{"aria-label" => "Remove minor", "data-action" => "waitlist-form#removePartyRow", type: "button"} X
              %div
                = required_label_tag "campsite_#{campsite.id}_waitlist_minor_#{index}_first_name", "First name"
                = text_field_tag "campsite_signup[campsite_signup_minors_attributes][#{index}][first_name]", "", id: "campsite_#{campsite.id}_waitlist_minor_#{index}_first_name", data: { required_for_minor: "true" }
              %div
                = required_label_tag "campsite_#{campsite.id}_waitlist_minor_#{index}_last_name", "Last name"
                = text_field_tag "campsite_signup[campsite_signup_minors_attributes][#{index}][last_name]", "", id: "campsite_#{campsite.id}_waitlist_minor_#{index}_last_name", data: { required_for_minor: "true" }
              %div
                = required_label_tag "campsite_#{campsite.id}_waitlist_minor_#{index}_age", "Age"
                = number_field_tag "campsite_signup[campsite_signup_minors_attributes][#{index}][age]", "", id: "campsite_#{campsite.id}_waitlist_minor_#{index}_age", min: 0, max: 17, data: { required_for_minor: "true" }
              %div
                = required_label_tag "campsite_#{campsite.id}_waitlist_minor_#{index}_relationship", "Relationship"
                = text_field_tag "campsite_signup[campsite_signup_minors_attributes][#{index}][relationship]", "", id: "campsite_#{campsite.id}_waitlist_minor_#{index}_relationship", placeholder: "Parent, Guardian, Uncle, etc", data: { required_for_minor: "true" }
            - if index.zero?
              %button.add-person-link{"data-action" => "waitlist-form#revealPartyRow", "data-add-party-row" => "", type: "button"} Add another minor
        .form-actions
          %button.button.secondary{"data-action" => "modal#close", :type => "button"} Cancel
          = button_tag "Join waitlist", type: :submit, class: "button"
