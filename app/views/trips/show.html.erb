<%= render "shared/public_header" %>

<main class="public-main">
  <section class="panel trip-overview">
    <div class="panel-header trip-summary-header">
      <div class="trip-summary-copy">
        <div class="trip-title-line">
          <h1><%= @trip.name %></h1>
          <% if @trip.capacity_full? %>
            <span class="status danger-status">Trip Full</span>
          <% elsif @trip.almost_full? %>
            <span class="status warning-status">Almost Full</span>
          <% end %>
        </div>
        <h2><%= @trip.location %></h2>
        <p><%= @trip.start_date.to_fs(:long) %> to <%= @trip.end_date.to_fs(:long) %></p>

        <% if @trip.description.present? %>
          <div class="description">
            <strong>Notes:</strong>
            <%= simple_format(@trip.description) %>
          </div>
        <% end %>
      </div>

      <aside class="signup-panel">
        <% if @current_signup.present? %>
          <strong>You are <%= @current_signup.status %> for this trip.</strong>
          <div data-controller="modal">
            <% remove_button_text = @current_signup.waitlisted? ? "Remove me from the waitlist" : "Remove me from this trip" %>
            <% remove_title = @current_signup.waitlisted? ? "Remove yourself from the waitlist?" : "Remove yourself from this trip?" %>
            <button type="button" class="button danger" data-action="modal#open"><%= remove_button_text %></button>

            <dialog class="signup-modal" data-modal-target="dialog" data-action="click->modal#closeOnBackdrop">
              <div class="signup-modal-content">
                <div>
                  <h2><%= remove_title %></h2>
                  <p><%= @trip.name %></p>
                </div>

                <div class="form-actions">
                  <button type="button" class="button secondary" data-action="modal#close">Cancel</button>
                  <%= button_to remove_button_text, trip_trip_signup_path(@trip), method: :delete, class: "button danger" %>
                </div>
              </div>
            </dialog>
          </div>
        <% elsif user_signed_in? %>
          <div data-controller="modal">
            <% waitlist_signup = @trip.capacity_full? %>
            <% signup_button_text = waitlist_signup ? "Sign up for the waitlist" : "Sign up for this trip" %>
            <% modal_title = waitlist_signup ? "Sign up for WAITLIST" : "Sign up for #{@trip.name}" %>
            <% modal_submit_text = waitlist_signup ? "Sign up for Waitlist" : "Pay Now and Sign Up" %>
            <button type="button" class="button" data-action="modal#open"><%= signup_button_text %></button>

            <dialog class="signup-modal" data-modal-target="dialog" data-action="click->modal#closeOnBackdrop">
              <div class="signup-modal-content">
                <div>
                  <h2><%= modal_title %></h2>
                  <p><%= @trip.start_date.to_fs(:long) %> to <%= @trip.end_date.to_fs(:long) %></p>
                </div>

                <%= form_with url: trip_trip_signup_path(@trip), method: :post, class: "waiver-form", data: { controller: "signature" } do %>
                  <section class="signup-kind-step" data-signature-target="signupStep">
                    <fieldset class="signup-kind-options">
                      <legend>Who are you signing up?</legend>
                      <label>
                        <%= radio_button_tag "trip_signup[signup_kind]", "self", true, data: { signature_target: "signupKind", action: "signature#toggleMinorFields" } %>
                        <span>I am signing up for myself</span>
                      </label>
                      <label>
                        <%= radio_button_tag "trip_signup[signup_kind]", "with_minors", false, data: { signature_target: "signupKind", action: "signature#toggleMinorFields" } %>
                        <span>I am signing up for myself and minors (max 2)</span>
                      </label>
                    </fieldset>

                    <section class="minor-fields" data-signature-target="minorFields" hidden>
                      <h3>Minor information</h3>
                      <% 2.times do |index| %>
                        <div class="minor-field-row">
                          <div>
                            <%= label_tag "trip_signup_minor_#{index}_first_name", "First name" %>
                            <%= text_field_tag "trip_signup[trip_signup_minors_attributes][#{index}][first_name]", "", id: "trip_signup_minor_#{index}_first_name", data: ({ required_for_minor: "true" } if index.zero?) %>
                          </div>
                          <div>
                            <%= label_tag "trip_signup_minor_#{index}_last_name", "Last name" %>
                            <%= text_field_tag "trip_signup[trip_signup_minors_attributes][#{index}][last_name]", "", id: "trip_signup_minor_#{index}_last_name", data: ({ required_for_minor: "true" } if index.zero?) %>
                          </div>
                          <div>
                            <%= label_tag "trip_signup_minor_#{index}_age", "Age" %>
                            <%= number_field_tag "trip_signup[trip_signup_minors_attributes][#{index}][age]", "", id: "trip_signup_minor_#{index}_age", min: 0, max: 17, data: ({ required_for_minor: "true" } if index.zero?) %>
                          </div>
                          <div>
                            <%= label_tag "trip_signup_minor_#{index}_relationship", "Relationship" %>
                            <%= text_field_tag "trip_signup[trip_signup_minors_attributes][#{index}][relationship]", "", id: "trip_signup_minor_#{index}_relationship", placeholder: "Parent, Guardian, Uncle, etc", data: ({ required_for_minor: "true" } if index.zero?) %>
                          </div>
                        </div>
                      <% end %>
                    </section>

                    <div class="form-actions">
                      <button type="button" class="button secondary" data-action="modal#close">Cancel</button>
                      <button type="button" class="button" data-action="signature#showAcknowledgement">Next</button>
                    </div>
                  </section>

                  <section class="waiver-intro" data-signature-target="intro" hidden>
                    <div class="waiver-intro-copy">
                      <% TripSignupWaiver.acknowledgement_blocks.each do |block| %>
                        <p><%= block %></p>
                      <% end %>
                    </div>

                    <div class="form-actions">
                      <button type="button" class="button secondary" data-action="modal#close">Cancel</button>
                      <button type="button" class="button" data-action="signature#showWaiver">Agree and Sign Waiver</button>
                    </div>
                  </section>

                  <div data-signature-target="waiverStep" hidden>
                    <section
                      class="waiver-text"
                      data-signature-target="waiver"
                      data-action="scroll->signature#checkWaiverScroll">
                      <div class="waiver-document">
                        <% TripSignupWaiver.blocks.each_with_index do |block, index| %>
                          <% if TripSignupWaiver.title_block?(index) %>
                            <h3 class="waiver-title"><%= block %></h3>
                          <% elsif TripSignupWaiver.warning_block?(index) %>
                            <p class="waiver-warning"><%= block %></p>
                          <% elsif TripSignupWaiver.summary_heading_block?(index) %>
                            <h4 class="waiver-summary-heading"><%= block %></h4>
                          <% else %>
                            <p><%= block %></p>
                          <% end %>
                        <% end %>
                      </div>
                    </section>

                    <div class="signature-field">
                      <div class="signature-label-row">
                        <label for="trip-signup-signature">Signature</label>
                        <span>You must view all the text to sign</span>
                      </div>
                      <canvas
                        id="trip-signup-signature"
                        class="signature-pad"
                        width="560"
                        height="120"
                        data-signature-target="canvas"></canvas>
                      <%= hidden_field_tag "trip_signup[waiver_signature_data]", "", data: { signature_target: "input" } %>
                      <%= hidden_field_tag "trip_signup[waiver_acknowledged_at]", "", data: { signature_target: "acknowledgementInput" } %>
                    </div>

                    <div class="form-actions waiver-signature-actions">
                      <button type="button" class="button secondary" data-action="signature#clear">Clear signature</button>
                      <div class="waiver-signature-submit-actions">
                        <button type="button" class="button secondary" data-action="modal#close">Cancel</button>
                        <%= button_tag modal_submit_text, type: :submit, class: "button", data: { signature_target: "submit" }, disabled: true %>
                      </div>
                    </div>
                  </div>
                <% end %>
              </div>
            </dialog>
          </div>
        <% else %>
          <%= link_to "Log in to sign up", new_session_path, class: "button" %>
        <% end %>
      </aside>
    </div>

    <div class="stats">
      <% if @trip.confirmed_uncounted_minor_count.positive? %>
        <div class="split-signup-stat">
          <section>
            <strong><%= @trip.confirmed_signup_count %></strong>
            <span>Signed up</span>
          </section>
          <section>
            <strong><%= @trip.confirmed_uncounted_minor_count %></strong>
            <span class="under-13-label">Under <%= @trip.uncounted_minor_age_limit %></span>
          </section>
        </div>
      <% else %>
        <div><strong><%= @trip.confirmed_signup_count %></strong><span>Signed up</span></div>
      <% end %>
      <div class="availability-stat <%= @trip.capacity_full? ? "danger-stat" : (@trip.almost_full? ? "warning-stat" : "success-stat") %>">
        <strong><%= @trip.available_participant_capacity %></strong>
        <span>Spaces available</span>
      </div>
      <div><strong><%= @trip.total_participant_capacity %></strong><span>Total capacity</span></div>
      <div><strong><%= @trip.campsite_count %></strong><span>Campsites</span></div>
    </div>
  </section>

  <section class="panel">
    <h2>Attendees</h2>
    <% if @confirmed_signups.any? %>
      <ul class="attendee-list">
        <% @confirmed_signups.each do |signup| %>
          <li><%= signup.public_attendee_name %></li>
        <% end %>
      </ul>
    <% else %>
      <p class="muted">No confirmed attendees yet.</p>
    <% end %>

    <% if @waitlisted_signups.any? %>
      <div class="waitlist">
        <h3>Waitlist</h3>
        <ul class="attendee-list">
          <% @waitlisted_signups.each do |signup| %>
            <li><%= signup.public_attendee_name %></li>
          <% end %>
        </ul>
      </div>
    <% end %>
  </section>

  <section class="panel campsites-panel">
    <h2>Campsites</h2>
    <% if @campsites_by_campground.any? %>
      <% @campsites_by_campground.each do |campground, campsites| %>
        <div class="campground-group">
          <h3><%= campground.name %></h3>
          <p><%= campground.location %></p>
          <table>
            <thead>
              <tr>
                <th>Site</th>
                <th>Reservation dates</th>
                <th>Capacity limit</th>
                <th>Cars</th>
              </tr>
            </thead>
            <tbody>
              <% campsites.each do |campsite| %>
                <tr class="<%= "campsite-row-with-notes" if campsite.notes.present? %>">
                  <td><%= campsite.site_number %></td>
                  <td>
                    <dl class="date-pair">
                      <div>
                        <dt>Arrival</dt>
                        <dd><%= campsite.arrival_date.to_fs(:long) %></dd>
                      </div>
                      <div>
                        <dt>Checkout</dt>
                        <dd><%= campsite.checkout_date.to_fs(:long) %></dd>
                      </div>
                    </dl>
                  </td>
                  <td><%= campsite.participant_capacity %></td>
                  <td><%= campsite.car_capacity %></td>
                </tr>
                <% if campsite.notes.present? %>
                  <tr class="campsite-notes-row">
                    <td></td>
                    <td colspan="3">
                      <strong>Notes:</strong>
                      <%= campsite.notes %>
                    </td>
                  </tr>
                <% end %>
              <% end %>
            </tbody>
          </table>
        </div>
      <% end %>
    <% else %>
      <p class="muted">No campsite reservations have been added yet.</p>
    <% end %>
  </section>

  <section class="panel">
    <h2>Campsite coordinator</h2>
    <% if @trip.campsite_coordinator.present? %>
      <dl class="details-list">
        <div>
          <dt>Name</dt>
          <dd><%= @trip.campsite_coordinator.full_name %></dd>
        </div>
        <div>
          <dt>Email</dt>
          <dd><%= mail_to @trip.campsite_coordinator.email if @trip.campsite_coordinator.email.present? %></dd>
        </div>
        <div>
          <dt>Phone</dt>
          <dd><%= @trip.campsite_coordinator.phone.presence || "None" %></dd>
        </div>
      </dl>
    <% else %>
      <p class="muted">Unassigned</p>
    <% end %>
  </section>
</main>
