- content_for :body_class, "trip-show-page"
- parking_policy_tooltip = "Reserved Spots are assigned to the person who registered the site. Then to the Campsite Coordinator. Then to club members.\n\nOther spots are set to Open and are first come, first serve."
- open_spot_tooltip = "Open Spots are first come, first serve.\nWhoever arrives at the campsite first can claim for the weekend"
- uncounted_minor_tooltip = "Children under 10 don't count against Total Capacity"
= render "shared/public_header"
%main.public-main
  %section.panel.trip-overview
    .panel-header.trip-summary-header
      .trip-summary-copy
        .trip-title-line
          %h1= @trip.name
          - if @trip.capacity_full?
            %span.status.danger-status Trip Full
          - elsif @trip.almost_full?
            %span.status.warning-status Almost Full
        %h2= @trip.location
        %p
          = @trip.start_date.to_fs(:long)
          to #{@trip.end_date.to_fs(:long)}
        - if @trip.description.present?
          .description
            %strong Notes:
            = simple_format(@trip.description)
      .public-beta-notice
        %strong In Beta
        %span
          This site is still getting dialed in. If you find issues
          = link_to "let us know.", new_help_request_path
    .stats
      - if @trip.confirmed_uncounted_minor_count.positive?
        .split-signup-stat
          %section
            %span Signed up
            %strong= @trip.confirmed_signup_count
          %section
            %span.under-13-label
              Under #{@trip.uncounted_minor_age_limit}
              %span.info-tooltip.under-minor-tooltip{aria: { label: uncounted_minor_tooltip }, tabindex: "0"}
                %span.info-tooltip-icon{aria: { hidden: "true" }} i
                %span.info-tooltip-box{role: "tooltip"}= uncounted_minor_tooltip
            %strong= @trip.confirmed_uncounted_minor_count
      - else
        %div
          %span Signed up
          %strong= @trip.confirmed_signup_count
      %div{:class => "availability-stat #{@trip.capacity_full? ? "danger-stat" : (@trip.almost_full? ? "warning-stat" : "success-stat")}"}
        %span Open Spaces
        %strong= @trip.available_participant_capacity
      %div
        %span Total Capacity
        %strong= @trip.total_participant_capacity
      %div
        %span Campsites
        %strong= @trip.campsite_count
  %section.panel.campsites-panel
    %h2 Campsites
    - if @campsites.any?
      .campsite-card-list
        - @campsites.each do |campsite|
          - current_confirmed_signup = @current_signup&.confirmed?
          - current_pending_signup = @current_signup&.pending_payment?
          - current_waitlisted_signup = @current_signup&.waitlisted?
          - signed_up_for_this_campsite = (current_confirmed_signup || current_pending_signup) && @current_signup.campsite_id == campsite.id
          - signed_up_for_another_campsite = (current_confirmed_signup || current_pending_signup) && @current_signup.campsite_id != campsite.id
          - waitlist_confirmation_available = current_waitlisted_signup && @waitlist_confirmation_campsite_ids.include?(campsite.id)
          - waitlist_direct_signup_available = current_waitlisted_signup && campsite.direct_signup_available? && campsite.available_participant_capacity >= @current_signup.party_capacity_count
          - locked_with_open_spots = campsite.signups_locked? && campsite.available_participant_capacity.positive?
          %section.campsite-card{id: "campsite-#{campsite.id}"}
            .campsite-card-header
              .campsite-card-summary
                %h3
                  = campsite.campground.name
                  site #{campsite.site_number}
                %p= campsite.campground.location
                %dl.date-pair
                  %div
                    %dt Arrival
                    %dd= campsite.arrival_date.to_fs(:long)
                  %div
                    %dt Checkout
                    %dd= campsite.checkout_date.to_fs(:long)
              .campsite-signup-action{class: ("waitlisted-campsite-action" if current_waitlisted_signup)}
                - if @trip.archived?
                  %p.muted.already-signed-up-note Archived trip. New participant signups are closed.
                - elsif signed_up_for_this_campsite
                  - if current_pending_signup
                    %strong Payment pending for this campsite.
                    - if @current_signup.current_payment&.checkout_url.present?
                      = link_to "Return to payment", @current_signup.current_payment.checkout_url, class: "button", target: "_blank", rel: "noopener"
                  - else
                    %strong
                      You are #{@current_signup.status} for this campsite.
                    - if @current_signup.guest?
                      %p.muted.already-signed-up-note #{@current_signup.guest_of_signup.user.full_name} signed you up
                    - else
                      %div{"data-controller" => "modal"}
                        - remove_button_text = @current_signup.waitlisted? ? "Remove me from the waitlist" : "Remove me from this campsite"
                        - remove_title = @current_signup.waitlisted? ? "Remove yourself from the waitlist?" : "Remove yourself from this campsite?"
                        - refund_amount_cents = @current_signup.refund_eligible? ? @current_signup.refundable_amount_cents : 0
                        %button.button.danger{"data-action" => "modal#open", :type => "button"}= remove_button_text
                        %dialog.signup-modal{"data-action" => "click->modal#closeOnBackdrop", "data-modal-target" => "dialog"}
                          .signup-modal-content
                            %div
                              %h2= remove_title
                              %p
                                = campsite.campground.name
                                site #{campsite.site_number}
                              - unless @current_signup.waitlisted?
                                .cancellation-policy-details
                                  %p
                                    %strong Cancelation policy:
                                    Full refund if 7 or more days before start of trip
                                  %dl.details-list
                                    %div
                                      %dt Trip starts
                                      %dd= @trip.start_date.to_fs(:long)
                                    %div
                                      %dt Days until trip
                                      %dd= @current_signup.days_until_trip_start
                                    %div
                                      %dt Refund amount
                                      %dd= format_cents(refund_amount_cents)
                            .form-actions
                              %button.button.secondary{"data-action" => "modal#close", :type => "button"} Cancel
                              = button_to remove_button_text, trip_campsite_campsite_signup_path(@trip, campsite), method: :delete, class: "button danger"
                - elsif signed_up_for_another_campsite
                  %p.muted.already-signed-up-note You are already signed up for another campsite on this trip.
                - elsif current_waitlisted_signup
                  .waitlist-action-buttons
                    - if waitlist_confirmation_available
                      .waitlist-confirm-action
                        %p.spot-open-message A spot has opened up!
                        = render "campsite_signup_form", trip: @trip, campsite: campsite, confirm_waitlist: true
                    - elsif waitlist_direct_signup_available
                      = render "campsite_signup_form", trip: @trip, campsite: campsite, waitlist_direct_signup: true
                    - else
                      %button.button.secondary{:disabled => true, :type => "button"} On waitlist
                - elsif user_signed_in?
                  - if campsite.waitlist_signup_required?
                    = render "waitlist_form", trip: @trip, campsite: campsite
                    - if locked_with_open_spots
                      %p.campsite-lock-notice
                        Spots filled on #{campsite.signups_locked_at.strftime("%-m/%Y")}.
                        %br
                        Waitlisted sign ups only
                  - else
                    = render "campsite_signup_form", trip: @trip, campsite: campsite
                - else
                  = link_to "Log in to sign up", new_session_path, class: "button"
            .campsite-card-details
              .stats.campsite-stats
                - if campsite.confirmed_uncounted_minor_count.positive?
                  .split-signup-stat
                    %section
                      %span Signed up
                      %strong= campsite.confirmed_signup_count
                    %section
                      %span.under-13-label
                        Under #{@trip.uncounted_minor_age_limit}
                        %span.info-tooltip.under-minor-tooltip{aria: { label: uncounted_minor_tooltip }, tabindex: "0"}
                          %span.info-tooltip-icon{aria: { hidden: "true" }} i
                          %span.info-tooltip-box{role: "tooltip"}= uncounted_minor_tooltip
                      %strong= campsite.confirmed_uncounted_minor_count
                - else
                  %div
                    %span Signed up
                    %strong= campsite.confirmed_signup_count
                %div{:class => "availability-stat #{campsite.capacity_full? ? "danger-stat" : "success-stat"}"}
                  %span Open Spaces
                  %strong= campsite.available_participant_capacity
                %div
                  %span Total Capacity
                  %strong= campsite.participant_capacity
                .parking-stat
                  %span Parking
                  .parking-breakdown
                    .parking-breakdown-item
                      %strong= campsite.reserved_parking_count
                      %span Reserved
                    .parking-breakdown-item
                      %strong= campsite.first_come_first_serve_parking_spot_count
                      %span Open
              - if campsite.notes.present?
                %p.campsite-notes
                  %strong Notes:
                  = campsite.notes
            .campsite-participant-groups
              .confirmed-signups-section
                %h4 Confirmed participants
                - if campsite.confirmed_signups.any?
                  %table.confirmed-participants-table
                    %thead
                      %tr
                        %th Participant
                        %th Dates
                        %th
                          %span.tooltip-heading.info-tooltip.parking-tooltip{aria: { label: parking_policy_tooltip }, tabindex: "0"}
                            %span Parking
                            %span.info-tooltip-icon{aria: { hidden: "true" }} i
                            %span.info-tooltip-box{role: "tooltip"}= parking_policy_tooltip
                        %th Waiver
                        %th Member
                        %th Minors
                    - signups_by_primary_id = campsite.confirmed_signups.group_by { |signup| signup.guest_of_signup_id || signup.id }
                    - display_signups = campsite.confirmed_signups.reject(&:guest?).flat_map { |signup| [signup] + signups_by_primary_id.fetch(signup.id, []).select(&:guest?) }
                    %tbody
                      - display_signups.each_with_index do |signup, index|
                        - party_primary = !signup.guest? && signup.includes_guests?
                        - party_guest = signup.guest?
                        - next_signup = display_signups[index + 1]
                        - party_last = party_guest && (!next_signup&.guest? || next_signup.guest_of_signup_id != signup.guest_of_signup_id)
                        %tr{class: [("public-party-primary-row" if party_primary), ("public-party-guest-row" if party_guest), ("public-party-last-row" if party_last)].compact}
                          %td
                            %span.public-party-participant-name= signup.user.public_name
                          %td= signup.attendance_date_range
                          %td
                            - if signup.first_come_first_serve?
                              %span.parking-status-with-tooltip
                                %span.parking-status-label= signup.parking_status_label
                                %span.info-tooltip.parking-tooltip{aria: { label: open_spot_tooltip }, tabindex: "0"}
                                  %span.info-tooltip-icon{aria: { hidden: "true" }} i
                                  %span.info-tooltip-box{role: "tooltip"}= open_spot_tooltip
                            - else
                              = signup.parking_status_label
                          %td
                            - waiver_missing = !signup.waiver_signed?
                            - if waiver_missing
                              - if user_signed_in? && signup.guest? && signup.guest_of_signup&.user_id == current_user.id
                                - guest_waiver_link = trip_path(@trip, complete_signup: signup.signed_id(purpose: :complete_guest_details), anchor: "campsite-#{campsite.id}")
                                - guest_waiver_url = trip_url(@trip, complete_signup: signup.signed_id(purpose: :complete_guest_details), anchor: "campsite-#{campsite.id}")
                                - guest_email_path = trip_guest_waiver_email_path(@trip, signup)
                                %div{"data-controller" => "modal", "data-modal-disable-autofocus-value" => "true"}
                                  %button.missing-value.missing-link{"data-action" => "modal#open", type: "button"} Missing
                                  %dialog.signup-modal.guest-waiver-link-modal{"data-action" => "click->modal#closeOnBackdrop", "data-modal-target" => "dialog"}
                                    .signup-modal-content
                                      %div
                                        %h2 Guest waiver link
                                        %p Send this to #{signup.user.public_name} so they can sign the waiver.
                                      .admin-participant-link-share
                                        = link_to "Waiver Link", guest_waiver_link, class: "missing-details-link"
                                        .admin-participant-link-actions
                                          = render "guest_waiver_link_actions", waiver_link: guest_waiver_url, email_path: guest_email_path
                                      .form-actions
                                        %button.button.secondary{"data-action" => "modal#close", type: "button"} Close
                              - elsif user_signed_in? && signup.user_id == current_user.id
                                - details_link_purpose = signup.guest? ? :complete_guest_details : :complete_participant_details
                                = link_to "Missing", trip_path(@trip, complete_signup: signup.signed_id(purpose: details_link_purpose), anchor: "campsite-#{campsite.id}"), class: "missing-value missing-link"
                              - else
                                Missing
                            - else
                              Signed
                          %td= signup.user.member? ? "Yes" : "No"
                          %td
                            - minor_age_summary = signup.public_minor_age_summary(age_limit: @trip.uncounted_minor_age_limit)
                            - unless minor_age_summary == "None"
                              = minor_age_summary
                - else
                  %p.muted No confirmed participants yet.
      - if @waitlisted_signups.any?
        .waitlisted-signups-section.trip-waitlist-section
          .trip-waitlist-heading
            %h3 Trip waitlist
            %p.trip-waitlist-note Waitlist priority goes to club members
          %table.waitlist-table
            %thead
              %tr
                %th.waitlist-priority-column Priority
                %th Participant
                %th Member
                %th Joined Waitlist
                %th Self Signup
                %th.waitlist-availability-column Availability
                %th.waitlist-action-column{aria: { label: "Waitlist actions" }}
            %tbody
              - @waitlisted_signups.each_with_index do |signup, index|
                - signup_confirmation_campsites = @trip.waitlist_confirmation_campsites_for(signup)
                - direct_signup_available = @campsites.any? { |campsite| campsite.direct_signup_available? && campsite.available_participant_capacity >= signup.party_capacity_count }
                - signup_available_from_cards = signup_confirmation_campsites.any? || direct_signup_available
                %tr
                  %td.waitlist-priority-column= index + 1
                  %td= signup.public_waitlist_name
                  %td= signup.user.member? ? "Member" : "Non-member"
                  %td= signup.created_at.in_time_zone.strftime("%-m/%-d/%y %-l:%M%P")
                  %td= signup.waitlist_eligible? ? "Enabled" : "Disabled"
                  %td.waitlist-availability-column= signup_available_from_cards ? "Yes" : "No"
                  %td.waitlist-action-column
                    - if !@trip.archived? && @current_signup&.waitlisted? && signup.id == @current_signup.id
                      %div{"data-controller" => "modal"}
                        %button.button.danger{"data-action" => "modal#open", :type => "button"} Remove From Waitlist
                        %dialog.signup-modal{"data-action" => "click->modal#closeOnBackdrop", "data-modal-target" => "dialog"}
                          .signup-modal-content
                            %div
                              %h2 Remove me from the waitlist
                            .form-actions
                              %button.button.secondary{"data-action" => "modal#close", :type => "button"} Cancel
                              = button_to "Remove Me", trip_campsite_campsite_signup_path(@trip, @campsites.first), method: :delete, class: "button danger"
    - else
      %p.muted No campsite reservations have been added yet.
  %section.panel
    %h2 Campsite coordinator
    - if @trip.campsite_coordinator.present?
      %dl.details-list
        %div
          %dt Name
          %dd= @trip.campsite_coordinator.full_name
        %div
          %dt Email
          %dd= mail_to @trip.campsite_coordinator.email if @trip.campsite_coordinator.email.present?
    - else
      %p.muted Not yet set
  - if @completion_signup.present?
    = render "participant_details_modal", trip: @trip, signup: @completion_signup
  - if @show_payment_success_modal
    = render "payment_success_modal", trip: @trip, missing_waiver_links: @payment_success_missing_waiver_links
%p.background-image-caption Joshua Tree, IRS Wall
