%div{"data-controller" => "modal", "data-modal-clean-url-on-close-value" => "true", "data-modal-disable-autofocus-value" => "true", "data-modal-open-value" => "true"}
  %dialog.signup-modal.payment-success-modal{"data-action" => "click->modal#closeOnBackdrop", "data-modal-target" => "dialog"}
    .signup-modal-content.payment-success-modal-content
      %div
        - if local_assigns[:missing_waiver_links].present?
          %h2 You're not on Belay yet!
          %p Thank you for paying!
          %p We still need the other adults in your party to sign the waiver before you are confirmed.
          %p Send them these links to sign in and then climb on!
          %ul.payment-success-waiver-links
            - missing_waiver_links.each do |waiver_link_details|
              - name = waiver_link_details.fetch(:name)
              - waiver_path = waiver_link_details.fetch(:waiver_path)
              - waiver_url = waiver_link_details.fetch(:waiver_url)
              - email_path = waiver_link_details.fetch(:email_path)
              %li
                %span.payment-success-waiver-link-text
                  #{name}:
                  = link_to "Waiver Link", waiver_path
                .admin-participant-link-actions
                  = render "guest_waiver_link_actions", waiver_link: waiver_url, email_path: email_path
        - else
          %h2 Get stoked!
          %p
            Your trip to #{trip.name} is confirmed.
          %p We'll be sending you more info as the date gets closer.
          %br
          %p If you need to cancel, make sure to do it at least seven days before the start of the trip for a refund.
      .form-actions
        %button.button{"data-action" => "modal#close", type: "button"} Let's Go
