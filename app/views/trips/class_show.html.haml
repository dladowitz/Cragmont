- content_for :body_class, "trip-show-page day-trip-show-page class-trip-show-page"
- whatsapp_group_url = safe_external_url(@trip.whatsapp_group)
- weather_url = safe_external_url(@trip.weather_url)
- photo_album_url = safe_external_url(@trip.photo_album_url)
- partner_url = safe_external_url(@trip.partner_company&.website_url)
- class_signup_url = safe_external_url(@trip.class_signup_url)
= render "shared/public_header"
.trip-show-mobile-hero
  .trip-show-mobile-hero-copy
    .trip-title-line
      %h1= @trip.name
      %span.status.trip-type-badge= @trip.trip_type_label
    %p.trip-show-mobile-location= @trip.location
    %p.trip-show-mobile-dates= @trip.start_date.to_fs(:long)
    - if whatsapp_group_url.present?
      = link_to "Join the WhatsApp Group", whatsapp_group_url, class: "trip-resource-link trip-mobile-resource-link trip-whatsapp-mobile-link", target: "_blank", rel: "noopener"
    - if weather_url.present?
      = link_to "Weather", weather_url, class: "trip-resource-link trip-mobile-resource-link trip-weather-mobile-link", target: "_blank", rel: "noopener"
    - if photo_album_url.present?
      = link_to "Photo Album", photo_album_url, class: "trip-resource-link trip-mobile-resource-link trip-photo-album-mobile-link", target: "_blank", rel: "noopener"
  %span.trip-show-mobile-hero-caption IRS Wall, Joshua Tree
%main.public-main
  %section.panel.trip-overview.day-trip-overview.class-trip-overview
    .panel-header.trip-summary-header
      .trip-summary-copy
        .trip-title-line
          %h1= @trip.name
          %span.status.trip-type-badge= @trip.trip_type_label
        %h2= @trip.location
        %p= @trip.start_date.to_fs(:long)
        - if @trip.partner_company.present?
          %p
            Taught by
            - if partner_url.present?
              = link_to @trip.partner_company.name, partner_url, target: "_blank", rel: "noopener"
            - else
              = @trip.partner_company.name
      .trips-index-notices.trip-summary-notices
        .trip-resource-links
          - if whatsapp_group_url.present?
            = link_to "Join the WhatsApp Group", whatsapp_group_url, class: "trip-resource-link trip-whatsapp-link", target: "_blank", rel: "noopener"
          - if weather_url.present?
            = link_to "Weather", weather_url, class: "trip-resource-link trip-weather-link", target: "_blank", rel: "noopener"
          - if photo_album_url.present?
            = link_to "Photo Album", photo_album_url, class: "trip-resource-link trip-photo-album-link", target: "_blank", rel: "noopener"
    .stats
      %div
        %span Interested
        %strong= @trip.confirmed_signup_count
      %div
        %span Max Class Size
        %strong= @trip.total_participant_capacity

  - if @trip.description.present? || class_signup_url.present?
    %section.panel.day-trip-description-panel.class-trip-description-panel
      .class-description-body{class: ("has-registration-action" if class_signup_url.present?)}
        .class-description-copy
          %h2 Description
          - if @trip.description.present?
            .content-page-markdown
              = render_content_page_markdown(@trip.description)
        - if class_signup_url.present?
          .class-registration-card
            .day-trip-signup-action
              = link_to "Register with #{@trip.partner_company&.name || 'guiding company'}", class_signup_url, class: "button day-trip-signup-button", target: "_blank", rel: "noopener"
              %p.muted.class-registration-note You must register and pay on the guiding company's website to be officially signed up.

  %section.panel.day-trip-details-panel.class-trip-details-panel
    %h2 Cost Details
    %dl.details-list
      %div
        %dt= @trip.class_offers_discount? ? "Original price" : "Price"
        %dd= format_class_price(@trip.class_original_price)
      - if @trip.class_offers_discount? && @trip.class_discount_code.present?
        %div
          %dt Discount code
          %dd= @trip.class_discount_code
      - if @trip.class_offers_discount? && @trip.class_discount_amount.present?
        %div
          %dt Discount amount
          %dd= @trip.class_discount_amount
      - if @trip.class_offers_discount? && @trip.class_discounted_price.present?
        %div
          %dt Discounted price
          %dd= format_class_price(@trip.class_discounted_price)

  %section.panel.day-trip-participants-panel.class-trip-participants-panel
    %h2 Participants
    - if @class_signups.any?
      %table.confirmed-participants-table.public-card-table
        %thead
          %tr
            %th Participant
        %tbody
          - @class_signups.each do |signup|
            %tr
              %td{"data-label" => "Participant"}= signup.public_participant_name
    - else
      %p.muted No participants yet.
    .class-participant-signup-action
      - company_name = @trip.partner_company&.name || "the guiding company"
      - company_website_owner = company_name.end_with?("s") ? "#{company_name}'" : "#{company_name}'s"
      - if @trip.archived?
        %p.muted Archived class. New interest signups are closed.
      - elsif @current_class_signup.present?
        %p
          %strong You have indicated you signed up for this class.
        %div{"data-controller" => "modal"}
          %button.button.danger{"data-action" => "modal#open", type: "button"} Remove me
          %dialog.signup-modal{"data-action" => "click->modal#closeOnBackdrop", "data-modal-target" => "dialog"}
            .signup-modal-content
              %div
                %h2 Remove yourself?
              .form-actions
                %button.button.secondary{"data-action" => "modal#close", type: "button"} Cancel
                = button_to "Remove Me", trip_class_signup_path(@trip), method: :delete, class: "button danger"
      - elsif user_signed_in?
        - if @trip.capacity_full?
          %button.button.secondary{disabled: true, type: "button"} Class full
        - else
          = button_to "I've Signed Up", trip_class_signup_path(@trip), method: :post, class: "button day-trip-signup-button"
          %p.muted This indicates to other Cragmont participants you have signed up.
          %p.muted You must signup on #{company_website_owner} website to be enrolled. This does not automatically sync with their signups.
      - else
        = link_to "Log in to mark interest", new_session_path, class: "button secondary"
        %p.muted This indicates to other Cragmont participants you have signed up.
        %p.muted You must signup on #{company_website_owner} website to be enrolled. This does not automatically sync with their signups.

  %section.panel.day-trip-safety-panel.class-reminder-panel
    %h2= @class_reminder.title
    .content-page-markdown
      - class_reminder_body = @class_reminder.body.to_s.sub(/\A## Class Details[ \t]*\r?\n\r?\n?/, "")
      = render_content_page_markdown(class_reminder_body)
  = render "shared/liability_warning"
%p.background-image-caption IRS Wall, Joshua Tree
