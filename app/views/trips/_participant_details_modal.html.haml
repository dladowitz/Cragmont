- campsite = signup.campsite
- guest_signup = signup.guest?
- campsite_coordinator_signup = !guest_signup && trip.campsite_coordinator_id == signup.user_id
- added_by = signup.guest_of_signup&.user
- if guest_signup && added_by.present?
  - modal_title = "#{signup.user.full_name} you've been added to the #{trip.name} trip by #{added_by.full_name}"
- else
  - modal_title = "You've been added to the #{trip.name} trip."
%div{"data-controller" => "modal", "data-modal-open-value" => "true"}
  %dialog.signup-modal{"data-action" => "click->modal#closeOnBackdrop", "data-modal-target" => "dialog"}
    .signup-modal-content
      %div
        %h2= modal_title
        - unless guest_signup
          %p Please select dates you will be attending
        - if guest_signup
          %p Please review and sign the waiver.
        .participant-details-campsite-summary
          %strong
            = campsite.campground.name
            site #{campsite.site_number}
          %span
            - if guest_signup && signup.arrival_date.present? && signup.checkout_date.present?
              Attending #{signup.arrival_date.to_fs(:long)} to #{signup.checkout_date.to_fs(:long)}
            - else
              Available #{campsite.arrival_date.to_fs(:long)} to #{campsite.checkout_date.to_fs(:long)}
      = render "campsite_signup_form_fields",
        trip: trip,
        campsite: campsite,
        signup: signup,
        confirm_waitlist: false,
        waitlist_direct_signup: false,
        complete_existing_signup: true,
        waiver_only: guest_signup,
        hide_fee_fields: campsite_coordinator_signup,
        modal_submit_text: "Complete",
        payment_submit_text: (guest_signup || campsite_coordinator_signup ? "Complete" : "Pay Now and Complete"),
        free_submit_text: "Complete",
        signup_intent: "complete_participant_details",
        dom_id_suffix: "complete-#{signup.id}"
