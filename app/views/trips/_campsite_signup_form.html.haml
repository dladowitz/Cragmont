- confirm_waitlist = local_assigns.fetch(:confirm_waitlist, false)
- waitlist_direct_signup = local_assigns.fetch(:waitlist_direct_signup, false)
- waitlist_direct_signup_text = "Signup for campsite"
- default_signup_button_text = confirm_waitlist ? "Confirm your spot" : (waitlist_direct_signup ? waitlist_direct_signup_text : "Sign up for this campsite")
- signup_button_text = local_assigns.fetch(:signup_button_text, default_signup_button_text)
- default_modal_title = waitlist_direct_signup ? "Signup for campsite" : signup_button_text
- modal_title = local_assigns.fetch(:modal_title, default_modal_title)
- modal_submit_text = confirm_waitlist ? "Pay Now and Confirm" : "Pay Now and Sign Up"
- signup_intent = confirm_waitlist ? "confirm_waitlist" : (waitlist_direct_signup ? "waitlist_direct_signup" : "direct_signup")
- dom_id_suffix = local_assigns.fetch(:dom_id_suffix, campsite.id)
%div{class: ("waitlist-direct-signup-control" if waitlist_direct_signup), "data-controller" => "modal"}
  %button.button{"data-action" => "modal#open", :type => "button"}= signup_button_text
  %dialog.signup-modal{"data-action" => "click->modal#closeOnBackdrop", "data-modal-target" => "dialog"}
    .signup-modal-content
      %div
        .signup-modal-title-line
          %h2= modal_title
          - if waitlist_direct_signup
            %p.muted This will remove you from the waitlist
        %p
          = campsite.campground.name
          site #{campsite.site_number}
        %p
          = campsite.arrival_date.to_fs(:long)
          to #{campsite.checkout_date.to_fs(:long)}
      = render "campsite_signup_form_fields", trip: trip, campsite: campsite, confirm_waitlist: confirm_waitlist, waitlist_direct_signup: waitlist_direct_signup, modal_submit_text: modal_submit_text, signup_intent: signup_intent, dom_id_suffix: dom_id_suffix
