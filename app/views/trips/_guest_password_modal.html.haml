- campsite = signup.campsite
- password_path = local_assigns.fetch(:password_path) { guest_password_trip_campsite_campsite_signup_path(trip, campsite) }
%div{"data-controller" => "modal", "data-modal-open-value" => "true"}
  %dialog.signup-modal{"data-action" => "click->modal#closeOnBackdrop", "data-modal-target" => "dialog"}
    .signup-modal-content
      %div
        %h2 Set your password
        %p Choose a password before signing your waiver.
        .participant-details-campsite-summary
          %strong
            = campsite.campground.name
            site #{campsite.site_number}
          %span
            Available #{campsite.arrival_date.to_fs(:long)} to #{campsite.checkout_date.to_fs(:long)}
      = form_with url: password_path, method: :patch, class: "waiver-form" do |form|
        = hidden_field_tag :complete_signup, token
        .form-grid
          .field
            = required_label_tag "guest-password", "Password"
            = password_field_tag "user[password]", "", id: "guest-password", required: true, autocomplete: "new-password"
          .field
            = required_label_tag "guest-password-confirmation", "Password confirmation"
            = password_field_tag "user[password_confirmation]", "", id: "guest-password-confirmation", required: true, autocomplete: "new-password"
        .form-actions
          = form.submit "Continue", class: "button"
