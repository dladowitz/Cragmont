- content_for :body_class, "session-new-page"
= render "shared/public_header"
.public-mobile-hero.public-mobile-hero-session
  %h1.public-mobile-hero-title Log in
  %span.public-mobile-hero-caption Super Crack, Indian Creek
%main.public-main
  %section.panel.auth-panel
    %h1 Log in
    = form_with url: session_path, class: "admin-form" do |form|
      .field
        = required_label form, :email
        = form.email_field :email, required: true, autocomplete: "email"
      .field
        = required_label form, :password
        = form.password_field :password, required: true, autocomplete: "current-password"
      .form-actions
        = form.submit "Log in", class: "auth-primary-action"
        = link_to "Create account", new_registration_path, class: "button secondary"
        = link_to "Forgot password?", new_password_reset_path, class: "button secondary"
%p.background-image-caption Super Crack, Indian Creek
