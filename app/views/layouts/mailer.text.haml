- header = [ "Cragmont Climbing Club", "=======================", "" ].join("\n")
- liability_note = "Cragmont is not a teaching organization. It's a social base camp. We create shared spaces to connect with other climbers. We hope you'll exchange knowledge and learn from one another. However, Cragmont does not test or vet members. It's up to you to decide what knowledge is correct and what might lead to danger. If you are new to climbing, the best way to help with these decisions is to take classes from professional guides."
- footer = [ "", liability_note, "", "--", "See you at the crag.", "Cragmont Climbing Club" ].join("\n")
!= header
= yield
!= footer
