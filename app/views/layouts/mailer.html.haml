- background_image_url = "#{root_url.chomp("/")}#{asset_path("backgrounds/vent-five-emperor-boulder-shorter.jpg")}"
- dark_mode_background_image_url = "#{root_url.chomp("/")}#{asset_path("backgrounds/vent-five-emperor-boulder-shorter-dark-mode.jpg")}"
!!!
%html
  %head
    %meta{:content => "text/html; charset=utf-8", "http-equiv" => "Content-Type"}/
    %meta{name: "viewport", content: "width=device-width, initial-scale=1.0"}/
    %meta{name: "color-scheme", content: "only light"}/
    %meta{name: "supported-color-schemes", content: "light"}/
    :css
      html {
        color-scheme: only light;
        forced-color-adjust: none;
      }

      :root {
        color-scheme: only light;
        supported-color-schemes: light;
        forced-color-adjust: none;
      }

      body {
        margin: 0;
        padding: 0;
        background-color: #17231d;
        color: #21302a;
        color-scheme: only light;
        forced-color-adjust: none;
        font-family: Arial, Helvetica, sans-serif;
      }

      table {
        border-collapse: collapse;
      }

      .email-body p {
        margin: 0 0 18px;
        font-size: 16px;
        line-height: 1.65;
      }

      .email-body a {
        color: #1f6f55;
        font-weight: 700;
      }

      .email-body strong {
        color: #17231d;
      }

      .email-background,
      .email-card,
      .email-header,
      .email-footer {
        color-scheme: only light;
        forced-color-adjust: none;
      }

      @media (prefers-color-scheme: dark) {
        .email-background {
          background-image: linear-gradient(rgba(23, 35, 29, 0.16), rgba(23, 35, 29, 0.24)), url('#{dark_mode_background_image_url}') !important;
        }
      }

      @media only screen and (max-width: 640px) {
        .email-shell {
          width: 100% !important;
          margin-left: 0 !important;
        }

        .email-card {
          padding: 28px 22px !important;
        }

        .email-header,
        .email-footer {
          padding-left: 22px !important;
          padding-right: 22px !important;
        }
      }
  %body{style: "margin: 0; padding: 0; background-color: #17231d; color-scheme: only light; forced-color-adjust: none; font-family: Arial, Helvetica, sans-serif;"}
    %table{role: "presentation", width: "100%", cellpadding: "0", cellspacing: "0", style: "min-width: 100%; background-color: #17231d; color-scheme: only light; forced-color-adjust: none;"}
      %tr
        %td.email-background{align: "center", style: "background-color: #17231d; background-image: linear-gradient(rgba(23, 35, 29, 0.16), rgba(23, 35, 29, 0.24)), url('#{background_image_url}'); background-position: center bottom; background-size: cover; color-scheme: only light; forced-color-adjust: none; padding: 42px 16px 120px;"}
          %table.email-shell{role: "presentation", width: "620", cellpadding: "0", cellspacing: "0", style: "width: 620px; max-width: 100%; margin-left: 20%;"}
            %tr
              %td.email-header{style: "padding: 0 34px 22px; color: #f8f4ea; text-align: left;"}
                %p{style: "display: inline-grid; gap: 0; margin: 0; color: #fff; font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; line-height: 0.95; text-shadow: 0 2px 10px rgba(0, 0, 0, 0.42);"}
                  %span{style: "display: block; font-size: 40px; font-weight: 800;"}
                    Cragmont
                  %small{style: "display: block; color: #fff; font-size: 24px; font-weight: 800; letter-spacing: 0; text-transform: uppercase;"}
                    Climbing Club
            %tr
              %td.email-card.email-body{style: "background: rgba(255, 250, 240, 0.8); border: 1px solid rgba(255, 255, 255, 0.45); border-radius: 8px; box-shadow: 0 18px 44px rgba(0, 0, 0, 0.18); color: #21302a; padding: 38px 40px;"}
                = yield
            %tr
              %td.email-footer{style: "padding: 24px 34px 0; color: #f8f4ea; font-size: 13px; line-height: 1.6; text-align: left;"}
                %p{style: "margin: 0 0 8px; font-weight: 700;"}
                  See you at the crag.
          %table{role: "presentation", width: "100%", cellpadding: "0", cellspacing: "0", style: "width: 100%;"}
            %tr
              %td{align: "right", style: "padding: 76px 18px 0; color: rgba(255, 255, 255, 0.82); font-size: 13px; line-height: 1.4; text-align: right; text-shadow: 0 2px 12px rgba(0, 0, 0, 0.55);"}
                Marin Coast, Emperor Boulder
