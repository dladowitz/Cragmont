!!!
%html
  %head
    %meta{:content => "text/html; charset=UTF-8", "http-equiv" => "Content-Type"}/
    %title= content_for(:title) || "Cragmont Climbing"
    %meta{:content => "width=device-width,initial-scale=1", :name => "viewport"}/
    %meta{:content => "yes", :name => "apple-mobile-web-app-capable"}/
    %meta{:content => "Cragmont", :name => "application-name"}/
    %meta{:content => "yes", :name => "mobile-web-app-capable"}/
    = csrf_meta_tags
    = csp_meta_tag
    = yield :head
    - google_analytics_id = google_analytics_measurement_id
    - if google_analytics_id.present?
      %script{ async: true, src: "https://www.googletagmanager.com/gtag/js?id=#{u(google_analytics_id)}" }
      :javascript
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag("js", new Date());
        gtag("config", #{google_analytics_id.to_json});
    %link{:href => "/icon.svg?v=4", :rel => "icon", :type => "image/svg+xml"}/
    %link{:href => "/icon.png?v=4", :rel => "alternate icon", :type => "image/png"}/
    %link{:href => "/icon.png?v=4", :rel => "apple-touch-icon"}/
    = stylesheet_link_tag :app, "data-turbo-track": "reload"
    = javascript_importmap_tags
  - environment_name = visible_environment_name
  - body_classes = []
  - body_classes << "admin-body" if controller_path.start_with?("admin/")
  - body_classes << content_for(:body_class).to_s if content_for?(:body_class)
  - body_classes << "has-environment-indicator" if environment_name.present?
  - body_class = body_classes.join(" ").presence
  %body{ class: body_class }
    - if notice.present? || alert.present?
      .flash-messages
        - if notice.present?
          %p.flash.notice= notice
        - if alert.present?
          %p.flash.alert= alert
    = yield
    - if environment_name.present?
      %footer.environment-indicator{"aria-label" => "Environment indicator"}
        %span= "Env: #{environment_name}"
        - if show_letter_opener_link?
          = link_to letter_opener_label, letter_opener_path
