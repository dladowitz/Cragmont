%body
  %header.public-header
    .public-brand
      = link_to root_path, class: "site-name" do
        %span Cragmont
        %small Climbing Club
      - if current_user&.admin_access?
        = link_to "Admin", admin_root_path, class: "public-admin-link"
    %nav.public-nav
      - if user_signed_in?
        = link_to current_user.full_name, profile_path
        = link_to "Trips", trips_path
        = button_to "Log out", session_path, method: :delete, class: "nav-button"
      - else
        = link_to "Trips", trips_path
        = link_to "Log in", new_session_path
        = link_to "Register", new_registration_path
