= render "admin/shared/header", title: @partner_company.name
%section.panel
  .panel-header
    %div
      %h2= @partner_company.name
      - website_url = safe_external_url(@partner_company.website_url)
      - if website_url.present?
        %p= link_to @partner_company.website_url, website_url, target: "_blank", rel: "noopener"
      - else
        %p= @partner_company.website_url
    .actions
      = link_to "Edit Company", edit_admin_partner_company_path(@partner_company), class: "button secondary"
      = button_to "Delete Company", admin_partner_company_path(@partner_company), method: :delete, class: "button danger"
  %dl.details-list
    %div
      %dt Partner Name
      %dd= @partner_company.name
    %div
      %dt Website link
      %dd
        - if website_url.present?
          = link_to @partner_company.website_url, website_url, target: "_blank", rel: "noopener"
        - else
          = @partner_company.website_url
    %div
      %dt Primary Contact
      %dd= [@partner_company.primary_contact_name, @partner_company.primary_contact_phone, @partner_company.primary_contact_email].reject(&:blank?).join(", ")
    %div
      %dt Secondary Contact
      %dd= [@partner_company.secondary_contact_name, @partner_company.secondary_contact_phone, @partner_company.secondary_contact_email].reject(&:blank?).presence&.join(", ") || "None"
    %div
      %dt Description
      %dd= simple_format(@partner_company.description.presence || "None")
