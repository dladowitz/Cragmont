= render "admin/shared/header", title: "Help"
= ui_panel do
  .panel-header
    %div
      %h2 Help requests
      %p.muted Review issues, questions, and trip help requests from participants.
    - if current_user.super_admin?
      = ui_link "Update Who Gets Notified on Requests", admin_help_notification_subscribers_path, variant: :secondary
  %details.trip-filter-disclosure
    %summary
      %strong Filters:
      %span= @selected_statuses.map(&:titleize).join(", ")
    = form_with url: admin_help_requests_path, method: :get, class: "help-request-filter-form trip-filter-form" do
      %fieldset.help-request-status-filters.trip-status-filters
        %legend View requests (select all that apply)
        - HelpRequest::STATUSES.each do |status|
          %label.help-status-filter.trip-status-filter
            = check_box_tag "status[]", status, @selected_statuses.include?(status), id: "status_#{status}"
            %span= status.titleize
      = ui_submit_tag "Apply", variant: :secondary
  - if @help_requests.any?
    .table-wrapper
      %table.admin-record-table{role: "table", "aria-label" => "Help requests"}
        %thead
          %tr
            %th{scope: "col"} View
            %th{scope: "col"} Subject
            %th{scope: "col"} Reason
            %th{scope: "col"} From
            %th{scope: "col"} Status
            %th{scope: "col"} Received
        %tbody{role: "rowgroup"}
          - @help_requests.each do |help_request|
            %tr{role: "row"}
              = ui_actions(tag: :td, kind: :table, role: "cell") do
                = ui_link "View", admin_help_request_path(help_request), variant: :secondary, class: "admin-table-action-button"
              %td.admin-record-title{role: "cell"}= help_request.subject
              %td{role: "cell", "data-label" => "Reason"}= help_request.reason_label
              %td{role: "cell", "data-label" => "From"}
                %div
                  = help_request.name
                  %br/
                  = mail_to help_request.email
              %td{role: "cell", "data-label" => "Status"}
                = help_request_status_pill(help_request)
              %td{role: "cell", "data-label" => "Received"}= help_request.created_at.to_fs(:long)
    - if @total_pages > 1
      %nav.pagination{aria: {label: "Help request pages"}}
        - pagination_params = { status: @selected_statuses }
        - if @current_page > 1
          = ui_link "Previous", admin_help_requests_path(pagination_params.merge(page: @current_page - 1)), variant: :secondary
        %span.pagination-summary Page #{@current_page} of #{@total_pages}
        - if @current_page < @total_pages
          = ui_link "Next", admin_help_requests_path(pagination_params.merge(page: @current_page + 1)), variant: :secondary
  - else
    %p.muted No help requests yet. A quiet wall is a happy wall.
