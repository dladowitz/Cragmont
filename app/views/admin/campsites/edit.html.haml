= render "admin/shared/header", title: "Edit campsite"
= ui_panel(class: "campsite-form-panel") do
  .panel-header
    %div
      %p.eyebrow Edit campsite
      .trip-title-line
        %h2= @trip.name
        %p= @trip.location
  = render "form", trip: @trip, campsite: @campsite, campgrounds: @campgrounds
