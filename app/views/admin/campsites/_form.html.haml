= form_with model: [:admin, trip, campsite], class: "admin-form" do |form|
  - registered_by_field_id = "campsite_registered_by_id"
  - registered_by_options = [{ label: "Unassigned", value: "", search_text: "unassigned" }] + @users.map { |user| { label: user.full_name, value: user.id, search_text: [user.full_name, user.email].compact.join(" ").downcase } }
  - selected_registered_by_value = campsite.registered_by_id.to_s
  - selected_registered_by_label = campsite.registered_by&.full_name || "Unassigned"
  = render "admin/shared/errors", record: campsite
  - if campgrounds.any?
    .campsite-form-sections
      .campsite-form-section
        .form-grid
          .field
            = required_label form, :campground_id, "Campground"
            = form.collection_select :campground_id, campgrounds, :id, :name, { prompt: "Select a campground" }, required: true
          .field
            = required_label form, :site_number
            = form.text_field :site_number, required: true
      .campsite-form-section
        .form-grid
          .field
            = required_label form, :arrival_date
            = form.date_field :arrival_date, min: trip.start_date, max: trip.end_date, required: true, data: { controller: "date-picker", action: "click->date-picker#show focus->date-picker#show" }
          .field
            = required_label form, :checkout_date
            = form.date_field :checkout_date, min: trip.start_date, max: trip.end_date, required: true, data: { controller: "date-picker", action: "click->date-picker#show focus->date-picker#show" }
          .field
            = required_label form, :participant_capacity
            = form.number_field :participant_capacity, min: 0, max: 50, required: true
          .field
            = required_label form, :car_capacity
            = form.number_field :car_capacity, min: 0, required: true
      .campsite-form-section
        .form-grid
          .field
            = form.label :registered_by_id, "Registered by"
            .participant-picker.registered-by-picker{"data-controller" => "participant-picker", "data-participant-picker-placeholder-value" => "Unassigned", "data-action" => "keydown->participant-picker#keydown"}
              = form.hidden_field :registered_by_id, value: selected_registered_by_value, id: registered_by_field_id, data: { participant_picker_target: "input" }
              %button.participant-picker-button{type: "button", role: "combobox", aria: { expanded: "false", controls: "#{registered_by_field_id}-list", haspopup: "listbox" }, data: { participant_picker_target: "button", action: "participant-picker#toggle" }}
                %span{"data-participant-picker-target" => "label"}= selected_registered_by_label
                %span.participant-picker-chevron{"aria-hidden" => "true"}
              .participant-picker-panel{hidden: true, data: { participant_picker_target: "panel" }}
                = search_field_tag nil, "", class: "participant-picker-search", placeholder: "Search participants", autocomplete: "off", data: { participant_picker_target: "search", action: "input->participant-picker#filter" }
                %ul.participant-picker-list{id: "#{registered_by_field_id}-list", role: "listbox"}
                  - registered_by_options.each do |option|
                    - selected_option = option[:value].to_s == selected_registered_by_value
                    %li
                      %button.participant-picker-option{type: "button", role: "option", aria: { selected: selected_option.to_s }, data: { participant_picker_target: "option", action: "participant-picker#choose", value: option[:value], label: option[:label], search_text: option[:search_text] }}
                        %span= option[:label]
                  %li.participant-picker-empty{hidden: true, data: { participant_picker_target: "empty" }} No participants found.
          .field
            = form.label :registration_fee, "Registration cost"
            .currency-field
              %span $
              = form.number_field :registration_fee, min: 0, step: 0.01, value: number_with_precision(campsite.registration_fee, precision: 2)
          .field
            = form.label :registration_number
            = form.text_field :registration_number
      .campsite-form-section
        .field
          = form.label :notes
          = form.text_area :notes, rows: 5
    .form-actions
      = form.submit
      = link_to "Cancel", admin_trip_path(trip), class: "button secondary"
      - if campsite.persisted?
        - delete_blocked_message = "Cannot delete campsite with participants signed up. Remove them or move to the waitlist first"
        .danger-form-action
          - if campsite.delete_blocked_by_participants?
            %span.disabled-tooltip{aria: { label: delete_blocked_message }, tabindex: "0", title: delete_blocked_message}
              %button.button.danger.secondary{disabled: true, type: "button"} Delete campsite
          - else
            %div{"data-controller" => "modal"}
              %button.button.danger.secondary{"data-action" => "modal#open", type: "button"} Delete campsite
              %dialog.confirmation-modal{"data-action" => "click->modal#closeOnBackdrop", "data-modal-target" => "dialog"}
                .confirmation-modal-content
                  %div
                    %h2 Delete campsite?
                  .form-actions
                    %button.button.secondary{"data-action" => "modal#close", type: "button"} Cancel
                    %button.button.danger{form: "delete-campsite-#{campsite.id}", type: "submit"} Delete campsite
  - else
    .empty-state
      %p Create a campground before adding campsites to this trip.
      = link_to "Add campground", new_admin_campground_path, class: "button"

- if campsite.persisted?
  = form_with url: admin_trip_campsite_path(trip, campsite), method: :delete, html: { id: "delete-campsite-#{campsite.id}", class: "hidden-delete-form" } do
    = hidden_field_tag :confirm_delete, "1"
