= render "admin/shared/header", title: "Content"

= ui_panel do
  .panel-header
    %div
      %h2 Content for FAQs, Safety, Liability and Emails
      %p.muted Pick the content you want to update.

  .content-action-list
    - if current_user.super_admin?
      = ui_link "Edit What to Expect on a Camping Trip", edit_admin_content_page_path("what_to_expect"), variant: :secondary
      = ui_link "Edit What to Expect on a Day Trip", edit_admin_content_page_path("day_trip_what_to_expect"), variant: :secondary
      = ui_link "Edit How to Think About Safety page", edit_admin_content_page_path("how_to_think_about_safety"), variant: :secondary
      = ui_link "Edit Trip Details Email Templates", admin_trip_details_email_templates_path, variant: :secondary
      = ui_link "Edit Liability Warning", edit_admin_site_content_path("liability_warning"), variant: :secondary
      = ui_link "Edit Day Trip Safety Reminder", edit_admin_site_content_path("day_trip_safety_reminder"), variant: :secondary
    = ui_link "Edit Class Reminder", edit_admin_content_page_path("class_reminder"), variant: :secondary
