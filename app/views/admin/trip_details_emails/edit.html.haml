= render "admin/shared/header", title: "#{@trip.name} trip details email"

%section.panel.trip-details-email-panel
  .panel-header
    %div
      %h2 Edit Trip Details Email
      %p.muted This draft uses Markdown and trip placeholders. Preview before sending.
    .actions
      = link_to "Back to trip", admin_trip_path(@trip), class: "button secondary"
      = button_to "Start over from template",
        reset_from_template_admin_trip_trip_details_email_path(@trip),
        method: :patch,
        class: "button danger secondary",
        form: { data: { turbo_confirm: "Throw away this draft and start over from the #{@trip_details_email.trip_details_email_template.name} template?" } }
      = button_tag "Preview",
        type: "submit",
        class: "button secondary",
        form: "trip-details-email-form",
        formaction: preview_admin_trip_trip_details_email_path(@trip)

  = form_with model: @trip_details_email,
    url: admin_trip_trip_details_email_path(@trip),
    method: :patch,
    class: "admin-form trip-details-email-form",
    id: "trip-details-email-form",
    data: { controller: "markdown-preview", markdown_preview_url_value: markdown_preview_admin_trip_trip_details_email_path(@trip) } do |form|
    = render "admin/shared/errors", record: @trip_details_email
    .form-grid
      .form-grid-full
        = required_label form, :subject
        = form.text_field :subject, required: true
      .form-grid-full
        = required_label form, :body_markdown, "Body"
        .content-page-editor.trip-details-email-editor
          .content-page-editor-field
            = form.text_area :body_markdown,
              rows: 28,
              required: true,
              data: { markdown_preview_target: "source", action: "input->markdown-preview#queuePreview" }
            %aside.markdown-formatting-guide{"aria-label" => "Trip details email formatting reference"}
              .markdown-formatting-heading
                %h3 Markdown quick reference
              %ul
                %li
                  %code ## Heading
                  %span creates a section heading
                %li
                  %code **bold text**
                  %span creates bold text
                %li
                  %code - List item
                  %span creates a bulleted list
                %li
                  %code [Link text](https://example.com)
                  %span creates a link
                %li
                  %code {{trip_dates}}
                  %span inserts trip data
          .content-page-preview-panel.trip-details-email-preview-panel
            .content-page-preview-header
              %h3 Preview
              %p.muted Subject: #{@rendered_subject}
            .content-page-markdown.trip-details-email-markdown{data: { markdown_preview_target: "preview" }}
              != @rendered_html
    - if @blocking_issues.any?
      .trip-details-email-blockers
        %h3 Send blockers
        %ul
          - @blocking_issues.each do |issue|
            %li= issue
    .form-actions
      = form.submit "Save draft", class: "button secondary"
      = button_tag "Preview and confirm",
        type: "submit",
        class: "button",
        formaction: preview_admin_trip_trip_details_email_path(@trip)
