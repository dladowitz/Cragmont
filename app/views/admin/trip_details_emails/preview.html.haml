= render "admin/shared/header", title: "#{@trip.name} trip details email preview"

= ui_panel(class: "trip-details-email-panel") do
  .panel-header
    %div
      %h2 Preview Trip Details Email
      %p.muted Review the final email and confirmed recipients before sending.
    = ui_actions do
      = ui_link "Edit draft", edit_admin_trip_trip_details_email_path(@trip), variant: :secondary
      = ui_link "Back to trip", admin_trip_path(@trip), variant: :secondary
      - if @blocking_issues.empty?
        = ui_button_to "Send trip details email", deliver_admin_trip_trip_details_email_path(@trip), method: :post, variant: :primary

  - if @blocking_issues.any?
    .trip-details-email-blockers
      %h3 Send blockers
      %ul
        - @blocking_issues.each do |issue|
          %li= issue
  - else
    .trip-details-email-ready
      %strong On belay.
      %span This email is ready to send to confirmed participants.

  .trip-details-email-preview-layout
    %section.trip-details-email-rendered
      %h3 Subject
      %p.trip-details-email-subject-preview= @rendered_subject
      %h3 Email Body
      .content-page-markdown.trip-details-email-markdown
        != @rendered_html
    %aside.trip-details-email-recipient-panel
      %h3 Recipients
      %p.muted= pluralize(@recipients.size, "confirmed participant")
      - if @recipients.any?
        %table.trip-details-email-recipient-table
          %thead
            %tr
              %th Participant
          %tbody
            - @recipients.each do |recipient|
              %tr
                %td.trip-details-email-recipient-contact
                  %span.trip-details-email-recipient-name= recipient.recipient_name
                  - if recipient.email.present?
                    = mail_to recipient.email, recipient.email, class: "trip-details-email-recipient-email"
                  - else
                    %span.trip-details-email-recipient-email.is-missing Missing email
      - else
        %p.muted No confirmed participants yet.

  = ui_actions(kind: :form) do
    = ui_link "Keep editing", edit_admin_trip_trip_details_email_path(@trip), variant: :secondary
    - if @blocking_issues.empty?
      = ui_button_to "Send trip details email", deliver_admin_trip_trip_details_email_path(@trip), method: :post, variant: :primary
    - else
      = ui_button("Send trip details email", variant: :primary, type: "button", disabled: true)
