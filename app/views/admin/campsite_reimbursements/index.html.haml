= render "admin/shared/header", title: "Campsite Reimbursements"

%section.panel.campsite-reimbursements-panel
  .panel-header
    %div
      %h2 Campsite Reimbursements
    = link_to "Back to Finances", admin_finances_path, class: "button secondary"

  = form_with url: admin_campsite_reimbursements_path, method: :get, class: "campsite-reimbursement-filter-form", data: { turbo: false } do
    = hidden_field_tag :filters, "1"
    .form-field
      = label_tag :reimbursement_status, "View campsites"
      - filter_options = [["Unreimbursed", "unreimbursed"], ["Reimbursed", "reimbursed"], ["All campsites", "all"]]
      - selected_filter = @selected_reimbursement_filters.include?("all") ? "all" : @selected_reimbursement_filters.sort.join(",")
      - filter_options << ["Unreimbursed or reimbursed", selected_filter] if selected_filter.include?(",")
      = select_tag "reimbursement_status[]", options_for_select(filter_options, selected_filter), id: "reimbursement_status"
    .campsite-reimbursement-filter-actions
      = submit_tag "Apply", class: "button"
      = button_tag "Download CSV Report", type: "submit", name: "format", value: "csv", class: "button secondary"

  - if @campsites_by_trip.any?
    .campsite-reimbursement-groups
      - @campsites_by_trip.each do |trip, campsites|
        %section.campsite-reimbursement-trip{id: "campsite-reimbursement-trip-#{trip.id}"}
          .campsite-reimbursement-trip-heading
            %div
              %h3= trip.name
              %p.muted= "#{trip.start_date.to_fs(:long)}–#{trip.end_date.to_fs(:long)} · #{trip.status.titleize}"
            - if policy(trip).show?
              = link_to "View Trip", admin_trip_path(trip), class: "button secondary admin-table-action-button"
          .table-wrapper
            %table.campsite-reimbursement-table.admin-record-table{role: "table", "aria-label" => "#{trip.name} campsite reimbursements"}
              %thead
                %tr
                  %th{scope: "col"} Campground
                  %th{scope: "col"} Site Number
                  %th{scope: "col"} Registered by
                  %th{scope: "col"} Fees paid
                  %th{scope: "col"} Reimbursed
                  %th{scope: "col"} Reimbursed On
              %tbody{role: "rowgroup"}
                - campsites.each do |campsite|
                  %tr{id: "campsite-reimbursement-#{campsite.id}", role: "row"}
                    %td.admin-record-title{role: "cell"}= campsite.campground.name
                    %td.admin-record-site{role: "cell", "data-label" => "Site"}= campsite.site_number
                    %td{role: "cell", "data-label" => "Registered by"}= campsite.registered_by&.full_name || "None"
                    %td{role: "cell", "data-label" => "Fees paid"}= format_cents(campsite.registration_fee_cents)
                    %td{role: "cell", "data-label" => "Reimbursed"}
                      - if campsite.registration_reimbursed?
                        Yes
                      - else
                        .campsite-reimbursement-status
                          %span No
                          - if policy(trip).manage_payments?
                            = render "admin/shared/campsite_reimbursement_form", trip: trip, campsite: campsite, users: @users, trigger_label: "Record Reimbursement", return_to: "campsite_reimbursements", reimbursement_filters: @selected_reimbursement_filters
                    %td{role: "cell", "data-label" => "Reimbursed on"}= campsite.registration_reimbursed_at&.strftime("%b %-d, %Y") || "—"
  - else
    .empty-state
      - if @selected_reimbursement_filters == [ "unreimbursed" ]
        %p On belay! Every campsite registration fee has been reimbursed.
      - else
        %p No campsites match the selected reimbursement filters.
