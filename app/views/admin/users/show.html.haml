= render "admin/shared/header", title: @user.full_name
%section.panel
  .panel-header.user-detail-header
    %div
      %h2= @user.full_name
      %dl.details-list
        %div
          %dt Email
          %dd= @user.email.presence || "None"
        %div
          %dt Phone
          %dd= @user.phone.presence || "None"
        %div
          %dt Club member
          %dd= @user.member? ? "Yes" : "No"
        %div
          %dt Default Password
          %dd= @user.default_password? ? "Yes" : "No"
        %div
          %dt Roles
          %dd= @user.roles.order(:name).map(&:name).to_sentence.presence || "None"
    .actions
      = link_to "Edit user", edit_admin_user_path(@user), class: "button secondary"
      = button_to "Delete user",                                                        |
        admin_user_path(@user),                                                         |
        method: :delete,                                                                |
        class: "button danger",                                                         |
        form: { data: { turbo_confirm: "Are you sure you want to delete this user?" } } |
%section.panel
  .panel-header
    %div
      %h2 Waivers
    .actions
      = render "waiver_request_modal", user: @user
  - if @waivers.any?
    %table
      %thead
        %tr
          %th Signed
          %th Year
          %th Type
          %th Trip
          %th Minors
          %th Waiver
      %tbody
        - @waivers.each do |waiver|
          %tr
            %td= waiver.waiver_signed_at.to_fs(:long)
            %td= waiver.waiver_year
            %td= waiver.display_type
            %td= waiver.trip&.name || "Standalone"
            %td= waiver.minors_summary
            %td= render "shared/waiver_modal", waiver: waiver, button_label: "View", modal_id: "admin-user-waiver-#{waiver.id}"
  - else
    %p.muted No waivers signed yet.
%section.panel
  %h2 Trips and Transactions
  = render "shared/user_trip_history",
    rows: @trip_history_rows,
    empty_message: "No trip signups yet.",
    admin_view: true
%section.panel
  %h2 Coordinated trips
  - if @coordinated_trips.any?
    = render "admin/trips/table", trips: @coordinated_trips
  - else
    %p.muted This user is not assigned as a campsite coordinator yet.
