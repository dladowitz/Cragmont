= render "admin/shared/header", title: @user.full_name
= ui_panel do
  .panel-header.user-detail-header
    %div
      %h2= @user.full_name
      %dl.details-list
        %div
          %dt Email
          %dd= @user.email.presence || "None"
        %div
          %dt Phone
          %dd= @user.phone.presence || "None"
        %div
          %dt Club member
          %dd= @user.member? ? "Yes" : "No"
        %div
          %dt Default Password
          %dd= @user.default_password? ? "Yes" : "No"
        %div
          %dt Roles
          %dd= @user.roles.order(:name).map(&:name).to_sentence.presence || "None"
    = ui_actions do
      - if policy(@user).update?
        = ui_link "Edit user", edit_admin_user_path(@user), variant: :secondary
      - if policy(@user).destroy?
        = ui_button_to "Delete user", admin_user_path(@user), method: :delete, variant: :danger, form: { data: { turbo_confirm: "Are you sure you want to delete this user?" } }
= ui_panel do
  .panel-header
    %div
      %h2 Waivers
    = ui_actions do
      = render "waiver_request_modal", user: @user
  - if @waivers.any?
    %table.admin-record-table.admin-user-waivers-table{role: "table", "aria-label" => "Waivers"}
      %thead
        %tr
          %th Signed
          %th Year
          %th Type
          %th Trip
          %th Minors
          %th Waiver
      %tbody
        - @waivers.each do |waiver|
          %tr
            %td.admin-record-title{role: "cell"}= waiver.waiver_signed_at.to_fs(:long)
            %td{role: "cell", "data-label" => "Year"}= waiver.waiver_year
            %td{role: "cell", "data-label" => "Type"}= waiver.display_type
            %td{role: "cell", "data-label" => "Trip"}= waiver.trip&.name || "Standalone"
            %td{role: "cell", "data-label" => "Minors"}= waiver.minors_summary
            = ui_actions(tag: :td, kind: :table, role: "cell") do
              = render "shared/waiver_modal", waiver: waiver, button_label: "View", modal_id: "admin-user-waiver-#{waiver.id}"
  - else
    %p.muted No waivers signed yet.
= ui_panel do
  %h2 Trips and Transactions
  = render "shared/user_trip_history",
    rows: @trip_history_rows,
    empty_message: "No trip signups yet.",
    admin_view: true
= ui_panel do
  %h2 Coordinated trips
  - if @coordinated_trips.any?
    = render "admin/trips/table", trips: @coordinated_trips
  - else
    %p.muted This user is not assigned as a campsite coordinator yet.
