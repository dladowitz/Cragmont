<%= render "admin/shared/header", title: "Users" %>

<section class="panel">
  <div class="panel-header">
    <div>
      <h2>User directory</h2>
    </div>
    <%= link_to "New user", new_admin_user_path, class: "button" %>
  </div>

  <% if @users.any? %>
    <table>
      <thead>
        <tr>
          <th>Name</th>
          <th>Email</th>
          <th>Phone</th>
          <th>Member</th>
        </tr>
      </thead>
      <tbody>
        <% @users.each do |user| %>
          <tr>
            <td><%= link_to user.full_name, admin_user_path(user) %></td>
            <td><%= user.email.presence || tag.span("None") %></td>
            <td><%= user.phone.presence || tag.span("None") %></td>
            <td><%= user.member? ? "Yes" : "No" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <div class="empty-state">
      <p>No users have been added yet.</p>
      <%= link_to "New user", new_admin_user_path, class: "button" %>
    </div>
  <% end %>
</section>
