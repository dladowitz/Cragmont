<%= render "admin/shared/header", title: @campground.name %>

<section class="panel">
  <div class="panel-header">
    <div>
      <h2><%= @campground.location %></h2>
      <% if (website_url = campground_website_url(@campground)) %>
        <p><%= link_to website_url, website_url, rel: "noopener", target: "_blank" %></p>
      <% end %>
    </div>
    <div class="actions">
      <%= link_to "Edit campground", edit_admin_campground_path(@campground), class: "button secondary" %>
      <%= button_to "Delete campground", admin_campground_path(@campground), method: :delete, class: "button danger" %>
    </div>
  </div>

  <% if @campground.notes.present? %>
    <div class="description"><%= simple_format(@campground.notes) %></div>
  <% end %>
</section>

<section class="panel">
  <h2>Assigned campsites</h2>

  <% if @campsites.any? %>
    <table>
      <thead>
        <tr>
          <th>Trip</th>
          <th>Site</th>
          <th>Dates</th>
          <th>Participants</th>
          <th>Cars</th>
        </tr>
      </thead>
      <tbody>
        <% @campsites.each do |campsite| %>
          <tr>
            <td><%= link_to campsite.trip.name, admin_trip_path(campsite.trip) %></td>
            <td><%= campsite.site_number %></td>
            <td><%= campsite.arrival_date.to_fs(:long) %> to <%= campsite.checkout_date.to_fs(:long) %></td>
            <td><%= campsite.participant_capacity %></td>
            <td><%= campsite.car_capacity %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="muted">No campsites use this campground yet.</p>
  <% end %>
</section>
