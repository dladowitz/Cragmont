<%= render "admin/shared/header", title: "Campgrounds" %>

<section class="panel">
  <div class="panel-header">
    <div>
      <h2>Campground directory</h2>
      <p>Manage the places used by trip campsite reservations.</p>
    </div>
    <%= link_to "New campground", new_admin_campground_path, class: "button" %>
  </div>

  <% if @campgrounds.any? %>
    <table>
      <thead>
        <tr>
          <th>Name</th>
          <th>Location</th>
          <th>Website</th>
        </tr>
      </thead>
      <tbody>
        <% @campgrounds.each do |campground| %>
          <tr>
            <td><%= link_to campground.name, admin_campground_path(campground) %></td>
            <td><%= campground.location %></td>
            <td>
              <% if campground.website.present? %>
                <%= link_to "Website", campground.website %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <div class="empty-state">
      <p>No campgrounds have been added yet.</p>
      <%= link_to "New campground", new_admin_campground_path, class: "button" %>
    </div>
  <% end %>
</section>
