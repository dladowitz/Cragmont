<%= form_with model: [:admin, campground], class: "admin-form" do |form| %>
  <%= render "admin/shared/errors", record: campground %>

  <div class="form-grid">
    <div class="field">
      <%= form.label :name %>
      <%= form.text_field :name, required: true %>
    </div>

    <div class="field">
      <%= form.label :location %>
      <%= form.text_field :location, required: true %>
    </div>
  </div>

  <div class="field">
    <%= form.label :website %>
    <%= form.url_field :website %>
  </div>

  <div class="field">
    <%= form.label :notes %>
    <%= form.text_area :notes, rows: 5 %>
  </div>

  <div class="form-actions">
    <%= form.submit %>
    <%= link_to "Cancel", campground.persisted? ? admin_campground_path(campground) : admin_campgrounds_path, class: "button secondary" %>
  </div>
<% end %>
