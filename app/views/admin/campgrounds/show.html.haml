= render "admin/shared/header", title: @campground.name
%section.panel
  .panel-header
    %div
      %h2= @campground.location
      - if (website_url = campground_website_url(@campground))
        %p= link_to website_url, website_url, rel: "noopener", target: "_blank"
    .actions
      = link_to "Edit campground", edit_admin_campground_path(@campground), class: "button secondary"
      = button_to "Delete campground", admin_campground_path(@campground), method: :delete, class: "button danger"
  - if @campground.notes.present?
    .description= simple_format(@campground.notes)
%section.panel
  %h2 Assigned campsites
  - if @campsites.any?
    %table
      %thead
        %tr
          %th Trip
          %th Site
          %th Dates
          %th Participants
          %th Cars
      %tbody
        - @campsites.each do |campsite|
          %tr
            %td= link_to campsite.trip.name, admin_trip_path(campsite.trip)
            %td= campsite.site_number
            %td
              = campsite.arrival_date.to_fs(:long)
              to #{campsite.checkout_date.to_fs(:long)}
            %td= campsite.participant_capacity
            %td= campsite.car_capacity
  - else
    %p.muted No campsites use this campground yet.
