= render "admin/shared/header", title: @campground.name
%section.panel
  .panel-header
    %div
      %h2= @campground.name
      %p= @campground.location
      - if (website_url = campground_website_url(@campground))
        %p.campground-website= link_to website_url, website_url, rel: "noopener", target: "_blank"
    .actions
      = link_to "Edit campground", edit_admin_campground_path(@campground), class: "button secondary"
      = button_to "Delete campground", admin_campground_path(@campground), method: :delete, class: "button danger"
  - if @campground.notes.present?
    .description= simple_format(@campground.notes)
%section.panel
  %h2 Assigned campsites
  - if @campsites.any?
    %table.admin-record-table{role: "table", "aria-label" => "Assigned campsites"}
      %thead
        %tr
          %th{scope: "col"} Trip
          %th{scope: "col"} Site
          %th{scope: "col"} Dates
          %th{scope: "col"} Participants
          %th{scope: "col"} Cars
      %tbody{role: "rowgroup"}
        - @campsites.each do |campsite|
          %tr{role: "row"}
            %td.admin-record-title{role: "cell"}= link_to campsite.trip.name, admin_trip_path(campsite.trip)
            %td{role: "cell", "data-label" => "Site"}= campsite.site_number
            %td{role: "cell", "data-label" => "Dates"}
              = campsite.arrival_date.to_fs(:long)
              to #{campsite.checkout_date.to_fs(:long)}
            %td{role: "cell", "data-label" => "Participants"}= campsite.participant_capacity
            %td{role: "cell", "data-label" => "Cars"}= campsite.car_capacity
  - else
    %p.muted No campsites use this campground yet.
