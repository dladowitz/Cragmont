%header.admin-header
  .admin-brand
    = link_to root_path, class: "site-name" do
      %span Cragmont
      %small Climbing Club
    = link_to "Public View", root_path, class: "admin-public-link"
  %p.admin-mode-label Admin Dashboard
  %h1.visually-hidden= title
  .admin-nav-shell{data: {controller: "navigation", action: "click@window->navigation#closeOutside keydown.esc@window->navigation#closeOnEscape"}}
    %input#admin-nav-toggle.admin-nav-checkbox{type: "checkbox", aria: {label: "Toggle admin navigation menu"}, data: {navigation_target: "toggle"}}
    %label.admin-nav-toggle{for: "admin-nav-toggle"} Menu
    %nav.admin-nav{"aria-label" => "Admin navigation"}
      = link_to "Trips", admin_trips_path
      - if policy(TripReport).index?
        = link_to "Trip Reports", admin_trip_reports_path
      = link_to "Finances", admin_finances_path
      = link_to "Help", admin_help_requests_path
      - if policy(ContentPage).index?
        = link_to "Content", admin_content_path
      - if policy(PartnerCompany).index?
        = link_to "Partners", admin_partner_companies_path
      - if policy(Campground).index?
        = link_to "Campgrounds", admin_campgrounds_path
      - if policy(User).index?
        = link_to "Users", admin_users_path
      - if policy(SiteSetting.current).show?
        = link_to "Settings", admin_settings_path
      = button_to "Logout", session_path, method: :delete, class: "button secondary"
