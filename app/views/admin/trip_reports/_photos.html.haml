- Array(report.draft["photos"]).each_with_index do |photo, index|
  .report-edit-photo{data: {photo_id: photo["id"]}}
    = image_tag photo_admin_trip_report_path(report, photo_id: photo["id"]), alt: photo["caption"].presence || "Report photo #{index + 1}", width: 160, height: 110
    %div
      = label_tag "caption-#{photo['id']}", "Caption / image description"
      = text_field_tag nil, photo["caption"], id: "caption-#{photo['id']}", maxlength: 500, data: {caption: true, action: "input->report-editor#changed"}
      .actions
        %button.button.secondary{type: "button", data: {action: "report-editor#cover"}, aria: {label: "Make photo #{index + 1} the cover"}}= index.zero? ? "Cover photo" : "Make cover"
        %button.button.secondary{type: "button", data: {action: "report-editor#up"}, aria: {label: "Move photo #{index + 1} earlier"}} ↑
        %button.button.secondary{type: "button", data: {action: "report-editor#down"}, aria: {label: "Move photo #{index + 1} later"}} ↓
        %button.button.secondary{type: "button", data: {action: "report-editor#remove"}, aria: {label: "Remove photo #{index + 1} from draft"}} Remove
