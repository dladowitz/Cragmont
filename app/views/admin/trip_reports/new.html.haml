= render "admin/shared/header", title: "New Trip Report"
%main
  - if @report.trip || (params[:standalone] == "1" && policy(@report).link_trip?) || params[:trip_report].present?
    = render "editor"
  - else
    = ui_panel do
      %h2 New Trip Report
      %p.muted Choose a trip. If a report already exists, you’ll continue editing it.
      = form_with url: new_admin_trip_report_path, method: :get, class: "admin-form" do |form|
        .field
          = required_label form, :trip_id, "Trip"
          = form.select :trip_id, options_from_collection_for_select(@trips, :id, method(:report_trip_label)), { include_blank: "Choose a trip" }, required: true
        = ui_actions(kind: :form) do
          = ui_submit form, "Continue", variant: :primary
          = ui_link "Cancel", admin_trip_reports_path, variant: :secondary
      - if policy(@report).link_trip?
        %hr.report-section-divider
        = ui_link "Add a historical report without a trip", new_admin_trip_report_path(standalone: 1), variant: :secondary
