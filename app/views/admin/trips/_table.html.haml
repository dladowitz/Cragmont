- if trips.any?
  %table.admin-trips-table.admin-record-table{role: "table", "aria-label" => "Trips"}
    %thead
      %tr
        %th{scope: "col"} Trip
        %th{scope: "col"} Type
        %th{scope: "col"} Coordinator
        %th{scope: "col"} Status
        %th{scope: "col"} Dates
        %th{scope: "col"} Signed Up
        %th{scope: "col"} Open Spaces
        %th{scope: "col"} Capacity
        %th{scope: "col"} Actions
    %tbody{role: "rowgroup"}
      - trips.each do |trip|
        %tr{role: "row"}
          %td.admin-record-title{role: "cell"}
            = link_to trip.name, admin_trip_path(trip)
            %span= trip.location
          %td{role: "cell", "data-label" => "Type"}
            %span.status.trip-type-badge{class: ("gym-outing-badge" if trip.gym_outing?)}= trip.trip_type_label
          %td{role: "cell", "data-label" => "Coordinator"}
            - if trip.class_trip? && trip.partner_company.present?
              = link_to trip.partner_company.name, admin_partner_company_path(trip.partner_company)
            - elsif trip.class_trip?
              %span.muted Not set yet
            - elsif trip.campsite_coordinator.present?
              = trip.campsite_coordinator.full_name
            - else
              .coordinator-contact
                %span.muted Not set yet
                - if policy(trip).assign_coordinator?
                  = link_to "Update", edit_admin_trip_path(trip)
          %td{role: "cell", "data-label" => "Status"}
            - status_label = trip.deleted? ? "Deleted" : trip.status.titleize
            - status_class = trip.deleted? ? "deleted-status" : "#{trip.status}-status"
            %span{ class: [ "status", status_class ] }= status_label
          %td{role: "cell", "data-label" => "Dates"}
            %dl.date-pair
              %div
                %dt Arrival
                %dd= trip.start_date.strftime("%b %d, %Y")
              - unless trip.single_day_event?
                %div
                  %dt Checkout
                  %dd= trip.end_date.strftime("%b %d, %Y")
          %td{role: "cell", "data-label" => "Signed up"}= trip.confirmed_signup_count
          - open_spaces_class = trip.capacity_full? ? "danger-stat" : (trip.almost_full? ? "warning-stat" : "success-stat")
          %td.admin-open-spaces-cell{class: open_spaces_class, role: "cell", "data-label" => "Open spaces"}= trip.available_participant_capacity
          %td{role: "cell", "data-label" => "Capacity"}= trip.total_participant_capacity
          %td.table-actions{role: "cell", "data-label" => "Actions"}
            - if trip.camping? && policy(trip).manage_payments?
              = link_to "Transactions", admin_trip_transactions_path(trip), class: "button secondary admin-table-action-button"
            - if trip.deleted? && policy(trip).restore?
              = button_to "Restore", restore_admin_trip_path(trip), method: :patch, class: "button admin-table-action-button"
- else
  .empty-state
    %p No trips found.
