- if trips.any?
  %table
    %thead
      %tr
        %th Trip
        %th Coordinator
        %th Status
        %th Dates
        %th Campsites
        %th Participant Capacity
        %th Signed Up
    %tbody
      - trips.each do |trip|
        %tr
          %td
            = link_to trip.name, admin_trip_path(trip)
            %span= trip.location
          %td
            - if trip.campsite_coordinator.present?
              = trip.campsite_coordinator.full_name
            - else
              %span Unassigned
          %td
            %span{ class: [ "status", "#{trip.status}-status" ] }= trip.status.titleize
          %td
            %dl.date-pair
              %div
                %dt Arrival
                %dd= trip.start_date.strftime("%b %d, %Y")
              %div
                %dt Checkout
                %dd= trip.end_date.strftime("%b %d, %Y")
          %td= trip.campsite_count
          %td= trip.total_participant_capacity
          %td= trip.confirmed_signup_count
- else
  .empty-state
    %p No trips have been added yet.
    = link_to "New trip", new_admin_trip_path, class: "button"
