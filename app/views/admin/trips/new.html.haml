- new_trip_title = @trip_type_choice_required ? "New trip" : "New #{@trip.trip_type_label.downcase}"
= render "admin/shared/header", title: new_trip_title
= ui_panel do
  .panel-header
    %div
      %h2= new_trip_title
  - if @trip_type_choice_required
    .empty-state
      %p Choose the kind of trip you want to build.
      %div{"data-controller" => "modal", "data-modal-open-value" => "true"}
        = ui_button("Choose trip type", variant: :primary, "data-action" => "modal#open", type: "button")
        %dialog.signup-modal.admin-trip-type-modal{"data-action" => "click->modal#closeOnBackdrop", "data-modal-target" => "dialog"}
          .signup-modal-content
            %div
              %h2 What kind of trip is this?
              %p Pick the right topo and we'll open the matching setup page.
            .trip-type-choice-actions
              = ui_link "Camping trip", new_admin_trip_path(trip_type: "camping"), variant: :primary
              = ui_link "Day trip", new_admin_trip_path(trip_type: "day_trip"), variant: :secondary
              = ui_link "Gym outing", new_admin_trip_path(trip_type: "gym_outing"), variant: :secondary
              = ui_link "Class", new_admin_trip_path(trip_type: "class_trip"), variant: :secondary
            = ui_actions(kind: :form) do
              = ui_link "Cancel", admin_trips_path, variant: :secondary
  - else
    = render "form", trip: @trip
