- modal_id = "admin-add-participant-#{campsite.id}"
- existing_option_id = "admin-add-participant-existing-#{campsite.id}"
- new_option_id = "admin-add-participant-new-#{campsite.id}"
- user_select_id = "admin-add-participant-user-#{campsite.id}"
- first_name_id = "admin-add-participant-first-name-#{campsite.id}"
- last_name_id = "admin-add-participant-last-name-#{campsite.id}"
- email_id = "admin-add-participant-email-#{campsite.id}"
- phone_id = "admin-add-participant-phone-#{campsite.id}"
- waive_payment_no_id = "admin-add-participant-waive-payment-no-#{campsite.id}"
- waive_payment_yes_id = "admin-add-participant-waive-payment-yes-#{campsite.id}"
- waive_reason_id = "admin-add-participant-waive-reason-#{campsite.id}"
- other_waive_reason_id = "admin-add-participant-other-waive-reason-#{campsite.id}"
- signed_up_user_ids = Array(local_assigns[:trip_participant_user_ids])
- user_picker_options = users.map do |user|
  - signed_up = signed_up_user_ids.include?(user.id)
  - option_label = user.email.present? ? "#{user.full_name} (#{user.email})" : user.full_name
  - option_label = "#{option_label} - already on trip" if signed_up
  - { label: option_label, value: user.id, disabled: signed_up }
%div{"data-controller" => "modal"}
  %button.button.secondary{"aria-controls" => modal_id, "data-action" => "modal#open", type: "button"} Add Participant
  %dialog.signup-modal.admin-add-participant-modal{id: modal_id, "data-action" => "click->modal#closeOnBackdrop", "data-modal-target" => "dialog"}
    .signup-modal-content
      %div
        %h2 Add participant
        %p
          = campsite.campground.name
          site #{campsite.site_number}
      = form_with url: admin_trip_campsite_signups_path(trip), method: :post, class: "admin-form admin-add-participant-form", data: { controller: "admin-participant" } do
        = hidden_field_tag "campsite_signup[campsite_id]", campsite.id
        %fieldset.signup-kind-options.admin-add-participant-options
          %legend Participant account
          %label{for: existing_option_id}
            = radio_button_tag "campsite_signup[participant_account_status]", "existing", true, id: existing_option_id, data: { admin_participant_target: "option", action: "admin-participant#toggle" }
            %span Participant has an account
          %label{for: new_option_id}
            = radio_button_tag "campsite_signup[participant_account_status]", "new", false, id: new_option_id, data: { admin_participant_target: "option", action: "admin-participant#toggle" }
            %span Participant does not have an account
        %section.admin-add-participant-fields{"data-admin-participant-target" => "existingFields"}
          .field
            = label_tag user_select_id do
              Participant
              %span.required-marker{"aria-hidden" => "true"} *
              %span.visually-hidden required
            .participant-picker{"data-controller" => "participant-picker", "data-participant-picker-placeholder-value" => "Choose a participant", "data-action" => "keydown->participant-picker#keydown"}
              = hidden_field_tag "campsite_signup[user_id]", "", id: user_select_id, data: { admin_participant_target: "existingInput", participant_picker_target: "input", required: "true" }
              %button.participant-picker-button{type: "button", role: "combobox", aria: { expanded: "false", controls: "#{user_select_id}-list", haspopup: "listbox" }, data: { participant_picker_target: "button", action: "participant-picker#toggle" }}
                %span{"data-participant-picker-target" => "label"} Choose a participant
                %span.participant-picker-chevron{"aria-hidden" => "true"}
              .participant-picker-panel{hidden: true, data: { participant_picker_target: "panel" }}
                = search_field_tag nil, "", class: "participant-picker-search", placeholder: "Search by name or email", autocomplete: "off", data: { participant_picker_target: "search", action: "input->participant-picker#filter" }
                %ul.participant-picker-list{id: "#{user_select_id}-list", role: "listbox"}
                  - user_picker_options.each do |option|
                    %li
                      %button.participant-picker-option{type: "button", role: "option", disabled: option[:disabled], aria: { selected: "false" }, data: { participant_picker_target: "option", action: "participant-picker#choose", value: option[:value], label: option[:label], search_text: option[:label].downcase }}
                        %span= option[:label]
                  %li.participant-picker-empty{hidden: true, data: { participant_picker_target: "empty" }} No participants found.
        %section.admin-add-participant-fields{"data-admin-participant-target" => "newFields", hidden: true}
          %h3 Create an account and add to campsite
          .form-grid
            .field
              = label_tag first_name_id do
                First name
                %span.required-marker{"aria-hidden" => "true"} *
                %span.visually-hidden required
              = text_field_tag "campsite_signup[new_user][first_name]", "", id: first_name_id, required: true, disabled: true, data: { admin_participant_target: "newInput", required: "true" }
            .field
              = label_tag last_name_id do
                Last name
                %span.required-marker{"aria-hidden" => "true"} *
                %span.visually-hidden required
              = text_field_tag "campsite_signup[new_user][last_name]", "", id: last_name_id, required: true, disabled: true, data: { admin_participant_target: "newInput", required: "true" }
            .field
              = label_tag email_id do
                Email
                %span.required-marker{"aria-hidden" => "true"} *
                %span.visually-hidden required
              = email_field_tag "campsite_signup[new_user][email]", "", id: email_id, required: true, disabled: true, data: { admin_participant_target: "newInput", required: "true" }
            .field
              = label_tag phone_id, "Phone"
              = telephone_field_tag "campsite_signup[new_user][phone]", "", id: phone_id, disabled: true, data: { admin_participant_target: "newInput" }
        %fieldset.signup-kind-options.admin-add-participant-options
          %legend Waive Payment
          %label{for: waive_payment_no_id}
            = radio_button_tag "campsite_signup[waive_payment]", "0", true, id: waive_payment_no_id, data: { admin_participant_target: "waiveOption", action: "admin-participant#toggleWaivePaymentFields" }
            %span No
          %label{for: waive_payment_yes_id}
            = radio_button_tag "campsite_signup[waive_payment]", "1", false, id: waive_payment_yes_id, data: { admin_participant_target: "waiveOption", action: "admin-participant#toggleWaivePaymentFields" }
            %span Yes
        %section.admin-add-participant-fields{"data-admin-participant-target" => "waiveReasonFields", hidden: true}
          .field
            = required_label_tag waive_reason_id, "Reason"
            = select_tag "campsite_signup[waived_reason_type]", options_for_select([["Campsite Coordinator", "campsite_coordinator"], ["Other", "other"]]), include_blank: "Choose a reason", id: waive_reason_id, disabled: true, data: { admin_participant_target: "waiveReasonSelect", action: "admin-participant#toggleWaivePaymentFields" }
          .field{"data-admin-participant-target" => "otherWaiveReasonField", hidden: true}
            = required_label_tag other_waive_reason_id, "Other reason"
            = text_area_tag "campsite_signup[waived_reason]", "", id: other_waive_reason_id, rows: 2, disabled: true, data: { admin_participant_target: "otherWaiveReasonInput" }
        .form-actions
          %button.button.secondary{"data-action" => "modal#close", type: "button"} Cancel
          = submit_tag "Add Participant", class: "button"
