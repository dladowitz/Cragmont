- waitlist = local_assigns.fetch(:waitlist, false)
- trip = local_assigns[:trip]
- campsites = Array(local_assigns[:campsites])
- allowed_signup_tooltip = "Participants can sign themselves up from the waitlist"
- add_campsite_tooltip = "Adds a participant directly to a campsite"
- remove_waitlist_tooltip = "Removes Participant from Waitlist"
%table
  %thead
    %tr
      %th Participant
      - if waitlist
        %th Member
      %th Minors
      - unless waitlist
        %th Dates
      - if waitlist
        %th
          %span.tooltip-heading.info-tooltip{aria: { label: allowed_signup_tooltip }, tabindex: "0"}
            %span Self Signup
            %span.info-tooltip-icon{aria: { hidden: "true" }} i
            %span.info-tooltip-box{role: "tooltip"}= allowed_signup_tooltip
        %th
          %span.tooltip-heading.info-tooltip{aria: { label: add_campsite_tooltip }, tabindex: "0"}
            %span Campsite
            %span.info-tooltip-icon{aria: { hidden: "true" }} i
            %span.info-tooltip-box{role: "tooltip"}= add_campsite_tooltip
        %th
          %span.tooltip-heading.info-tooltip{aria: { label: remove_waitlist_tooltip }, tabindex: "0"}
            %span Remove
            %span.info-tooltip-icon{aria: { hidden: "true" }} i
            %span.info-tooltip-box{role: "tooltip"}= remove_waitlist_tooltip
      - else
        %th Payment
        %th Waiver
        %th Info
        %th Move to Waitlist
        %th Remove
  %tbody
    - signups.each do |signup|
      - signup_trip = trip || signup.trip
      - missing_dates = !waitlist && (signup.arrival_date.blank? || signup.checkout_date.blank?)
      - missing_waiver = !waitlist && !signup.waiver_signed?
      - details_link_purpose = signup.guest? ? :complete_guest_details : :complete_participant_details
      - missing_details_copy = signup.guest? ? "We need to collect a waiver from this guest." : "We need to collect waiver and attendance dates from this participant."
      - missing_details_share_copy = signup.guest? ? "Share this link with the guest so they can sign the waiver:" : "Share this link with the participant so they can sign the waiver and select dates:"
      - missing_details_link_text = signup.guest? ? "Waiver Link" : "Waiver and Date Selection Link"
      - participant_details_link = trip_url(signup_trip, complete_signup: signup.signed_id(purpose: details_link_purpose), anchor: "campsite-#{signup.campsite_id}") unless waitlist
      %tr{data: (waitlist ? {} : { controller: "copyable-modal" })}
        %td
          = signup.user.full_name
          - if waitlist && signup.includes_guests?
            - guest_names = signup.guest_signups.map { |guest_signup| guest_signup.user.full_name }.to_sentence
            %span.muted.admin-linked-party-summary
              = "#{signup.guest_signups.size} #{'guest'.pluralize(signup.guest_signups.size)}: #{guest_names}"
          - if signup.guest?
            %span.muted
              Added by #{signup.guest_of_signup.user.full_name}
        - if waitlist
          %td
            - member_status_text = signup.user.member? ? "Yes" : "No"
            - member_status_class = signup.user.member? ? "status member-status" : "muted"
            %span.admin-member-status{class: member_status_class}= member_status_text
        %td
          - if signup.campsite_signup_minors.any?
            %ul.admin-minor-list
              - signup.campsite_signup_minors.each_with_index do |minor, index|
                %li
                  - minor_info_modal_id = "minor-info-#{signup.id}-#{minor.id || index}"
                  %div.minor-info-control{"data-controller" => "modal"}
                    %button.info-link-button{"aria-controls" => minor_info_modal_id, "data-action" => "modal#open", type: "button"}= minor.full_name
                    %dialog.signup-modal.minor-info-modal{id: minor_info_modal_id, "data-action" => "click->modal#closeOnBackdrop", "data-modal-target" => "dialog"}
                      .signup-modal-content
                        %div
                          %h2 Minor information
                        %dl.details-list
                          %div
                            %dt Name
                            %dd= minor.full_name
                          %div
                            %dt Age
                            %dd= minor.age
                          %div
                            %dt Added by
                            %dd= signup.user.full_name
                          %div
                            %dt Relationship
                            %dd= minor.relationship
                        .form-actions
                          %button.button.secondary{"data-action" => "modal#close", type: "button"} Close
          - else
            %span.muted None
        - unless waitlist
          %td
            - if !missing_dates
              = signup.compact_attendance_date_range
            - else
              %button.missing-value.missing-link{"data-action" => "copyable-modal#open", type: "button"} Missing
        - if waitlist
          %td.admin-self-signup-cell
            .admin-self-signup-control
              - if signup.waitlist_eligible?
                %span.status.admin-self-signup-status Enabled
                = button_to "Disable", revoke_waitlist_eligibility_admin_trip_campsite_signup_path(trip, signup), method: :patch, class: "button secondary admin-table-action-button"
              - else
                %span.status.danger-status.admin-self-signup-status Disabled
                = button_to "Enable", make_waitlist_eligible_admin_trip_campsite_signup_path(trip, signup), method: :patch, class: "button secondary admin-table-action-button"
          %td
            - preview_campsite = campsites.first
            %div.admin-waitlist-campsite-control{"data-controller" => "modal"}
              - if preview_campsite.present?
                %span.admin-waitlist-campsite-name
                  = preview_campsite.campground.name
                  = preview_campsite.site_number
              - else
                %span.muted.admin-waitlist-campsite-name No campsite
              %button.button.secondary.admin-table-action-button{"data-action" => "modal#open", :type => "button"} Add
              %dialog.signup-modal{"data-action" => "click->modal#closeOnBackdrop", "data-modal-target" => "dialog"}
                .signup-modal-content
                  %div
                    %h2 Add #{signup.user.full_name} to a campsite
                    %p.muted Admins can add waitlisted participants even when a campsite is at capacity.
                  .admin-campsite-choice-list
                    - campsites.each do |campsite|
                      .admin-campsite-choice-row
                        .admin-campsite-choice-copy
                          %strong
                            = campsite.campground.name
                            site #{campsite.site_number}
                          %span.muted
                            = campsite.arrival_date.strftime("%b %-d")
                            to #{campsite.checkout_date.strftime("%b %-d")}
                        .admin-campsite-choice-stats
                          %span
                            %strong= campsite.confirmed_signup_count
                            signed up
                          %span
                            %strong= campsite.participant_capacity
                            capacity
                        = button_to "Add", move_to_campsite_admin_trip_campsite_signup_path(trip, signup), method: :patch, params: { campsite_signup: { campsite_id: campsite.id } }, class: "button secondary"
                  .form-actions
                    %button.button.secondary{"data-action" => "modal#close", :type => "button"} Cancel
          %td
            %div{"data-controller" => "modal"}
              %button.button.danger.secondary.admin-table-action-button{"data-action" => "modal#open", :type => "button"} Remove
              %dialog.confirmation-modal{"data-action" => "click->modal#closeOnBackdrop", "data-modal-target" => "dialog"}
                .confirmation-modal-content
                  %div
                    %h2 Remove #{signup.user.full_name} from the waitlist?
                    %p This will remove their signup from the trip.
                  .form-actions
                    %button.button.secondary{"data-action" => "modal#close", :type => "button"} Cancel
                    = button_to "Remove", remove_from_waitlist_admin_trip_campsite_signup_path(trip, signup), method: :delete, class: "button danger"
        - else
          %td
            = render "payment_controls", signup: signup, trip: signup_trip, missing_dates: missing_dates, missing_waiver: missing_waiver, participant_details_link: participant_details_link
          %td
            - if signup.waiver_signed?
              .waiver-download
                - signed_on = signup.waiver_signed_at.strftime("%m/%d/%y")
                = link_to rails_blob_path(signup.waiver_document, disposition: "attachment"), class: "waiver-download-link", aria: { label: "Download waiver signed on #{signed_on}" } do
                  %span= signed_on
                  %svg.waiver-download-icon{ aria: { hidden: "true" }, fill: "none", height: "14", viewbox: "0 0 24 24", width: "14", xmlns: "http://www.w3.org/2000/svg" }
                    %path{ d: "M12 3v12m0 0 4-4m-4 4-4-4M5 21h14", stroke: "currentColor", "stroke-linecap" => "round", "stroke-linejoin" => "round", "stroke-width" => "2" }
            - else
              %button.missing-value.missing-link{"data-action" => "copyable-modal#open", type: "button"} Missing
            - if missing_dates || missing_waiver
              %dialog.signup-modal.missing-details-modal{"data-action" => "click->copyable-modal#closeOnBackdrop", "data-copyable-modal-target" => "dialog"}
                .signup-modal-content
                  %div
                    %h2 Missing participant details
                    %p= missing_details_copy
                    %p= missing_details_share_copy
                  .missing-details-link-row
                    = link_to missing_details_link_text, participant_details_link, class: "missing-details-link", "data-copyable-modal-target" => "source"
                    %button.button.secondary.copy-link-button{"data-action" => "copyable-modal#copy", type: "button"}
                      %span.copy-link-icon.copy-icon{aria: { hidden: "true" }}
                        %svg{fill: "none", height: "14", viewbox: "0 0 24 24", width: "14", xmlns: "http://www.w3.org/2000/svg"}
                          %rect{height: "12", rx: "2", stroke: "currentColor", "stroke-width" => "2", width: "12", x: "8", y: "8"}
                          %path{d: "M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2", stroke: "currentColor", "stroke-linecap" => "round", "stroke-width" => "2"}
                      %span.copy-link-icon.check-icon{aria: { hidden: "true" }}
                        %svg{fill: "none", height: "14", viewbox: "0 0 24 24", width: "14", xmlns: "http://www.w3.org/2000/svg"}
                          %path{d: "M20 6 9 17l-5-5", stroke: "currentColor", "stroke-linecap" => "round", "stroke-linejoin" => "round", "stroke-width" => "2.5"}
                      %span Copy link
                  .form-actions
                    %button.button.secondary{"data-action" => "copyable-modal#close", type: "button"} Close
          %td
            - participant_info_modal_id = "participant-info-#{signup.id}"
            %div.participant-info-control{"data-controller" => "modal"}
              %button.info-link-button{"aria-controls" => participant_info_modal_id, "data-action" => "modal#open", type: "button"} View
              %dialog.signup-modal.participant-info-modal{id: participant_info_modal_id, "data-action" => "click->modal#closeOnBackdrop", "data-modal-target" => "dialog"}
                .signup-modal-content
                  %div
                    %h2 Participant info
                    %p.muted= signup.user.full_name
                  %dl.details-list
                    %div
                      %dt Email
                      %dd= signup.user.email.present? ? mail_to(signup.user.email) : "None"
                    %div
                      %dt Phone
                      %dd= signup.user.phone.presence || "None"
                    %div
                      %dt Membership
                      %dd= signup.user.member? ? "Member" : "Non-member"
                  .form-actions
                    %button.button.secondary{"data-action" => "modal#close", type: "button"} Close
          %td
            - if signup.guest?
              %span.muted Follows primary
            - else
              %div{"data-controller" => "modal"}
                %button.button.secondary{"data-action" => "modal#open", :type => "button"} Waitlist
                %dialog.confirmation-modal{"data-action" => "click->modal#closeOnBackdrop", "data-modal-target" => "dialog"}
                  .confirmation-modal-content
                    %div
                      %h2 Move #{signup.user.full_name} to the waitlist?
                      %p This will remove their campsite assignment and attendance dates.
                    .form-actions
                      %button.button.secondary{"data-action" => "modal#close", :type => "button"} Cancel
                      = button_to "Waitlist", move_to_waitlist_admin_trip_campsite_signup_path(signup_trip, signup), method: :patch, class: "button secondary"
          %td
            %div{"data-controller" => "modal"}
              %button.button.danger.secondary{"data-action" => "modal#open", :type => "button"} Remove
              %dialog.confirmation-modal{"data-action" => "click->modal#closeOnBackdrop", "data-modal-target" => "dialog"}
                .confirmation-modal-content
                  %div
                    %h2 Remove #{signup.user.full_name} from this campsite?
                    %p This will remove their signup from the trip.
                  .form-actions
                    %button.button.secondary{"data-action" => "modal#close", :type => "button"} Cancel
                    = button_to "Remove", remove_from_campsite_admin_trip_campsite_signup_path(signup_trip, signup), method: :delete, class: "button danger"
