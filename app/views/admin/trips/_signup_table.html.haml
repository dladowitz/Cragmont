- waitlist = local_assigns.fetch(:waitlist, false)
- trip = local_assigns[:trip]
- campsites = Array(local_assigns[:campsites])
- read_only = local_assigns.fetch(:read_only, false)
- payment_read_only = local_assigns.fetch(:payment_read_only, read_only)
- allowed_signup_tooltip = "Participants can sign themselves up from the waitlist"
- add_campsite_tooltip = "Adds a participant directly to a campsite"
- remove_waitlist_tooltip = "Removes Participant from Waitlist"
- signups_by_primary_id = signups.group_by { |signup| signup.guest_of_signup_id || signup.id }
- display_signups = waitlist ? signups : signups.reject(&:guest?).flat_map { |signup| [signup] + signups_by_primary_id.fetch(signup.id, []).select(&:guest?) }
%table
  %thead
    %tr
      %th Participant
      - if waitlist
        %th Member
        %th Minors
      - unless waitlist
        %th Dates
      - if waitlist && !read_only
        %th
          %span.tooltip-heading.info-tooltip{aria: { label: allowed_signup_tooltip }, tabindex: "0"}
            %span Self Signup
            %span.info-tooltip-icon{aria: { hidden: "true" }} i
            %span.info-tooltip-box{role: "tooltip"}= allowed_signup_tooltip
        %th
          %span.tooltip-heading.info-tooltip{aria: { label: add_campsite_tooltip }, tabindex: "0"}
            %span Campsite
            %span.info-tooltip-icon{aria: { hidden: "true" }} i
            %span.info-tooltip-box{role: "tooltip"}= add_campsite_tooltip
        %th
          %span.tooltip-heading.info-tooltip{aria: { label: remove_waitlist_tooltip }, tabindex: "0"}
            %span Remove
            %span.info-tooltip-icon{aria: { hidden: "true" }} i
            %span.info-tooltip-box{role: "tooltip"}= remove_waitlist_tooltip
      - elsif !waitlist
        %th Payment
        %th Waiver
        %th Info
        %th Minors
        - unless read_only
          %th Reservation
  %tbody
    - display_signups.each_with_index do |signup, index|
      - signup_trip = trip || signup.trip
      - missing_dates = !waitlist && (signup.arrival_date.blank? || signup.checkout_date.blank?)
      - missing_waiver = !waitlist && !signup.waiver_signed?
      - missing_payment = !waitlist && !signup.guest? && !signup.payment_paid_or_settled?
      - missing_participant_details = missing_dates || missing_waiver || missing_payment
      - details_link_purpose = signup.guest? ? :complete_guest_details : :complete_participant_details
      - if signup.guest?
        - missing_details_copy = "We need to collect a waiver from this guest."
        - missing_details_share_copy = "Share this link with the guest so they can sign the waiver:"
        - missing_details_link_text = "Waiver Link"
      - elsif missing_payment && (missing_dates || missing_waiver)
        - missing_details_copy = "We need to collect waiver, attendance dates, and payment from this participant."
        - missing_details_share_copy = "Share this link with the participant so they can sign the waiver, select dates, and pay for the trip:"
        - missing_details_link_text = "Date selection, waiver, and payment link"
      - elsif missing_payment
        - missing_details_copy = "We need to collect payment from this participant."
        - missing_details_share_copy = "Share this link with the participant so they can pay for the trip:"
        - missing_details_link_text = "Date selection, waiver, and payment link"
      - else
        - missing_details_copy = "We need to collect waiver and attendance dates from this participant."
        - missing_details_share_copy = "Share this link with the participant so they can sign the waiver and select dates:"
        - missing_details_link_text = "Waiver and Date Selection Link"
      - missing_details_email_text = signup.guest? ? "Email link to guest" : "Email link to participant"
      - participant_details_link = trip_url(signup_trip, complete_signup: signup.signed_id(purpose: details_link_purpose), anchor: "campsite-#{signup.campsite_id}") unless waitlist
      - party_primary = !waitlist && !signup.guest? && signup.includes_guests?
      - party_guest = !waitlist && signup.guest?
      - next_signup = display_signups[index + 1]
      - party_last = party_guest && (!next_signup&.guest? || next_signup.guest_of_signup_id != signup.guest_of_signup_id)
      %tr{class: [("admin-party-primary-row" if party_primary), ("admin-party-guest-row" if party_guest), ("admin-party-last-row" if party_last)].compact, data: (waitlist ? {} : { controller: "copyable-modal" })}
        %td
          - if party_guest
            %span.admin-party-guest-name= signup.user.full_name
          - else
            = signup.user.full_name
          - if waitlist && signup.includes_guests?
            - guest_names = signup.guest_signups.map { |guest_signup| guest_signup.user.full_name }.to_sentence
            %span.muted.admin-linked-party-summary
              = "#{signup.guest_signups.size} #{'guest'.pluralize(signup.guest_signups.size)}: #{guest_names}"
          - if !read_only && missing_participant_details
            %dialog.signup-modal.missing-details-modal{"data-action" => "click->copyable-modal#closeOnBackdrop", "data-copyable-modal-target" => "dialog"}
              .signup-modal-content
                %div
                  %h2 Missing participant details
                  %p= missing_details_copy
                  %p= missing_details_share_copy
                .admin-participant-link-share
                  = link_to missing_details_link_text, participant_details_link, class: "missing-details-link", "data-copyable-modal-target" => "source"
                  .admin-participant-link-actions
                    %button.button.secondary.copy-link-button.admin-participant-link-action{"data-action" => "copyable-modal#copy", type: "button"}
                      %span.copy-link-icon.copy-icon{aria: { hidden: "true" }}
                        %svg{fill: "none", height: "14", viewbox: "0 0 24 24", width: "14", xmlns: "http://www.w3.org/2000/svg"}
                          %rect{height: "12", rx: "2", stroke: "currentColor", "stroke-width" => "2", width: "12", x: "8", y: "8"}
                          %path{d: "M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2", stroke: "currentColor", "stroke-linecap" => "round", "stroke-width" => "2"}
                      %span.copy-link-icon.check-icon{aria: { hidden: "true" }}
                        %svg{fill: "none", height: "14", viewbox: "0 0 24 24", width: "14", xmlns: "http://www.w3.org/2000/svg"}
                          %path{d: "M20 6 9 17l-5-5", stroke: "currentColor", "stroke-linecap" => "round", "stroke-linejoin" => "round", "stroke-width" => "2.5"}
                      %span Copy Link
                    - if signup.user.email.present?
                      = button_to missing_details_email_text, email_participant_link_admin_trip_campsite_signup_path(signup_trip, signup), method: :post, class: "button secondary admin-participant-link-action", form: { class: "admin-participant-link-action-form", data: { controller: "email-link", action: "submit->email-link#send" } }
                .form-actions
                  %button.button.secondary{"data-action" => "copyable-modal#close", type: "button"} Close
        - if waitlist
          %td
            - member_status_text = signup.user.member? ? "Yes" : "No"
            - member_status_class = signup.user.member? ? "status member-status" : "muted"
            %span.admin-member-status{class: member_status_class}= member_status_text
          = render "signup_minors_cell", signup: signup, party_guest: party_guest
        - unless waitlist
          %td
            - if party_guest
              %span.admin-party-empty-cell{"aria-hidden" => "true"}
            - elsif !missing_dates
              = signup.compact_attendance_date_range
            - elsif read_only
              %span.missing-value Missing
            - else
              %button.missing-value.missing-link{"data-action" => "copyable-modal#open", type: "button"} Missing
        - if waitlist && !read_only
          %td.admin-self-signup-cell
            .admin-self-signup-control
              - if signup.waitlist_eligible?
                %span.status.admin-self-signup-status Enabled
                = button_to "Disable", revoke_waitlist_eligibility_admin_trip_campsite_signup_path(trip, signup), method: :patch, class: "button secondary admin-table-action-button"
              - else
                %span.status.danger-status.admin-self-signup-status Disabled
                = button_to "Enable", make_waitlist_eligible_admin_trip_campsite_signup_path(trip, signup), method: :patch, class: "button secondary admin-table-action-button"
          %td
            - preview_campsite = campsites.first
            %div.admin-waitlist-campsite-control{"data-controller" => "modal"}
              - if preview_campsite.present?
                %span.admin-waitlist-campsite-name
                  = preview_campsite.campground.name
                  = preview_campsite.site_number
              - else
                %span.muted.admin-waitlist-campsite-name No campsite
              %button.button.secondary.admin-table-action-button{"data-action" => "modal#open", :type => "button"} Add
              %dialog.signup-modal{"data-action" => "click->modal#closeOnBackdrop", "data-modal-target" => "dialog"}
                .signup-modal-content
                  %div
                    %h2 Add #{signup.user.full_name} to a campsite
                    %p.muted Admins can add waitlisted participants even when a campsite is at capacity.
                  = form_with url: move_to_campsite_admin_trip_campsite_signup_path(trip, signup), method: :patch, class: "admin-waitlist-campsite-add-form", data: { controller: "admin-participant" } do
                    .admin-campsite-choice-list
                      - campsites.each_with_index do |campsite, index|
                        - selected_campsite = index.zero?
                        - campsite_option_id = "waitlist-add-campsite-#{signup.id}-#{campsite.id}"
                        - waive_payment_no_id = "waitlist-add-waive-payment-no-#{signup.id}-#{campsite.id}"
                        - waive_payment_yes_id = "waitlist-add-waive-payment-yes-#{signup.id}-#{campsite.id}"
                        - waive_reason_id = "waitlist-add-waive-reason-#{signup.id}-#{campsite.id}"
                        - other_waive_reason_id = "waitlist-add-other-waive-reason-#{signup.id}-#{campsite.id}"
                        .admin-campsite-choice-row.admin-waitlist-campsite-choice-row{class: ("is-selected" if selected_campsite), data: { admin_participant_target: "campsiteChoiceRow", campsite_id: campsite.id }}
                          .admin-campsite-choice-selector
                            = radio_button_tag "campsite_signup[campsite_id]", campsite.id, selected_campsite, id: campsite_option_id, data: { admin_participant_target: "campsiteOption", action: "admin-participant#toggleSelectedCampsite" }
                          %label.admin-campsite-choice-copy{for: campsite_option_id}
                            %strong
                              = campsite.campground.name
                              site #{campsite.site_number}
                            %span.muted
                              = campsite.arrival_date.strftime("%b %-d")
                              to #{campsite.checkout_date.strftime("%b %-d")}
                          .admin-campsite-choice-stats
                            %span
                              %strong= campsite.confirmed_signup_count
                              signed up
                            %span
                              %strong= campsite.participant_capacity
                              capacity
                          %fieldset.signup-kind-options.admin-add-participant-options.admin-waitlist-waive-options
                            %legend Waive Payment?
                            %label{for: waive_payment_no_id}
                              = radio_button_tag "campsite_signup[waive_payment]", "0", selected_campsite, id: waive_payment_no_id, disabled: !selected_campsite, data: { action: "admin-participant#toggleSelectedCampsite" }
                              %span No
                            %label{for: waive_payment_yes_id}
                              = radio_button_tag "campsite_signup[waive_payment]", "1", false, id: waive_payment_yes_id, disabled: !selected_campsite, data: { action: "admin-participant#toggleSelectedCampsite" }
                              %span Yes
                          %section.admin-add-participant-fields.admin-waitlist-waive-fields{hidden: true}
                            .field
                              = label_tag waive_reason_id, class: "required-inline-label" do
                                Reason
                                %span.required-marker{"aria-hidden" => "true"} *
                                %span.visually-hidden required
                              = select_tag "campsite_signup[waived_reason_type]", options_for_select([["Campsite Coordinator", "campsite_coordinator"], ["Other", "other"]]), include_blank: "Choose a reason", id: waive_reason_id, disabled: true, data: { action: "admin-participant#toggleSelectedCampsite" }
                            .field.admin-waitlist-other-waive-reason-field{hidden: true}
                              = required_label_tag other_waive_reason_id, "Other reason"
                              = text_area_tag "campsite_signup[waived_reason]", "", id: other_waive_reason_id, rows: 2, disabled: true
                    .form-actions
                      %button.button.secondary{"data-action" => "modal#close", :type => "button"} Cancel
                      = submit_tag "Add", class: "button"
          %td
            %div{"data-controller" => "modal"}
              %button.button.danger.secondary.admin-table-action-button{"data-action" => "modal#open", :type => "button"} Remove
              %dialog.confirmation-modal{"data-action" => "click->modal#closeOnBackdrop", "data-modal-target" => "dialog"}
                .confirmation-modal-content
                  %div
                    %h2 Remove #{signup.user.full_name} from the waitlist?
                    %p This will remove their signup from the trip.
                  .form-actions
                    %button.button.secondary{"data-action" => "modal#close", :type => "button"} Cancel
                    = button_to "Remove", remove_from_waitlist_admin_trip_campsite_signup_path(trip, signup), method: :delete, class: "button danger"
        - elsif !waitlist
          %td
            - if party_guest
              %span.admin-party-empty-cell{"aria-hidden" => "true"}
            - else
              = render "payment_controls", signup: signup, trip: signup_trip, missing_dates: missing_dates, missing_waiver: missing_waiver, participant_details_link: participant_details_link, read_only: payment_read_only
          %td
            - if signup.waiver_signed?
              = link_to admin_user_path(signup.user), class: "waiver-check-link", aria: { label: "View #{signup.user.full_name}'s waivers" } do
                %svg.waiver-check-icon{ aria: { hidden: "true" }, fill: "none", height: "18", viewbox: "0 0 24 24", width: "18", xmlns: "http://www.w3.org/2000/svg" }
                  %path{ d: "M20 6 9 17l-5-5", stroke: "currentColor", "stroke-linecap" => "round", "stroke-linejoin" => "round", "stroke-width" => "2.5" }
            - else
              - if read_only
                %span.missing-value Missing
              - else
                %button.missing-value.missing-link{"data-action" => "copyable-modal#open", type: "button"} Missing
          %td
            - participant_info_modal_id = "participant-info-#{signup.id}"
            %div.participant-info-control{"data-controller" => "modal"}
              %button.info-link-button{"aria-controls" => participant_info_modal_id, "data-action" => "modal#open", type: "button"} View
              %dialog.signup-modal.participant-info-modal{id: participant_info_modal_id, "data-action" => "click->modal#closeOnBackdrop", "data-modal-target" => "dialog"}
                .signup-modal-content
                  %div
                    %h2 Participant info
                    %p.muted= signup.user.full_name
                  %dl.details-list
                    %div
                      %dt Email
                      %dd= signup.user.email.present? ? mail_to(signup.user.email) : "None"
                    %div
                      %dt Phone
                      %dd= signup.user.phone.presence || "None"
                    %div
                      %dt Membership
                      %dd= signup.user.member? ? "Member" : "Non-member"
                  .form-actions
                    %button.button.secondary{"data-action" => "modal#close", type: "button"} Close
          = render "signup_minors_cell", signup: signup, party_guest: party_guest
          - unless read_only
            %td
              - if signup.guest?
                %div{"data-controller" => "modal"}
                  %button.button.danger.secondary.admin-confirmed-signup-action-button{"data-action" => "modal#open", :type => "button"} Remove
                  %dialog.confirmation-modal{"data-action" => "click->modal#closeOnBackdrop", "data-modal-target" => "dialog"}
                    .confirmation-modal-content
                      %div
                        %h2 Remove #{signup.user.full_name} from this campsite?
                        %p This will remove their signup from the trip.
                        %dl.details-list
                          %div
                            %dt Trip starts
                            %dd= signup_trip.start_date.to_fs(:long)
                          %div
                            %dt Days until trip
                            %dd= signup.days_until_trip_start
                        - refund_amount_cents = signup.refundable_amount_cents
                        - if refund_amount_cents.positive?
                          .admin-refund-choice
                            %p.admin-refund-choice-spacer{"aria-hidden" => "true"}
                            %p.muted
                              %strong Policy:
                              Full refund if 7 or more days before start of trip. 
                              %br
                              Admins can override policy with a good reason.
                            %p.admin-refund-choice-spacer{"aria-hidden" => "true"}
                            %p
                              %strong
                                #{signup.primary_signup.user.full_name} paid for #{signup.user.full_name}:
                              = format_cents(refund_amount_cents)
                      .form-actions
                        %button.button.secondary{"data-action" => "modal#close", :type => "button"} Cancel
                        - if refund_amount_cents.positive?
                          - no_refund_button_class = signup.refund_eligible? ? "button danger secondary" : "button danger"
                          - refund_button_class = signup.refund_eligible? ? "button danger" : "button danger secondary"
                          = button_to "Remove without refund", remove_from_campsite_admin_trip_campsite_signup_path(signup_trip, signup), method: :delete, params: { payment: { issue_refund: "0" } }, class: no_refund_button_class
                          = button_to "Remove and issue refund", remove_from_campsite_admin_trip_campsite_signup_path(signup_trip, signup), method: :delete, params: { payment: { issue_refund: "1" } }, class: refund_button_class
                        - else
                          = button_to "Remove without refund", remove_from_campsite_admin_trip_campsite_signup_path(signup_trip, signup), method: :delete, params: { payment: { issue_refund: "0" } }, class: "button danger"
              - else
                - other_campsites = campsites.reject { |campsite| campsite.id == signup.campsite_id }
                - change_modal_id = "reservation-change-#{signup.id}"
                - move_modal_id = "reservation-move-site-#{signup.id}"
                - waitlist_modal_id = "reservation-waitlist-#{signup.id}"
                - remove_modal_id = "reservation-remove-#{signup.id}"
                %div{"data-controller" => "modal"}
                  %button.button.secondary.admin-confirmed-signup-action-button{"data-action" => "modal#open", :type => "button"} Change
                  %dialog.signup-modal{id: change_modal_id, "data-action" => "click->modal#closeOnBackdrop", "data-modal-target" => "dialog"}
                    .signup-modal-content
                      %div
                        %h2 Change #{signup.user.full_name}'s reservation
                        %p.muted Choose what needs to happen with this campsite reservation.
                      .admin-reservation-change-actions
                        - if other_campsites.any?
                          %button.button.secondary{"data-action" => "modal#open_dialog", "data-modal-dialog-id-param" => move_modal_id, type: "button"} Move to a Different Campsite
                        %button.button.secondary{"data-action" => "modal#open_dialog", "data-modal-dialog-id-param" => waitlist_modal_id, type: "button"} Move to Waitlist
                        %button.button.danger.secondary{"data-action" => "modal#open_dialog", "data-modal-dialog-id-param" => remove_modal_id, type: "button"} Remove Reservation
                      .form-actions
                        %button.button.secondary{"data-action" => "modal#close", :type => "button"} Cancel
                - if other_campsites.any?
                  %div{"data-controller" => "modal"}
                    %dialog.signup-modal{id: move_modal_id, "data-action" => "click->modal#closeOnBackdrop", "data-modal-target" => "dialog"}
                      .signup-modal-content
                        %div
                          %h2 Move #{signup.user.full_name} to another campsite
                          %p.muted This keeps their dates, waiver, and payment status unchanged.
                        = form_with url: move_to_campsite_admin_trip_campsite_signup_path(signup_trip, signup), method: :patch, class: "admin-waitlist-campsite-add-form", data: { controller: "admin-participant" } do
                          .admin-campsite-choice-list
                            - other_campsites.each_with_index do |campsite, index|
                              - selected_campsite = index.zero?
                              - campsite_option_id = "confirmed-move-campsite-#{signup.id}-#{campsite.id}"
                              .admin-campsite-choice-row.admin-move-campsite-choice-row{class: ("is-selected" if selected_campsite), data: { admin_participant_target: "campsiteChoiceRow", campsite_id: campsite.id }}
                                .admin-campsite-choice-selector
                                  = radio_button_tag "campsite_signup[campsite_id]", campsite.id, selected_campsite, id: campsite_option_id, data: { admin_participant_target: "campsiteOption", action: "admin-participant#toggleSelectedCampsite" }
                                %label.admin-campsite-choice-copy{for: campsite_option_id}
                                  %strong
                                    = campsite.campground.name
                                    site #{campsite.site_number}
                                  %span.muted
                                    = campsite.arrival_date.strftime("%b %-d")
                                    to #{campsite.checkout_date.strftime("%b %-d")}
                                .admin-campsite-choice-stats
                                  %span
                                    %strong= campsite.confirmed_signup_count
                                    signed up
                                  %span
                                    %strong= campsite.participant_capacity
                                    capacity
                                  %span
                                    %strong= campsite.available_participant_capacity
                                    open
                          .form-actions
                            %button.button.secondary{"data-action" => "modal#close", :type => "button"} Cancel
                            = submit_tag "Move Site", class: "button"
                %div{"data-controller" => "modal"}
                  %dialog.confirmation-modal{id: waitlist_modal_id, "data-action" => "click->modal#closeOnBackdrop", "data-modal-target" => "dialog"}
                    .confirmation-modal-content
                      %div
                        %h2 Move #{signup.user.full_name} to the waitlist?
                        %p This will remove their campsite assignment and attendance dates.
                        %dl.details-list
                          %div
                            %dt Trip starts
                            %dd= signup_trip.start_date.to_fs(:long)
                          %div
                            %dt Days until trip
                            %dd= signup.days_until_trip_start
                        - refund_amount_cents = signup.refundable_amount_cents
                        - if refund_amount_cents.positive?
                          .admin-refund-choice
                            %p.admin-refund-choice-spacer{"aria-hidden" => "true"}
                            %p.muted
                              %strong Policy:
                              Full refund if 7 or more days before start of trip.
                              %br
                              Admins can override policy with a good reason.
                            %p.admin-refund-choice-spacer{"aria-hidden" => "true"}
                            %p
                              %strong
                                - if signup.guest?
                                  #{signup.primary_signup.user.full_name} paid for #{signup.user.full_name}:
                                - else
                                  Amount paid:
                              = format_cents(refund_amount_cents)
                      .form-actions
                        %button.button.secondary{"data-action" => "modal#close", :type => "button"} Cancel
                        - if refund_amount_cents.positive?
                          - no_refund_button_class = signup.refund_eligible? ? "button danger secondary" : "button danger"
                          - refund_button_class = signup.refund_eligible? ? "button danger" : "button danger secondary"
                          = button_to "Move without refund", move_to_waitlist_admin_trip_campsite_signup_path(signup_trip, signup), method: :patch, params: { payment: { issue_refund: "0" } }, class: no_refund_button_class
                          = button_to "Move and issue refund", move_to_waitlist_admin_trip_campsite_signup_path(signup_trip, signup), method: :patch, params: { payment: { issue_refund: "1" } }, class: refund_button_class
                        - else
                          = button_to "Move without refund", move_to_waitlist_admin_trip_campsite_signup_path(signup_trip, signup), method: :patch, params: { payment: { issue_refund: "0" } }, class: "button secondary"
                %div{"data-controller" => "modal"}
                  %dialog.confirmation-modal{id: remove_modal_id, "data-action" => "click->modal#closeOnBackdrop", "data-modal-target" => "dialog"}
                    .confirmation-modal-content
                      %div
                        %h2 Remove #{signup.user.full_name} from this campsite?
                        %p This will remove their signup from the trip.
                        %dl.details-list
                          %div
                            %dt Trip starts
                            %dd= signup_trip.start_date.to_fs(:long)
                          %div
                            %dt Days until trip
                            %dd= signup.days_until_trip_start
                        - refund_amount_cents = signup.refundable_amount_cents
                        - if refund_amount_cents.positive?
                          .admin-refund-choice
                            %p.admin-refund-choice-spacer{"aria-hidden" => "true"}
                            %p.muted
                              %strong Policy:
                              Full refund if 7 or more days before start of trip. 
                              %br
                              Admins can override policy with a good reason.
                            %p.admin-refund-choice-spacer{"aria-hidden" => "true"}
                            %p
                              %strong
                                - if signup.guest?
                                  #{signup.primary_signup.user.full_name} paid for #{signup.user.full_name}:
                                - else
                                  Amount paid:
                              = format_cents(refund_amount_cents)
                      .form-actions
                        %button.button.secondary{"data-action" => "modal#close", :type => "button"} Cancel
                        - if refund_amount_cents.positive?
                          - no_refund_button_class = signup.refund_eligible? ? "button danger secondary" : "button danger"
                          - refund_button_class = signup.refund_eligible? ? "button danger" : "button danger secondary"
                          = button_to "Remove without refund", remove_from_campsite_admin_trip_campsite_signup_path(signup_trip, signup), method: :delete, params: { payment: { issue_refund: "0" } }, class: no_refund_button_class
                          = button_to "Remove and issue refund", remove_from_campsite_admin_trip_campsite_signup_path(signup_trip, signup), method: :delete, params: { payment: { issue_refund: "1" } }, class: refund_button_class
                        - else
                          = button_to "Remove without refund", remove_from_campsite_admin_trip_campsite_signup_path(signup_trip, signup), method: :delete, params: { payment: { issue_refund: "0" } }, class: "button danger"
