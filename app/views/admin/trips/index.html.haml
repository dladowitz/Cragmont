= render "admin/shared/header", title: "Trips"
%section.panel
  .panel-header
    %div
      %h2= @showing_deleted_trips ? "Deleted trips" : "Trips"
    - unless @showing_deleted_trips
      = link_to "New trip", new_admin_trip_path, class: "button"
  .admin-filter-tabs
    = link_to "Active", admin_trips_path, class: ["button", ("secondary" if @showing_deleted_trips)].compact
    = link_to "Deleted", admin_trips_path(filter: "deleted"), class: ["button", ("secondary" unless @showing_deleted_trips)].compact
  = render "table", trips: @trips
