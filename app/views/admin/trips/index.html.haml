= render "admin/shared/header", title: "Trips"
%section.panel
  .panel-header
    %div
      %h2 Trips
    - if policy(Trip).new?
      = link_to "New trip", new_admin_trip_path, class: "button"
  = form_with url: admin_trips_path, method: :get, class: "trip-filter-form" do
    = hidden_field_tag :filters, "1"
    %fieldset.trip-status-filters
      %legend View trips
      - Admin::TripsController::TRIP_FILTER_STATUSES.each do |status|
        %label.trip-status-filter
          = check_box_tag "status[]", status, @selected_statuses.include?(status), id: "trip_status_#{status}"
          %span= status.titleize
      = submit_tag "Apply", class: "button secondary"
  = render "table", trips: @trips
