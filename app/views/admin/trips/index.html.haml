= render "admin/shared/header", title: "Trips"
= ui_panel do
  .panel-header
    %div
      %h2 Trips
    - if policy(Trip).new?
      = ui_link "New trip", new_admin_trip_path, variant: :primary
  %details.trip-filter-disclosure
    %summary
      %strong Filters:
      %span= @selected_statuses.any? ? @selected_statuses.map(&:titleize).join(", ") : "No statuses selected"
    = form_with url: admin_trips_path, method: :get, class: "trip-filter-form" do
      = hidden_field_tag :filters, "1"
      %fieldset.trip-status-filters
        %legend View trips (select all that apply)
        - Admin::TripsController::TRIP_FILTER_STATUSES.each do |status|
          %label.trip-status-filter
            = check_box_tag "status[]", status, @selected_statuses.include?(status), id: "trip_status_#{status}"
            %span= status.titleize
      = ui_submit_tag "Apply filters", variant: :primary
  = render "table", trips: @trips
  %p.admin-api-note.muted
    = link_to "Agent API docs", "/.well-known/openapi.json"
    (This is for your robot, not you)
