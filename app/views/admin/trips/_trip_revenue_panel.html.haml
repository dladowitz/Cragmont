%section.panel.trip-revenue-panel
  .panel-header
    %div
      %h2 Trip Profitability
      %p.muted Revenue collected for this trip after participant refunds and recorded costs.
  %table.trip-revenue-table.admin-record-table{role: "table", "aria-label" => "Trip profitability"}
    %thead
      %tr
        %th Line item
        %th Amount collected
        %th Refunds
        %th Net
    %tbody
      - summary.campsite_lines.each do |line|
        %tr{role: "row"}
          %td.admin-record-title{role: "cell"}= line.label
          %td{role: "cell", "data-label" => "Amount collected"}= format_cents(line.paid_cents)
          %td{role: "cell", "data-label" => "Refunds"}= format_cents(line.refund_cents)
          %td{role: "cell", "data-label" => "Net"}= format_cents(line.net_cents)
      %tr.trip-revenue-subtotal
        %td.admin-record-title Campsite revenue
        %td
        %td
        %td{"data-label" => "Net"}= format_cents(summary.campsite_revenue_cents)
      %tr
        %td.admin-record-title Extra payments
        %td
        %td
        %td{"data-label" => "Net"}= format_cents(summary.one_time_payment_requests_cents)
      - if summary.stripe_processing_fee_cents.positive?
        %tr.trip-revenue-expense
          %td.admin-record-title
            %span.registration-fee-modal-trigger{"data-controller" => "modal"}
              %button.reimbursement-status-link.trip-revenue-line-label{"data-action" => "modal#open", type: "button"} Stripe processing fees
              %dialog.signup-modal.stripe-processing-fees-modal{"data-action" => "click->modal#closeOnBackdrop", "data-modal-target" => "dialog"}
                .signup-modal-content
                  %div
                    %h2 Stripe processing fees
                  %table.transaction-fee-table.admin-record-table{role: "table", "aria-label" => "Stripe processing fees"}
                    %thead
                      %tr
                        %th Person who paid
                        %th Amount paid
                        %th Stripe processing fee
                        %th Net
                    %tbody
                      - summary.stripe_processing_fee_lines.each do |line|
                        %tr{role: "row"}
                          %td.admin-record-title{role: "cell"}= line.participant_name
                          %td{role: "cell", "data-label" => "Amount paid"}= format_cents(line.amount_cents)
                          %td{role: "cell", "data-label" => "Stripe processing fee"}= "-#{format_cents(line.fee_cents)}"
                          %td{role: "cell", "data-label" => "Net"}= format_cents(line.net_cents)
                    %tfoot
                      %tr
                        %td{colspan: 2}
                        %td Stripe processing fees
                        %td{"data-label" => "Total"}= "-#{format_cents(summary.stripe_processing_fee_cents)}"
                  .form-actions
                    %button.button.secondary{"data-action" => "modal#close", type: "button"} Close
          %td
          %td
          %td{"data-label" => "Expense"}= "-#{format_cents(summary.stripe_processing_fee_cents)}"
      %tr.trip-revenue-total
        %td.admin-record-title Total revenue
        %td
        %td
        %td{"data-label" => "Net"}= format_cents(summary.total_revenue_cents)
      - summary.trip_expense_lines.each do |line|
        %tr.trip-revenue-expense
          %td.admin-record-title= link_to "Trip Expense", admin_trip_transactions_path(summary.trip, anchor: line.transaction_anchor), class: "trip-revenue-line-label"
          %td{"data-label" => "Participant"}= line.participant_name
          %td{"data-label" => "Reason"}= line.reason
          %td{"data-label" => "Expense"}= "-#{format_cents(line.amount_cents)}"
      - summary.campsite_registration_fee_lines.each do |line|
        %tr.trip-revenue-expense
          %td.admin-record-title
            %span.trip-revenue-line-label= line.campsite_label
            %span.registration-fee-modal-trigger{"data-controller" => "modal"}
              %button.reimbursement-status-link.trip-revenue-line-label{"data-action" => "modal#open", type: "button"} Registration Fee
              %dialog.signup-modal.campsite-registration-reimbursement-modal{"data-action" => "click->modal#closeOnBackdrop", "data-modal-target" => "dialog"}
                .signup-modal-content
                  %div
                    %h2 Campsite registration fee
                    %p= line.campsite_label
                  %dl.details-list.transaction-details-list
                    %div
                      %dt Site Name
                      %dd= line.campsite.campground.name
                    %div
                      %dt Site Number
                      %dd= line.campsite.site_number
                    %div
                      %dt Registered By
                      %dd= line.campsite.registered_by&.full_name || "None"
                    %div
                      %dt Fees Paid
                      %dd= format_cents(line.fee_cents)
                    %div
                      %dt Reimbursed
                      %dd= line.campsite.registration_reimbursed? ? "Yes" : "No"
                    %div
                      %dt Date of Reimbursement
                      %dd= line.campsite.registration_reimbursed_at&.strftime("%b %-d, %Y") || "None"
                    %div
                      %dt Reimbursed By
                      %dd= line.campsite.registration_reimbursed_by&.full_name || "None"
                    %div
                      %dt Reimbursement Method
                      %dd= line.campsite.registration_reimbursement_method_label
                    %div
                      %dt Recorded By
                      %dd= line.campsite.registration_reimbursement_recorded_by&.full_name || "None"
                    %div
                      %dt Notes
                      %dd= line.campsite.registration_reimbursement_notes.presence || "None"
                  .form-actions
                    %button.button.secondary{"data-action" => "modal#close", type: "button"} Close
          %td
          %td
          %td{"data-label" => "Expense"}= "-#{format_cents(line.fee_cents)}"
      %tr.trip-expense-total
        %td.admin-record-title Total expenses
        %td
        %td
        %td{"data-label" => "Expense"}= "-#{format_cents(summary.total_expense_cents)}"
      %tr.trip-revenue-final
        %td.admin-record-title{colspan: 3} Trip profit
        %td{"data-label" => "Net"}= format_cents(summary.final_total_cents)
