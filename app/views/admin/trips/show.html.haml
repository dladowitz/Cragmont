= render "admin/shared/header", title: @trip.name
- uncounted_minor_tooltip = "Children under 10 don't count against Total Capacity"
- whatsapp_group_url = safe_external_url(@trip.whatsapp_group)
- weather_url = safe_external_url(@trip.weather_url)
- mountain_project_url = safe_external_url(@trip.mountain_project_url)
- guide_book_url = safe_external_url(@trip.guide_book_url)
- photo_album_url = safe_external_url(@trip.photo_album_url)
- reimbursable_campsites_count = @reimbursable_campsites.size
- if !@trip.single_day_event?
  - if reimbursable_campsites_count.zero? || @reimbursed_campsites_count == reimbursable_campsites_count
    - reimbursement_status_class = "success-status"
  - elsif @reimbursed_campsites_count.zero?
    - reimbursement_status_class = "danger-status"
  - else
    - reimbursement_status_class = "warning-status"
- if @trip_readiness_checklist.present?
  - readiness_completed_count = @trip_readiness_checklist.completed_count_for(@trip_readiness_categories)
  - readiness_total_count = @trip_readiness_checklist.total_count_for(@trip_readiness_categories)
  - post_trip_category = @trip_readiness_checklist.post_trip_category
- can_access_trip_details_email = @trip_details_email&.sent? ? policy(@trip).view_trip_details_email? : (!@trip.deleted? && policy(@trip).manage_trip_details_email?)
- show_trip_details_email_button = @trip.camping? && can_access_trip_details_email
- if @participant_link_signup.present?
  = render "participant_link_modal", trip: @trip, signup: @participant_link_signup
= ui_panel(class: "trip-overview") do
  .panel-header.trip-summary-header
    .trip-summary-copy
      .trip-title-line.trip-admin-title-line
        .trip-heading-status
          %h2= @trip.name
          %span.eyebrow= @trip.status.titleize
        .trip-title-actions
          - if @trip.deleted?
            - if policy(@trip).restore?
              = ui_button_to "Restore trip", restore_admin_trip_path(@trip), method: :patch, variant: :primary
          - elsif policy(@trip).edit?
            = ui_link "Edit trip", edit_admin_trip_path(@trip), variant: :secondary
        .trip-title-meta
          %span.trip-title-location= @trip.location
          %span.trip-title-date
            = @trip.start_date.to_fs(:long)
            - unless @trip.single_day_event?
              to #{@trip.end_date.to_fs(:long)}
          %span= @trip.trip_type_label
        - unless @trip.class_trip?
          .coordinator-summary.trip-title-coordinator
            %strong Trip Coordinator:
            - if @trip.campsite_coordinator.present?
              .coordinator-contact
                %span= link_to @trip.campsite_coordinator.full_name, admin_user_path(@trip.campsite_coordinator)
            - else
              .coordinator-contact
                %span.muted Not set yet
                - if policy(@trip).assign_coordinator?
                  = link_to "Update", edit_admin_trip_path(@trip)
      - if @trip.description.present? && @trip.camping?
        .description
          %strong Notes:
          .content-page-markdown
            = render_content_page_markdown(@trip.description)
  - if @trip.deleted?
    .deleted-trip-banner
      %strong This trip has been deleted.
      %p Its campsites, participants, payments, refunds, and transaction history are preserved. Restore the trip before making changes.
  = ui_stats do
    - if @trip.confirmed_uncounted_minor_count.positive?
      .split-signup-stat
        %section
          %span Signed up
          %strong= @trip.confirmed_signup_count
        %section
          %span.under-13-label
            Under #{@trip.uncounted_minor_age_limit}
            %span.info-tooltip.under-minor-tooltip{aria: { label: uncounted_minor_tooltip }, tabindex: "0"}
              %span.info-tooltip-icon{aria: { hidden: "true" }} i
              %span.info-tooltip-box{role: "tooltip"}= uncounted_minor_tooltip
          %strong= @trip.confirmed_uncounted_minor_count
    - else
      = ui_stat(label: "Signed up", value: @trip.confirmed_signup_count)
    = ui_stat(label: "Open Spaces", value: @trip.available_participant_capacity, tone: (@trip.capacity_full? ? :danger : (@trip.almost_full? ? :warning : :success)))
    = ui_stat(label: "Total Capacity", value: @trip.total_participant_capacity)
    - unless @trip.single_day_event?
      = ui_stat(label: "Campsites", value: @trip.campsite_count)
= ui_panel(class: "trip-management-panel") do
  .panel-header.trip-management-header
    %div
      %h2 Manage
  .trip-management-content
    = ui_actions(class: "trip-management-actions") do
      - report = TripReport.for_trip(@trip)
      - if policy(report).update?
        = ui_link(report.persisted? ? "Edit trip report" : "Write trip report", report_edit_path(report), variant: :secondary)
      - if @trip_readiness_checklist.present?
        = ui_link readiness_admin_trip_path(@trip), variant: :secondary, class: "trip-readiness-summary-button" do
          %span Trip Readiness
          = ui_badge(class: ["trip-readiness-summary-button-count", (readiness_completed_count == readiness_total_count ? "success-status" : "warning-status")]) do
            = "#{readiness_completed_count} of #{readiness_total_count}"
        = ui_link post_trip_admin_trip_path(@trip), variant: :secondary, class: "trip-readiness-summary-button" do
          %span Post Trip
          = ui_badge(class: ["trip-readiness-summary-button-count", (post_trip_category.completed_count == post_trip_category.total_count ? "success-status" : "warning-status")]) do
            = "#{post_trip_category.completed_count} of #{post_trip_category.total_count}"
      = ui_link "Participant Emails", participant_emails_admin_trip_path(@trip), variant: :secondary
      - if show_trip_details_email_button
        = ui_link "Trip Details Email", admin_trip_trip_details_email_path(@trip), variant: :secondary
      - if @trip.camping? && policy(@trip).manage_payments?
        = ui_link "Transactions", admin_trip_transactions_path(@trip), variant: :secondary
    - if @trip.camping?
      .trip-reimbursement-summary.trip-management-reimbursement
        %strong Campsite Fees Reimbursed:
        = ui_badge(("#{@reimbursed_campsites_count} of #{reimbursable_campsites_count}"), class: reimbursement_status_class)
- if @trip.uses_day_trip_signups?
  = ui_panel(class: "day-trip-admin-details") do
    .panel-header
      %div
        %h2= @trip.gym_outing? ? "Gym Plan" : "Crag Plan"
    %dl.details-list
      %div
        %dt Meeting time
        %dd= @trip.meeting_time&.strftime("%-l:%M%P") || "Not set"
      %div
        %dt End time
        %dd= formatted_trip_end_time(@trip) || "None"
      %div
        %dt Meeting location
        %dd
          - meeting_location_url = safe_external_url(@trip.meeting_location_url)
          - if @trip.meeting_location.present? && meeting_location_url.present?
            = link_to @trip.meeting_location, meeting_location_url, target: "_blank", rel: "noopener"
          - else
            = @trip.meeting_location.presence || (@trip.gym_outing? ? @trip.location : "Not set")
      - unless @trip.gym_outing?
        %div
          %dt Types of Climbing
          %dd= @trip.climbing_type_labels.presence&.to_sentence || "Not set"
      %div
        %dt Cost
        %dd= format_trip_cost(@trip.cost_cents)
    - if @trip.day_trip_image.attached?
      .day-trip-location-image{"data-controller" => "modal", "data-modal-disable-autofocus-value" => "true"}
        %button.day-trip-location-image-button{"aria-label" => "Expand #{@trip.name} location image", "data-action" => "modal#open", type: "button"}
          = image_tag @trip.day_trip_image, alt: "#{@trip.name} location image"
        %dialog.signup-modal.location-image-modal{"aria-label" => "#{@trip.name} location image", "data-action" => "click->modal#closeOnBackdrop", "data-modal-target" => "dialog"}
          .location-image-modal-content
            %button.modal-close-button{"aria-label" => "Close image", "data-action" => "modal#close", type: "button"} ×
            = image_tag @trip.day_trip_image, alt: "#{@trip.name} location image"
  - if @trip.description.present?
    = ui_panel(class: "admin-day-trip-description-panel") do
      .panel-header
        %div
          %h2 Description
      .description
        .content-page-markdown
          = render_content_page_markdown(@trip.description)
- if @trip.class_trip?
  = ui_panel(class: "day-trip-admin-details class-trip-admin-details") do
    .panel-header
      %div
        %h2 Cost Details
    %dl.details-list
      %div
        %dt Signup link
        %dd
          - class_signup_url = safe_external_url(@trip.class_signup_url)
          - if class_signup_url.present?
            = link_to @trip.class_signup_url, class_signup_url, target: "_blank", rel: "noopener"
          - else
            = @trip.class_signup_url.presence || "Not set"
      %div
        %dt Original price
        %dd= format_class_price(@trip.class_original_price) || "Not set"
      - if @trip.class_offers_discount?
        %div
          %dt Discount code
          %dd= @trip.class_discount_code.presence || "None"
        %div
          %dt Discount amount
          %dd= @trip.class_discount_amount.presence || "None"
        %div
          %dt Discounted price
          %dd= format_class_price(@trip.class_discounted_price) || "None"
  - if @trip.description.present?
    = ui_panel(class: "admin-day-trip-description-panel") do
      .panel-header
        %div
          %h2 Description
      .description
        .content-page-markdown
          = render_content_page_markdown(@trip.description)
- if @trip.whatsapp_group.present? || @trip.weather_url.present? || @trip.mountain_project_url.present? || @trip.guide_book_url.present? || @trip.photo_album_url.present? || @trip.sun_exposure.present?
  = ui_panel(class: "admin-trip-resources-panel") do
    .panel-header
      %div
        %h2 Additional Resources
    %dl.details-list
      - if @trip.sun_exposure.present?
        %div
          %dt Sun Exposure
          %dd= @trip.sun_exposure
      - [["WhatsApp Group", @trip.whatsapp_group, whatsapp_group_url], ["Weather", @trip.weather_url, weather_url], ["Mountain Project", @trip.mountain_project_url, mountain_project_url], ["Guide Book", @trip.guide_book_url, guide_book_url], ["Google Photo Album", @trip.photo_album_url, photo_album_url]].each do |label, value, url|
        - if value.present?
          %div{class: ("admin-resource-link" if url.present?)}
            %dt= label
            %dd
              - if url.present?
                = link_to url, target: "_blank", rel: "noopener" do
                  %span.resource-name= label
                  %span.resource-url= value
              - else
                = value
- if @trip.uses_day_trip_signups?
  = ui_panel(class: "day-trip-participants-panel") do
    .panel-header
      %div
        %h2 Participants
    - if @day_trip_signups.any?
      %table.admin-record-table{role: "table", "aria-label" => "Participants"}
        %thead
          %tr
            %th Participant
            - unless @trip.gym_outing?
              %th Climbing Skills
              %th Bringing Gear
            %th Party
            %th Waiver
            - if !@trip.deleted? && policy(@trip).manage_participants?
              %th Actions
        %tbody
          - @day_trip_signups.each do |signup|
            %tr{role: "row"}
              %td.admin-record-title{role: "cell"}= signup.user.full_name
              - unless @trip.gym_outing?
                %td{role: "cell", "data-label" => "Climbing Skills"}= signup.skill_level_label
                %td{role: "cell", "data-label" => "Bringing Gear"}= signup.shared_gear_summary
              %td{role: "cell", "data-label" => "Party"}
                - party = []
                - party << signup.guest_signups.map { |guest_signup| guest_signup.user.full_name }.to_sentence if signup.includes_guests?
                - party << signup.day_trip_signup_minors.map(&:full_name).to_sentence if signup.includes_minors?
                = party.reject(&:blank?).presence&.join(" + ") || "Solo"
              %td{role: "cell", "data-label" => "Waiver"}= signup.waiver_signed? ? "Signed" : "Missing"
              - if !@trip.deleted? && policy(@trip).manage_participants?
                = ui_actions(tag: :td, kind: :table, class: "day-trip-admin-participant-actions", role: "cell") do
                  %div{"data-controller" => "modal"}
                    = ui_button("Move to Waitlist", variant: :secondary, class: "admin-table-action-button", "data-action" => "modal#open", type: "button")
                    %dialog.confirmation-modal{"data-action" => "click->modal#closeOnBackdrop", "data-modal-target" => "dialog"}
                      .confirmation-modal-content
                        %div
                          %h2 Move #{signup.user.full_name} to the waitlist?
                          %p This will free up their confirmed spot and keep them on the trip waitlist.
                        = ui_actions(kind: :form) do
                          = ui_button("Cancel", variant: :secondary, "data-action" => "modal#close", type: "button")
                          = ui_button_to "Move to Waitlist", move_to_waitlist_admin_trip_day_trip_signup_path(@trip, signup), method: :patch, variant: :secondary
                  %div{"data-controller" => "modal"}
                    = ui_button("Remove", variant: :danger_secondary, class: "admin-table-action-button", "data-action" => "modal#open", type: "button")
                    %dialog.confirmation-modal{"data-action" => "click->modal#closeOnBackdrop", "data-modal-target" => "dialog"}
                      .confirmation-modal-content
                        %div
                          %h2 Remove #{signup.user.full_name} from this #{@trip.trip_type_label.downcase}?
                          %p This removes the participant from the trip roster.
                        = ui_actions(kind: :form) do
                          = ui_button("Cancel", variant: :secondary, "data-action" => "modal#close", type: "button")
                          = ui_button_to "Remove", remove_admin_trip_day_trip_signup_path(@trip, signup), method: :delete, variant: :danger
    - else
      %p.muted No participants have signed up yet.
  - if @day_trip_waitlisted_signups.any?
    = ui_panel(class: "day-trip-participants-panel day-trip-waitlist-panel") do
      .panel-header
        %div
          %h2 Trip waitlist
      %table.admin-record-table{role: "table", "aria-label" => "Trip waitlist"}
        %thead
          %tr
            %th Participant
            - unless @trip.gym_outing?
              %th Climbing Skills
              %th Bringing Gear
            %th Party
            - if !@trip.deleted? && policy(@trip).manage_participants?
              %th Actions
        %tbody
          - @day_trip_waitlisted_signups.each do |signup|
            %tr{role: "row"}
              %td.admin-record-title{role: "cell"}= signup.user.full_name
              - unless @trip.gym_outing?
                %td{role: "cell", "data-label" => "Climbing Skills"}= signup.skill_level_label
                %td{role: "cell", "data-label" => "Bringing Gear"}= signup.shared_gear_summary
              %td{role: "cell", "data-label" => "Party"}
                - party = []
                - party << signup.guest_signups.map { |guest_signup| guest_signup.user.full_name }.to_sentence if signup.includes_guests?
                - party << signup.day_trip_signup_minors.map(&:full_name).to_sentence if signup.includes_minors?
                = party.reject(&:blank?).presence&.join(" + ") || "Solo"
              - if !@trip.deleted? && policy(@trip).manage_participants?
                = ui_actions(tag: :td, kind: :table, class: "day-trip-admin-participant-actions", role: "cell") do
                  %div{"data-controller" => "modal"}
                    = ui_button("Move onto Trip", variant: :secondary, class: "admin-table-action-button", "data-action" => "modal#open", type: "button")
                    %dialog.confirmation-modal{"data-action" => "click->modal#closeOnBackdrop", "data-modal-target" => "dialog"}
                      .confirmation-modal-content
                        %div
                          %h2 Move #{signup.user.full_name} onto the trip?
                          %p This will confirm their spot, even if the trip is currently full.
                        = ui_actions(kind: :form) do
                          = ui_button("Cancel", variant: :secondary, "data-action" => "modal#close", type: "button")
                          = ui_button_to "Move onto Trip", move_onto_trip_admin_trip_day_trip_signup_path(@trip, signup), method: :patch, variant: :secondary
                  %div{"data-controller" => "modal"}
                    = ui_button("Remove", variant: :danger_secondary, class: "admin-table-action-button", "data-action" => "modal#open", type: "button")
                    %dialog.confirmation-modal{"data-action" => "click->modal#closeOnBackdrop", "data-modal-target" => "dialog"}
                      .confirmation-modal-content
                        %div
                          %h2 Remove #{signup.user.full_name} from the waitlist?
                          %p This removes the participant from the trip waitlist.
                        = ui_actions(kind: :form) do
                          = ui_button("Cancel", variant: :secondary, "data-action" => "modal#close", type: "button")
                          = ui_button_to "Remove", remove_admin_trip_day_trip_signup_path(@trip, signup), method: :delete, variant: :danger
- elsif @trip.class_trip?
  = ui_panel(class: "day-trip-participants-panel class-trip-participants-panel") do
    .panel-header
      %div
        %h2 Participants
    - if @class_signups.any?
      %table.admin-record-table{role: "table", "aria-label" => "Class participants"}
        %thead
          %tr
            %th Participant
            %th Email
            - if !@trip.deleted? && policy(@trip).manage_participants?
              %th Actions
        %tbody
          - @class_signups.each do |signup|
            %tr{role: "row"}
              %td.admin-record-title{role: "cell"}= signup.user.full_name
              %td{role: "cell", "data-label" => "Email"}= signup.user.email.presence || "None"
              - if !@trip.deleted? && policy(@trip).manage_participants?
                = ui_actions(tag: :td, kind: :table, class: "day-trip-admin-participant-actions", role: "cell") do
                  %div{"data-controller" => "modal"}
                    = ui_button("Remove", variant: :danger_secondary, class: "admin-table-action-button", "data-action" => "modal#open", type: "button")
                    %dialog.confirmation-modal{"data-action" => "click->modal#closeOnBackdrop", "data-modal-target" => "dialog"}
                      .confirmation-modal-content
                        %div
                          %h2 Remove #{signup.user.full_name} from this class?
                          %p This removes the participant from the class intent roster.
                        = ui_actions(kind: :form) do
                          = ui_button("Cancel", variant: :secondary, "data-action" => "modal#close", type: "button")
                          = ui_button_to "Remove", remove_admin_trip_class_signup_path(@trip, signup), method: :delete, variant: :danger
    - else
      %p.muted No participants have signed up yet.
- else
  = ui_panel(class: "campsites-panel") do
    .panel-header.campsites-panel-header
      %div
        %h2 Campsites
      - if !@trip.deleted? && policy(@trip).manage_campsites?
        = ui_link "Add campsite", new_admin_trip_campsite_path(@trip), variant: :secondary
    - if @campsites.any?
      .admin-campsite-list
        - @campsites.each do |campsite|
          %section.admin-campsite-card{id: "admin-campsite-#{campsite.id}", data: { parking_campsite_id: campsite.id }}
            .admin-campsite-card-header
              .campsite-card-summary
                .campsite-heading-line
                  %h3
                    = campsite.campground.name
                    site #{campsite.site_number}
                  %p= campsite.campground.location
              %dl.date-pair
                %div
                  %dt Arrival
                  %dd= campsite.arrival_date.to_fs(:long)
                %div
                  %dt Checkout
                  %dd= campsite.checkout_date.to_fs(:long)
              .campsite-registration
                %p
                  %strong Site registered by:
                  - if campsite.registered_by.present?
                    = campsite.registered_by.full_name
                  - elsif @trip.deleted?
                    None
                  - elsif policy(@trip).manage_campsites?
                    = link_to "Update", edit_admin_trip_campsite_path(@trip, campsite), class: "small-link"
                  - else
                    None
                %p
                  %strong Registration #
                  - if campsite.registration_number.present?
                    = campsite.registration_number
                  - elsif @trip.deleted?
                    None
                  - elsif policy(@trip).manage_campsites?
                    = link_to "Update", edit_admin_trip_campsite_path(@trip, campsite), class: "small-link"
                  - else
                    None
              .campsite-card-actions
                .campsite-signup-mode
                  %p
                    %strong Signup mode:
                    - if campsite.signups_locked?
                      = ui_badge("Waitlist mode", tone: :warning)
                    - elsif campsite.capacity_full? && campsite.direct_signups_enabled_until_full?
                      = ui_badge("Direct signup when space opens", tone: :success)
                    - else
                      = ui_badge("Direct signup until full", tone: :success)
                  - if !@trip.deleted? && policy(@trip).manage_campsites?
                    %div{"data-controller" => "modal"}
                      - if campsite.signups_locked?
                        = ui_button("Disable Waitlist Mode", variant: :secondary, class: "campsite-signup-mode-button", "data-action" => "modal#open", type: "button")
                        %dialog.confirmation-modal{"data-action" => "click->modal#closeOnBackdrop", "data-modal-target" => "dialog"}
                          .confirmation-modal-content
                            %div
                              %h2 Disable Waitlist Mode for #{campsite.campground.name} site #{campsite.site_number}?
                              %p New participants or participants already on the trip waitlist will be able to claim open spaces directly.
                              %p The campsite will automatically return to waitlist mode when it fills again.
                            = ui_actions(kind: :form) do
                              = ui_button("Cancel", variant: :secondary, "data-action" => "modal#close", type: "button")
                              = ui_button_to "Disable Waitlist Mode", enable_direct_signups_admin_trip_campsite_path(@trip, campsite), method: :patch, variant: :primary
                      - else
                        = ui_button("Use Waitlist Mode", variant: :secondary, class: "campsite-signup-mode-button", "data-action" => "modal#open", type: "button")
                        %dialog.confirmation-modal{"data-action" => "click->modal#closeOnBackdrop", "data-modal-target" => "dialog"}
                          .confirmation-modal-content
                            %div
                              %h2 Use waitlist mode for #{campsite.campground.name} site #{campsite.site_number}?
                              %p Participants will need to join the trip waitlist instead of claiming open spaces directly.
                              %p Existing waitlist participants and their eligibility will not change.
                            = ui_actions(kind: :form) do
                              = ui_button("Cancel", variant: :secondary, "data-action" => "modal#close", type: "button")
                              = ui_button_to "Use Waitlist Mode", enable_waitlist_mode_admin_trip_campsite_path(@trip, campsite), method: :patch, variant: :primary
                = ui_actions(kind: :table, class: "campsite-action-buttons") do
                  - if !@trip.deleted? && policy(@trip).manage_participants?
                    = render "add_participant_modal", trip: @trip, campsite: campsite, users: @users, trip_participant_user_ids: @trip_participant_user_ids
                  - if !@trip.deleted? && policy(@trip).manage_campsites?
                    = ui_link "Edit Campsite", edit_admin_trip_campsite_path(@trip, campsite), variant: :secondary
              - if policy(@trip).manage_payments?
                .campsite-fee-summary
                  = render "registration_reimbursement_status", trip: @trip, campsite: campsite, users: @users
            = ui_stats(class: "campsite-stats") do
              - if campsite.confirmed_uncounted_minor_count.positive?
                .split-signup-stat
                  %section
                    %span Signed up
                    %strong= campsite.confirmed_signup_count
                  %section
                    %span.under-13-label
                      Under #{@trip.uncounted_minor_age_limit}
                      %span.info-tooltip.under-minor-tooltip{aria: { label: uncounted_minor_tooltip }, tabindex: "0"}
                        %span.info-tooltip-icon{aria: { hidden: "true" }} i
                        %span.info-tooltip-box{role: "tooltip"}= uncounted_minor_tooltip
                    %strong= campsite.confirmed_uncounted_minor_count
              - else
                = ui_stat(label: "Signed up", value: campsite.confirmed_signup_count)
              = ui_stat(label: "Open Spaces", value: campsite.available_participant_capacity, tone: (campsite.capacity_full? ? :danger : :success))
              = ui_stat(label: "Total Capacity", value: campsite.participant_capacity)
              .parking-stat
                %span Parking
                .parking-breakdown
                  .parking-breakdown-item
                    %strong{"data-parking-assigned-count" => true}= campsite.assigned_parking_spot_count
                    %span Assigned
                  .parking-breakdown-item
                    %strong{"data-parking-fcfs-count" => true}= campsite.first_come_first_serve_parking_spot_count
                    %span Open
            - if campsite.notes.present?
              %p.campsite-notes
                %strong Notes:
                = campsite.notes
            .campsite-participant-groups
              .confirmed-signups-section
                %h4 Confirmed participants
                - if campsite.confirmed_signups.any?
                  = render "signup_table", signups: campsite.confirmed_signups, trip: @trip, campsites: @campsites, read_only: @trip.deleted? || !policy(@trip).manage_participants?, payment_read_only: @trip.deleted? || !policy(@trip).manage_payments?
                - else
                  %p.muted No confirmed participants yet.
              = render "parking_spots", trip: @trip, campsite: campsite, assignment_signups: @parking_assignment_signups, read_only: @trip.deleted? || !policy(@trip).manage_participants?
    - else
      .empty-state
        %p No campsites have been added to this trip yet.
    - if @waitlisted_signups.any?
      .waitlisted-signups-section.trip-waitlist-section
        %h3 Trip waitlist
        = render "signup_table", signups: @waitlisted_signups, waitlist: true, trip: @trip, campsites: @campsites, read_only: @trip.deleted? || !policy(@trip).manage_participants?
- if @trip.camping? && policy(@trip).manage_payments?
  = render "payment_requests_panel", trip: @trip, payment_requests: @trip_payment_requests, modal_payment_request: @trip_payment_request
  = ui_panel(class: "trip-expenses-panel") do
    .panel-header
      %div
        %h2 Trip Expenses
        %p.muted Refunds marked as trip expenses, such as firewood or other shared campsite costs.
    - if @trip_expense_refunds.any?
      %table.admin-record-table{role: "table", "aria-label" => "Trip expenses"}
        %thead
          %tr
            %th Participant
            %th Amount
            %th Refunded By
            %th Reason
            %th Date of Refund
            %th Details
        %tbody
          - @trip_expense_refunds.each do |refund|
            - payment = refund.campsite_signup_payment
            - signup = payment.campsite_signup
            %tr{role: "row"}
              %td.admin-record-title{role: "cell"}= signup.user.full_name
              %td{role: "cell", "data-label" => "Amount"}= format_cents(refund.amount_cents)
              %td{role: "cell", "data-label" => "Refunded By"}= refund.refunded_by&.full_name || "None"
              %td{role: "cell", "data-label" => "Reason"}= refund.reason.presence || "None"
              %td{role: "cell", "data-label" => "Date of Refund"}= refund.refunded_at&.strftime("%-m/%-d/%y") || "None"
              = ui_actions(tag: :td, kind: :table, role: "cell") do
                %div{"data-controller" => "payment-details-trigger", "data-payment-details-trigger-payment-id-value" => payment.id}
                  = ui_button("View", variant: :secondary, class: "admin-table-action-button", "data-action" => "payment-details-trigger#open", type: "button")
    - else
      %p.muted No trip expenses recorded yet.
  = render "trip_revenue_panel", summary: @trip_revenue_summary
