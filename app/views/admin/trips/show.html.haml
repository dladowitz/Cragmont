= render "admin/shared/header", title: @trip.name
%section.panel.trip-overview
  .panel-header.trip-summary-header
    .trip-summary-copy
      %h2= @trip.name
      .trip-location-line
        %p= @trip.location
        %span.eyebrow= @trip.status.titleize
      %p
        = @trip.start_date.to_fs(:long)
        to #{@trip.end_date.to_fs(:long)}
      .coordinator-summary
        %strong Campsite coordinator:
        - if @trip.campsite_coordinator.present?
          .coordinator-contact
            %span= @trip.campsite_coordinator.full_name
            - if @trip.campsite_coordinator.email.present?
              %span= mail_to @trip.campsite_coordinator.email
            - if @trip.campsite_coordinator.phone.present?
              %span= @trip.campsite_coordinator.phone
        - else
          %span.muted Unassigned
      - if @trip.description.present?
        .description
          %strong Notes:
          = simple_format(@trip.description)
    .actions
      = link_to "Edit trip", edit_admin_trip_path(@trip), class: "button secondary"
      = button_to "Delete trip", admin_trip_path(@trip), method: :delete, class: "button danger"
  .stats
    - if @trip.confirmed_uncounted_minor_count.positive?
      .split-signup-stat
        %section
          %strong= @trip.confirmed_signup_count
          %span Signed up
        %section
          %strong= @trip.confirmed_uncounted_minor_count
          %span.under-13-label
            Under #{@trip.uncounted_minor_age_limit}
    - else
      %div
        %strong= @trip.confirmed_signup_count
        %span Signed up
    %div{:class => "availability-stat #{@trip.capacity_full? ? "danger-stat" : (@trip.almost_full? ? "warning-stat" : "success-stat")}"}
      %strong= @trip.available_participant_capacity
      %span Spaces available
    %div
      %strong= @trip.total_participant_capacity
      %span Total capacity
    %div
      %strong= @trip.campsite_count
      %span Campsites
%section.panel.campsites-panel
  .panel-header.campsites-panel-header
    %div
      %h2 Campsites
    = link_to "Add campsite", new_admin_trip_campsite_path(@trip), class: "button"
  - if @campsites_by_campground.any?
    - @campsites_by_campground.each do |campground, campsites|
      .campground-group
        %h3= campground.name
        %p= campground.location
        .admin-campsite-list
          - campsites.each do |campsite|
            %section.admin-campsite-card
              .admin-campsite-card-header
                %div
                  %h4 Site #{campsite.site_number}
                  %dl.date-pair
                    %div
                      %dt Arrival
                      %dd= campsite.arrival_date.to_fs(:long)
                    %div
                      %dt Checkout
                      %dd= campsite.checkout_date.to_fs(:long)
                %div.table-actions
                  = link_to "Edit", edit_admin_trip_campsite_path(@trip, campsite)
                  %div{"data-controller" => "modal"}
                    %button.link-button{"data-action" => "modal#open", :type => "button"} Delete
                    %dialog.confirmation-modal{"data-action" => "click->modal#closeOnBackdrop", "data-modal-target" => "dialog"}
                      .confirmation-modal-content
                        %div
                          %h2 Delete campsite?
                          %p This will not remove signed-up participants from the trip.
                        .form-actions
                          %button.button.secondary{"data-action" => "modal#close", :type => "button"} Cancel
                          = button_to "Delete campsite", admin_trip_campsite_path(@trip, campsite), method: :delete, class: "button danger"
              .stats.campsite-stats
                %div
                  %strong= campsite.confirmed_signup_count
                  %span Signed up
                %div{:class => "availability-stat #{campsite.capacity_full? ? "danger-stat" : "success-stat"}"}
                  %strong= campsite.available_participant_capacity
                  %span Spaces available
                %div
                  %strong= campsite.participant_capacity
                  %span Capacity
                %div
                  %strong= campsite.car_capacity
                  %span Cars
              - if campsite.notes.present?
                %p.campsite-notes
                  %strong Notes:
                  = campsite.notes
              .campsite-participant-groups
                .confirmed-signups-section
                  %h4 Confirmed participants
                  - if campsite.confirmed_signups.any?
                    = render "signup_table", signups: campsite.confirmed_signups
                  - else
                    %p.muted No confirmed participants yet.
    - if @waitlisted_signups.any?
      .waitlisted-signups-section.trip-waitlist-section
        %h3 Trip waitlist
        = render "signup_table", signups: @waitlisted_signups, waitlist: true, trip: @trip
  - else
    .empty-state
      %p No campsites have been added to this trip yet.
