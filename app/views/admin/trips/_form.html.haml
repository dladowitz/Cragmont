= form_with model: [:admin, trip], class: "admin-form" do |form|
  - coordinator_field_id = "trip_campsite_coordinator_id"
  - coordinator_options = [{ label: "Unassigned", value: "", search_text: "unassigned" }] + @users.map { |user| { label: user.full_name, value: user.id, search_text: [user.full_name, user.email].compact.join(" ").downcase } }
  - selected_coordinator_value = trip.campsite_coordinator_id.to_s
  - selected_coordinator_label = trip.campsite_coordinator&.full_name || "Unassigned"
  = render "admin/shared/errors", record: trip
  .form-grid
    .field
      = required_label form, :name
      = form.text_field :name, required: true
    .field
      = required_label form, :location
      = form.text_field :location, required: true
    .field
      = required_label form, :start_date
      = form.date_field :start_date, required: true, data: { controller: "date-picker", action: "click->date-picker#show focus->date-picker#show" }
    .field
      = required_label form, :end_date
      = form.date_field :end_date, required: true, data: { controller: "date-picker", action: "click->date-picker#show focus->date-picker#show" }
    .field
      = required_label form, :status
      = form.select :status, Trip.statuses.keys.map { |status| [status.titleize, status] }, {}, required: true
    - if policy(trip).assign_coordinator?
      .field
        = form.label :campsite_coordinator_id, "Campsite coordinator"
        .participant-picker.coordinator-picker{"data-controller" => "participant-picker", "data-participant-picker-placeholder-value" => "Unassigned", "data-action" => "keydown->participant-picker#keydown"}
          = hidden_field_tag "trip[campsite_coordinator_id]", selected_coordinator_value, id: coordinator_field_id, data: { participant_picker_target: "input" }
          %button.participant-picker-button{type: "button", role: "combobox", aria: { expanded: "false", controls: "#{coordinator_field_id}-list", haspopup: "listbox" }, data: { participant_picker_target: "button", action: "participant-picker#toggle" }}
            %span{"data-participant-picker-target" => "label"}= selected_coordinator_label
            %span.participant-picker-chevron{"aria-hidden" => "true"}
          .participant-picker-panel{hidden: true, data: { participant_picker_target: "panel" }}
            = search_field_tag nil, "", class: "participant-picker-search", placeholder: "Search coordinators", autocomplete: "off", data: { participant_picker_target: "search", action: "input->participant-picker#filter" }
            %ul.participant-picker-list{id: "#{coordinator_field_id}-list", role: "listbox"}
              - coordinator_options.each do |option|
                - selected_option = option[:value].to_s == selected_coordinator_value
                %li
                  %button.participant-picker-option{type: "button", role: "option", aria: { selected: selected_option.to_s }, data: { participant_picker_target: "option", action: "participant-picker#choose", value: option[:value], label: option[:label], search_text: option[:search_text] }}
                    %span= option[:label]
              %li.participant-picker-empty{hidden: true, data: { participant_picker_target: "empty" }} No coordinators found.
  .field
    = form.label :description
    = form.text_area :description, rows: 5
  .form-actions
    = form.submit
    = link_to "Cancel", trip.persisted? ? admin_trip_path(trip) : admin_trips_path, class: "button secondary"
    - if trip.persisted? && policy(trip).destroy?
      .danger-form-action
        - if trip.delete_blocked_by_participants?
          %div{"data-controller" => "modal"}
            %span.disabled-modal-trigger{"aria-disabled" => "true", "data-action" => "click->modal#open keydown.enter->modal#open keydown.space->modal#open", role: "button", tabindex: "0", title: "Cannot delete a trip with participants signed up"}
              %button.button.danger.secondary{disabled: true, type: "button"} Delete trip
            %dialog.confirmation-modal{"data-action" => "click->modal#closeOnBackdrop", "data-modal-target" => "dialog"}
              .confirmation-modal-content
                %div
                  %h2 Cannot delete a trip with participants signed up
                .form-actions
                  %button.button.secondary{"data-action" => "modal#close", type: "button"} Close
        - else
          %div{"data-controller" => "modal"}
            %button.button.danger.secondary{"data-action" => "modal#open", type: "button"} Delete trip
            %dialog.confirmation-modal{"data-action" => "click->modal#closeOnBackdrop", "data-modal-target" => "dialog"}
              .confirmation-modal-content
                %div
                  %h2 Delete trip?
                  %p This will hide the trip from normal lists. Campsites, participants, payments, refunds, and transaction history will be preserved.
                .form-actions
                  %button.button.secondary{"data-action" => "modal#close", type: "button"} Cancel
                  %button.button.danger{form: "delete-trip-#{trip.id}", type: "submit"} Delete trip

- if trip.persisted? && !trip.delete_blocked_by_participants? && policy(trip).destroy?
  = form_with url: admin_trip_path(trip), method: :delete, html: { id: "delete-trip-#{trip.id}", class: "hidden-delete-form" } do
    = hidden_field_tag :confirm_delete, "1"
