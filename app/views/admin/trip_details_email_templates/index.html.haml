= render "admin/shared/header", title: "Trip Details Email Templates"

= ui_panel(class: "trip-details-email-panel") do
  .panel-header
    %div
      %h2 Trip Details Email Templates
      %p.muted Templates are used as starting points for new trip details email drafts.
    = ui_actions do
      = ui_link "Back to Content", admin_content_path, variant: :secondary

  - if @templates.any?
    %table.admin-record-table.admin-email-templates-table{role: "table", "aria-label" => "Trip details email templates"}
      %thead
        %tr
          %th Template
          %th Area
          %th Status
          %th Action
      %tbody
        - @templates.each do |template|
          %tr
            %td.admin-record-title{role: "cell"}= template.name
            %td{role: "cell", "data-label" => "Area"}= template.area_key
            %td{role: "cell", "data-label" => "Status"}
              - status_class = template.active? ? "success-status" : "warning-status"
              = ui_badge((template.active? ? "Active" : "Inactive"), class: status_class)
            = ui_actions(tag: :td, kind: :table, role: "cell") do
              = ui_link "Edit", edit_admin_trip_details_email_template_path(template), variant: :secondary, class: "admin-table-action-button"
  - else
    %p.muted No trip details email templates yet.
