= render "admin/shared/header", title: "#{@trip.name} transactions"

= ui_panel do
  .panel-header
    %div
      %h2 Transactions
    = ui_actions do
      = ui_link "Back to trip", admin_trip_path(@trip), variant: :secondary
      - if @trip.deleted? && policy(@trip).restore?
        = ui_button_to "Restore trip", restore_admin_trip_path(@trip), method: :patch, variant: :primary

  - if @trip.deleted?
    .deleted-trip-banner
      %strong This trip has been deleted.
      %p Transaction history is preserved and still available here.

  = render "admin/trip_transactions/table", ledger_entries: @ledger_entries, empty_message: "No completed payments yet.", show_refund_action: true
