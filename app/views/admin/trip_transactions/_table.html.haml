- show_source = local_assigns.fetch(:show_source, true)
- show_remaining_refundable = local_assigns.fetch(:show_remaining_refundable, true)
- show_waived_reason = local_assigns.fetch(:show_waived_reason, true)
- show_trip = local_assigns.fetch(:show_trip, false)
- show_refund_action = local_assigns.fetch(:show_refund_action, false)
- public_table = local_assigns.fetch(:public_table, false)

- if ledger_entries.any?
  %table.transactions-table{class: ("public-card-table" if public_table), "data-controller" => "transaction-anchor"}
    %thead
      %tr
        - if show_trip
          %th Trip
        %th Participant
        %th Amount Paid
        %th Status
        %th Paid At
        %th Details
    %tbody
      - ledger_entries.each do |entry|
        - payment = entry.payment
        - status_label = entry.status_label
        - status_class = entry.status_class
        - trip = payment.campsite_signup.trip
        %tr{id: "transaction-payment-#{payment.id}"}
          - if show_trip
            %td{"data-label" => "Trip"}= link_to trip.name, trip_path(trip)
          %td{"data-label" => "Participant"}= entry.participant_name
          %td{"data-label" => "Amount Paid"}= format_cents(entry.amount_cents)
          %td{"data-label" => "Status"}
            %span.status.transaction-status{class: status_class}= status_label
          %td{"data-label" => "Paid At"}= entry.occurred_at&.strftime("%-m/%-d/%y %l:%M %p") || "None"
          %td{"data-label" => "Details"}
            = render "admin/trip_transactions/entry_details",
              entry: entry,
              show_trip: show_trip,
              show_source: show_source,
              show_remaining_refundable: show_remaining_refundable,
              show_waived_reason: show_waived_reason,
              show_refund_action: show_refund_action
- else
  %p.muted= empty_message
