<%= render "admin/shared/header", title: "Settings" %>

<section class="panel">
  <%= form_with model: @site_setting, url: admin_settings_path, method: :patch, class: "admin-form" do |form| %>
    <%= render "admin/shared/errors", record: @site_setting %>

    <div class="form-grid">
      <div>
        <%= form.label :uncounted_minor_age_limit, "Age limit of uncounted minors" %>
        <%= form.number_field :uncounted_minor_age_limit, min: 0, max: 17 %>
      </div>
      <div>
        <%= form.label :campsite_weekend_fee, "Campsite weekend fee" %>
        <div class="currency-field">
          <span aria-hidden="true">$</span>
          <%= form.number_field :campsite_weekend_fee, min: 0, step: 0.01 %>
        </div>
      </div>
      <div>
        <%= form.label :campsite_extra_night_fee, "Campsite extra night fee" %>
        <div class="currency-field">
          <span aria-hidden="true">$</span>
          <%= form.number_field :campsite_extra_night_fee, min: 0, step: 0.01 %>
        </div>
      </div>
      <div>
        <%= form.label :minor_fee, "Minor fee" %>
        <div class="currency-field">
          <span aria-hidden="true">$</span>
          <%= form.number_field :minor_fee, min: 0, step: 0.01 %>
        </div>
      </div>
    </div>

    <p class="muted">Fees are entered in dollars and stored in cents.</p>

    <div class="form-actions">
      <%= form.submit "Save settings", class: "button" %>
    </div>
  <% end %>
</section>
