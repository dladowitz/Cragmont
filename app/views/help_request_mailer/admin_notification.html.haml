%h1 New Cragmont help request
%p
  %strong Subject:
  = @help_request.subject
%p
  %strong Reason:
  = @help_request.reason_label
%p
  %strong From:
  = "#{@help_request.name} <#{@help_request.email}>"
%p= simple_format(@help_request.message)
%p= link_to "Review and reply", admin_help_request_url(@help_request)
