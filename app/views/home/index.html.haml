= content_for :body_class, "home-page"
= render "shared/public_header"
%main.public-main.home-main
  %section.home-hero
    = image_tag "home-hero.png", alt: "", class: "home-hero-image"
    .home-hero-caption Matthes Crest, Yosemite National Park
    .home-hero-copy
      %p.home-hero-eyebrow Find your next pitch
      %h1
        %span Climbing.
        %span Camping.
        %span Community.
      %p.home-hero-intro Bay Area climbers heading outside, together.
      %ul.home-destinations{aria: {label: "Places we climb"}}
        - [ "Yosemite", "Tahoe", "Bay Area", "Mt St Helena", "Touchstone", "Joshua Tree", "Movement", "Indian Creek", "City of Rocks", "More" ].each do |destination|
          %li= destination
      = link_to "View trips", trips_path, class: "button"
  = render "shared/liability_warning"
