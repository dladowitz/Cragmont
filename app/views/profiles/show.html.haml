= render "shared/public_header"
%main.public-main
  %section.panel
    .panel-header.user-detail-header
      %div
        %h1= @user.full_name
        %dl.details-list
          %div
            %dt Email
            %dd= @user.email.presence || "None"
          %div
            %dt Phone
            %dd= @user.phone.presence || "None"
          %div
            %dt Club member
            %dd= @user.member? ? "Yes" : "No"
      .actions
        = link_to "Edit profile", edit_profile_path, class: "button secondary"
        %div{"data-controller" => "modal"}
          %button.button.danger.secondary{"data-action" => "modal#open", type: "button"} Delete account
          %dialog.confirmation-modal{"data-action" => "click->modal#closeOnBackdrop", "data-modal-target" => "dialog"}
            .confirmation-modal-content
              %div
                %h2 Are you sure you want to delete your account?
                %p This will delete all history and current trips.
              = form_with url: profile_path, method: :delete, data: { controller: "confirmation-text", confirmation_text_phrase_value: "Delete Me" } do
                .field
                  = required_label_tag :confirmation_text, "Type Delete Me to Confirm"
                  = text_field_tag :confirmation_text, "", required: true, data: { confirmation_text_target: "input", action: "input->confirmation-text#update" }, autocomplete: "off"
                .form-actions
                  %button.button.secondary{"data-action" => "modal#close", type: "button"} Cancel
                  = submit_tag "Delete account", class: "button danger", disabled: true, data: { confirmation_text_target: "submit" }
  %section.panel
    %h2 Coordinated trips
    - if @coordinated_trips.any?
      %table
        %thead
          %tr
            %th Trip
            %th Status
            %th Dates
            %th Campsites
            %th Participant Capacity
            %th Signed Up
        %tbody
          - @coordinated_trips.each do |trip|
            %tr
              %td
                = link_to trip.name, trip_path(trip)
                %span= trip.location
              %td
                %span{ class: [ "status", "#{trip.status}-status" ] }= trip.status.titleize
              %td
                %dl.date-pair
                  %div
                    %dt Arrival
                    %dd= trip.start_date.strftime("%b %d, %Y")
                  %div
                    %dt Checkout
                    %dd= trip.end_date.strftime("%b %d, %Y")
              %td= trip.campsite_count
              %td= trip.total_participant_capacity
              %td= trip.confirmed_signup_count
    - else
      %p.muted This user is not assigned as a campsite coordinator yet.
