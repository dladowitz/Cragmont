- content_for :body_class, "profile-show-page"
= render "shared/public_header"
%main.public-main
  %section.panel
    .panel-header.user-detail-header
      %div
        %h1= @user.full_name
        %dl.details-list
          %div
            %dt Email
            %dd= @user.email.presence || "None"
          %div
            %dt Phone
            %dd= @user.phone.presence || "None"
          %div
            %dt Club member
            %dd= @user.member? ? "Yes" : "No"
      .actions
        = link_to "Edit profile", edit_profile_path, class: "button secondary"
  %section.panel
    %h2 Transactions
    = render "admin/trip_transactions/table",
      ledger_entries: @ledger_entries,
      empty_message: "No completed payments yet.",
      show_trip: true,
      show_source: false,
      show_remaining_refundable: false,
      show_waived_reason: false
  %section.panel
    .panel-header
      %div
        %h2 Inbox
        %p.muted View your help requests and replies from the Cragmont admins.
      = link_to "All Help Requests", help_requests_path, class: "button secondary"
    - if @recent_help_requests.any?
      %table.profile-inbox-table
        %thead
          %tr
            %th Sent
            %th Subject
            %th Reason
            %th Status
            %th
        %tbody
          - @recent_help_requests.each do |help_request|
            %tr
              %td= help_request.created_at.to_fs(:long)
              %td= help_request.subject
              %td= help_request.reason_label
              %td
                %span.status-pill{class: "#{help_request.status}-status"}= help_request.status.titleize
              %td= link_to "View", help_request_path(help_request), class: "button secondary admin-table-action-button"
    - else
      %p.muted No help requests yet.
  - if @coordinated_trips.any?
    %section.panel
      %h2 Coordinated trips
      %table
        %thead
          %tr
            %th Trip
            %th Status
            %th Dates
            %th Campsites
            %th Participant Capacity
            %th Signed Up
            %th Manage
        %tbody
          - @coordinated_trips.each do |trip|
            %tr
              %td
                = link_to trip.name, trip_path(trip)
                %span= trip.location
              %td
                %span{ class: [ "status", "#{trip.status}-status" ] }= trip.status.titleize
              %td
                %dl.date-pair
                  %div
                    %dt Arrival
                    %dd= trip.start_date.strftime("%b %d, %Y")
                  %div
                    %dt Checkout
                    %dd= trip.end_date.strftime("%b %d, %Y")
              %td= trip.campsite_count
              %td= trip.total_participant_capacity
              %td= trip.confirmed_signup_count
              %td= link_to "Manage trip", admin_trip_path(trip), class: "button secondary admin-table-action-button"
%p.background-image-caption Castle Valley, UT. Castleton Tower.
