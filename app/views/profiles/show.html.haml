- content_for :body_class, "profile-show-page"
= render "shared/public_header"
%main.public-main
  = ui_panel do
    .panel-header.user-detail-header
      %div
        %h1= @user.full_name
        %dl.details-list
          %div
            %dt Email
            %dd= @user.email.presence || "None"
          %div
            %dt Phone
            %dd= @user.phone.presence || "None"
          %div
            %dt Club member
            %dd= @user.member? ? "Yes" : "No"
          %div
            %dt Current Waiver
            %dd
              - if @current_waiver.present?
                = render "shared/waiver_modal", waiver: @current_waiver, button_label: @current_waiver.waiver_signed_at.strftime("%m/%d/%y"), modal_id: "profile-current-waiver"
              - else
                = link_to "Missing", new_profile_waiver_path, class: "missing-value missing-link"
      = ui_actions do
        = ui_link "Edit profile", edit_profile_path, variant: :secondary
  = ui_panel do
    %h2 Trips and Transactions
    = render "shared/user_trip_history",
      rows: @trip_history_rows,
      empty_message: "No trip signups yet.",
      public_table: true
  = ui_panel do
    .panel-header
      %div
        %h2 Inbox
        %p.muted View your help requests and replies from the Cragmont admins.
      = ui_link "All Help Requests", help_requests_path, variant: :secondary
    - if @recent_help_requests.any?
      %table.profile-inbox-table.public-card-table
        %thead
          %tr
            %th Sent
            %th Subject
            %th Reason
            %th Status
            %th
        %tbody
          - @recent_help_requests.each do |help_request|
            %tr
              %td{"data-label" => "Sent"}= help_request.created_at.to_fs(:long)
              %td{"data-label" => "Subject"}= help_request.subject
              %td{"data-label" => "Reason"}= help_request.reason_label
              %td{"data-label" => "Status"}
                = help_request_status_pill(help_request)
              %td{"data-label" => "View"}= ui_link "View", help_request_path(help_request), variant: :secondary, class: "admin-table-action-button"
    - else
      %p.muted No help requests yet.
  - if @coordinated_trips.any?
    = ui_panel do
      %h2 Coordinated trips
      %table.public-card-table
        %thead
          %tr
            %th Trip
            %th Status
            %th Dates
            %th Campsites
            %th Participant Capacity
            %th Signed Up
            %th Manage
        %tbody
          - @coordinated_trips.each do |trip|
            %tr
              %td{"data-label" => "Trip"}
                = link_to trip.name, trip_path(trip)
                %span= trip.location
              %td{"data-label" => "Status"}
                = ui_badge(trip.status.titleize, class: "#{trip.status}-status")
              %td{"data-label" => "Dates"}
                %dl.date-pair
                  %div
                    %dt Arrival
                    %dd= trip.start_date.strftime("%b %d, %Y")
                  %div
                    %dt Checkout
                    %dd= trip.end_date.strftime("%b %d, %Y")
              %td{"data-label" => "Campsites"}= trip.campsite_count
              %td{"data-label" => "Participant Capacity"}= trip.total_participant_capacity
              %td{"data-label" => "Signed Up"}= trip.confirmed_signup_count
              %td{"data-label" => "Manage"}= ui_link "Manage trip", admin_trip_path(trip), variant: :secondary, class: "admin-table-action-button"
%p.background-image-caption Castle Valley, UT. Castleton Tower.
