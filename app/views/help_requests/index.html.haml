- content_for :body_class, "help-requests-index-page"
= render "shared/public_header"

%main.public-main
  = ui_panel do
    .panel-header
      %div
        %h1 My Help Requests
        %p.muted Track your messages with the Cragmont admins.
      = ui_link "New request", new_help_request_path, variant: :primary
    - if @help_requests.any?
      .table-wrapper
        %table.public-card-table
          %thead
            %tr
              %th View
              %th Subject
              %th Status
              %th Replies
              %th Sent
          %tbody
            - @help_requests.each do |help_request|
              %tr
                %td{"data-label" => "View"}= ui_link "View", help_request_path(help_request), variant: :secondary, class: "admin-table-action-button"
                %td{"data-label" => "Subject"}= help_request.subject
                %td{"data-label" => "Status"}
                  = help_request_status_pill(help_request)
                %td{"data-label" => "Replies"}= help_request.replies.size
                %td{"data-label" => "Sent"}= help_request.created_at.to_fs(:long)
    - else
      %p.muted You have not sent any help requests yet.
