- content_for :title, "#{@payload['title']} | Trip Reports"
- content_for :body_class, "club-page trip-reports-page"
= render "shared/public_header"
%main.public-main.club-main
  %section.panel
    %h1.report-page-title= @payload["title"]
    = render "report", report: @report, payload: @payload, preview: false, hide_heading: true, expanded: true
    - if @report.trip
      = link_to "View original trip", trip_path(@report.trip)
