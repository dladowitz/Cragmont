%article.club-report{id: (preview ? nil : "report-#{report.id || "trip-#{report.trip_id}"}")}
  - album = safe_external_url(payload["album_url"])
  - legacy_image = report_legacy_image(payload)
  - report_photos = Array(payload["photos"])
  - if legacy_image || report_photos.any?
    .club-report-gallery{class: ("report-photo-gallery" if report_photos.size + (legacy_image ? 1 : 0) > 1)}
      - report_photos.each do |photo|
        %figure
          = link_to report_photo_path(report, photo, preview: preview), target: "_blank", rel: "noopener" do
            = image_tag report_photo_path(report, photo, preview: preview), alt: photo["caption"].presence || "Photo from #{payload['title']}", loading: "lazy", decoding: "async", width: 960, height: 720
          - if photo["caption"].present?
            %figcaption= photo["caption"]
      - if legacy_image
        = link_to album || "#", target: "_blank", rel: "noopener", aria: {label: "View photos from #{payload['title']} (opens in a new tab)"} do
          = image_tag legacy_image, alt: "Photo from #{payload['title']}", loading: "lazy", decoding: "async", width: 960, height: 720
  - unless local_assigns[:hide_heading]
    %h2= payload["title"]
  - unless report.legacy_key.present?
    %span.status.trip-type-badge{class: h(public_trip_type_badge_class(Trip.new(trip_type: payload["trip_type"])))}= Trip::TRIP_TYPE_LABELS[payload["trip_type"]]
    %p.report-meta
      = Date.iso8601(payload["start_date"]).to_fs(:long)
      - if payload["end_date"].present? && payload["end_date"] != payload["start_date"]
        to #{Date.iso8601(payload["end_date"]).to_fs(:long)}
      - if payload["location"].present?
        · #{payload["location"]}
  - if album
    = link_to "View photos", album, target: "_blank", rel: "noopener", class: ("report-album-card" unless legacy_image || report_photos.any?)
  - if !preview && policy(report).update?
    %p= link_to "Edit report", report_edit_path(report)
  - if payload["body"].present?
    %details.club-report-details{open: (true if local_assigns[:expanded])}
      %summary Read trip report
      .club-report-copy
        = render_content_page_markdown(payload["body"])
        - if payload["byline"].present?
          %p.club-history-byline= payload["byline"]
