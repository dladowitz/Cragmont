- content_for :body_class, "password-reset-new-page"
= render "shared/public_header"
.public-mobile-hero.public-mobile-hero-password-reset
  %h1.public-mobile-hero-title Reset password
  %span.public-mobile-hero-caption Castleton Tower, Castle Valley, UT
%main.public-main
  = ui_panel(class: "auth-panel") do
    %h1 Reset password
    = form_with url: password_resets_path, class: "admin-form" do
      .field
        = required_label_tag :email, "Email"
        = email_field_tag :email, params[:email], required: true, autocomplete: "email"
      = ui_actions(kind: :form) do
        = submit_tag "Send reset link"
        = ui_link "Back to log in", new_session_path, variant: :secondary
%p.background-image-caption Castleton Tower, Castle Valley, UT
