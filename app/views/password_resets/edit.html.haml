- content_for :body_class, "password-reset-edit-page"
= render "shared/public_header"
%main.public-main
  %section.panel.auth-panel
    %h1 Choose a new password
    = form_with url: password_reset_path(@token), method: :patch, class: "admin-form" do
      = render "admin/shared/errors", record: @user
      .form-grid
        .field
          = required_label_tag "user_password", "Password"
          .password-visibility-field{"aria-label" => "Show password", "data-controller" => "password-visibility"}
            = password_field_tag "user[password]", "", id: "user_password", required: true, autocomplete: "new-password", data: { password_visibility_target: "input" }
            %button.password-visibility-toggle{"aria-label" => "Show password", "data-action" => "password-visibility#toggle", type: "button"}
              %span.password-visibility-icon{"data-password-visibility-target" => "showIcon"}
                %svg{aria: { hidden: "true" }, fill: "none", height: "22", viewbox: "0 0 24 24", width: "22", xmlns: "http://www.w3.org/2000/svg"}
                  %path{d: "M2.25 12s3.5-6.25 9.75-6.25S21.75 12 21.75 12 18.25 18.25 12 18.25 2.25 12 2.25 12Z", stroke: "currentColor", "stroke-linecap" => "round", "stroke-linejoin" => "round", "stroke-width" => "2"}
                  %path{d: "M12 14.75A2.75 2.75 0 1 0 12 9.25a2.75 2.75 0 0 0 0 5.5Z", stroke: "currentColor", "stroke-linecap" => "round", "stroke-linejoin" => "round", "stroke-width" => "2"}
              %span.password-visibility-icon{hidden: true, "data-password-visibility-target" => "hideIcon"}
                %svg{aria: { hidden: "true" }, fill: "none", height: "22", viewbox: "0 0 24 24", width: "22", xmlns: "http://www.w3.org/2000/svg"}
                  %path{d: "M3 3l18 18", stroke: "currentColor", "stroke-linecap" => "round", "stroke-width" => "2"}
                  %path{d: "M10.58 10.58A2 2 0 0 0 13.42 13.42", stroke: "currentColor", "stroke-linecap" => "round", "stroke-width" => "2"}
                  %path{d: "M9.88 5.92c.68-.12 1.39-.17 2.12-.17 6.25 0 9.75 6.25 9.75 6.25a18.5 18.5 0 0 1-3.02 3.72M6.56 7.27C3.78 9.05 2.25 12 2.25 12s3.5 6.25 9.75 6.25c1.5 0 2.85-.36 4.03-.9", stroke: "currentColor", "stroke-linecap" => "round", "stroke-linejoin" => "round", "stroke-width" => "2"}
              %span.visually-hidden Show password
        .field
          = required_label_tag "user_password_confirmation", "Password confirmation"
          .password-visibility-field{"aria-label" => "Show password", "data-controller" => "password-visibility"}
            = password_field_tag "user[password_confirmation]", "", id: "user_password_confirmation", required: true, autocomplete: "new-password", data: { password_visibility_target: "input" }
            %button.password-visibility-toggle{"aria-label" => "Show password", "data-action" => "password-visibility#toggle", type: "button"}
              %span.password-visibility-icon{"data-password-visibility-target" => "showIcon"}
                %svg{aria: { hidden: "true" }, fill: "none", height: "22", viewbox: "0 0 24 24", width: "22", xmlns: "http://www.w3.org/2000/svg"}
                  %path{d: "M2.25 12s3.5-6.25 9.75-6.25S21.75 12 21.75 12 18.25 18.25 12 18.25 2.25 12 2.25 12Z", stroke: "currentColor", "stroke-linecap" => "round", "stroke-linejoin" => "round", "stroke-width" => "2"}
                  %path{d: "M12 14.75A2.75 2.75 0 1 0 12 9.25a2.75 2.75 0 0 0 0 5.5Z", stroke: "currentColor", "stroke-linecap" => "round", "stroke-linejoin" => "round", "stroke-width" => "2"}
              %span.password-visibility-icon{hidden: true, "data-password-visibility-target" => "hideIcon"}
                %svg{aria: { hidden: "true" }, fill: "none", height: "22", viewbox: "0 0 24 24", width: "22", xmlns: "http://www.w3.org/2000/svg"}
                  %path{d: "M3 3l18 18", stroke: "currentColor", "stroke-linecap" => "round", "stroke-width" => "2"}
                  %path{d: "M10.58 10.58A2 2 0 0 0 13.42 13.42", stroke: "currentColor", "stroke-linecap" => "round", "stroke-width" => "2"}
                  %path{d: "M9.88 5.92c.68-.12 1.39-.17 2.12-.17 6.25 0 9.75 6.25 9.75 6.25a18.5 18.5 0 0 1-3.02 3.72M6.56 7.27C3.78 9.05 2.25 12 2.25 12s3.5 6.25 9.75 6.25c1.5 0 2.85-.36 4.03-.9", stroke: "currentColor", "stroke-linecap" => "round", "stroke-linejoin" => "round", "stroke-width" => "2"}
              %span.visually-hidden Show password
      .form-actions
        = submit_tag "Reset password"
        = link_to "Back to log in", new_session_path, class: "button secondary"
%p.background-image-caption Yosemite Valley, Arrowhead Arete
